# The timestamp pinned into random_hash while generating. Any fixed
# value inside the five-byte field will do; this one is a round number
# well clear of both ends.
PINNED_TIME = 1750000000


class DetRandom:
    """A deterministic byte stream, so that regenerating a vector
    produces the same bytes. Consumers never see it, and the encode
    class does not rest on it: expect records what these bytes came out
    as, which is what raw is rebuilt from."""

    def __init__(self, tag):
        self.seed    = tag.encode("utf-8")
        self.counter = 0
        self.buf     = b""

    def bytes(self, n):
        while len(self.buf) < n:
            self.buf += hashlib.sha256(self.seed + self.counter.to_bytes(4, "big")).digest()
            self.counter += 1
        out, self.buf = self.buf[:n], self.buf[n:]
        return out


def pinned_keyclass(real, rng):
    return type("Pinned", (), {
        "generate": staticmethod(lambda: real.from_private_bytes(rng.bytes(32))),
        "from_private_bytes": staticmethod(real.from_private_bytes),
    })


@contextlib.contextmanager
def pinned(RNS, tag):
    """Replace the clock and the two randomness sources an announce
    reaches for, so that regenerating produces identical bytes.

    Both are patched on RNS rather than on os.urandom. Patching
    os.urandom is not enough: under the openssl backend
    _generate_ratchet reaches X25519PrivateKey.generate in PyCA
    (RNS/Cryptography/Proxies.py:43#generate), which draws from OpenSSL's own
    generator and never touches os.urandom.
    """
    rng = DetRandom(tag)

    real_time    = time.time
    real_urandom = os.urandom
    real_rand    = RNS.Identity.get_random_hash
    real_ratchet = RNS.Identity._generate_ratchet
    identity_mod = sys.modules["RNS.Identity"]
    link_mod     = sys.modules["RNS.Link"]
    real_x25519  = identity_mod.X25519PrivateKey
    real_lx25519 = link_mod.X25519PrivateKey
    real_led     = link_mod.Ed25519PrivateKey

    time.time  = lambda: float(PINNED_TIME)
    os.urandom = rng.bytes
    RNS.Identity.get_random_hash   = staticmethod(lambda: rng.bytes(16))
    RNS.Identity._generate_ratchet = staticmethod(lambda: rng.bytes(32))

    # Identity.encrypt resolves X25519PrivateKey as a global of the
    # RNS.Identity module, so the shim is installed on the module
    # rather than on the class of the same name.
    # os.urandom is pinned as well because Token.encrypt takes its
    # initialisation vector from it directly.
    identity_mod.X25519PrivateKey = pinned_keyclass(real_x25519, rng)

    # RNS.Link imports both key classes for itself
    # (RNS/Link.py:31#Ed25519PrivateKey) and draws a fresh pair for
    # every link end (RNS/Link.py:276#X25519PrivateKey, :284), so the
    # same shim is installed there.
    link_mod.X25519PrivateKey  = pinned_keyclass(real_lx25519, rng)
    link_mod.Ed25519PrivateKey = pinned_keyclass(real_led, rng)
    try:
        yield
    finally:
        time.time  = real_time
        os.urandom = real_urandom
        RNS.Identity.get_random_hash   = real_rand
        RNS.Identity._generate_ratchet = real_ratchet
        identity_mod.X25519PrivateKey  = real_x25519
        link_mod.X25519PrivateKey      = real_lx25519
        link_mod.Ed25519PrivateKey     = real_led


class TransportStub:
    """Destination registration and ratchet persistence reach into a
    running Reticulum instance. Neither affects the bytes on the wire,
    so both are stubbed rather than starting an instance."""
    is_connected_to_shared_instance = False


def stub_transport(RNS, tmpdir):
    RNS.Transport.owner = TransportStub()
    RNS.Transport.register_destination = staticmethod(lambda d: None)
    RNS.Identity._remember_ratchet = staticmethod(lambda h, r: None)
    # Identity.get_ratchet falls back to the storage path when a
    # destination has no remembered ratchet. Pointing it at an empty
    # directory keeps that lookup from reaching a real instance.
    RNS.Reticulum.storagepath = tmpdir
    # The constructor sets this and nothing else does, so without an
    # instance the attribute does not exist at all and every reader of
    # it raises. RNS/Reticulum.py:254#__transport_enabled.
    RNS.Reticulum._Reticulum__transport_enabled = False


def load_rns(checkout):
    if not os.path.isdir(os.path.join(checkout, "RNS")):
        sys.exit("no RNS package under %s" % checkout)

    sys.path.insert(0, checkout)
    import RNS

    if not os.path.abspath(RNS.__file__).startswith(os.path.abspath(checkout)):
        sys.exit("imported RNS from %s, not from the checkout" % RNS.__file__)

    if RNS.__version__ != PIN_VERSION:
        sys.exit("checkout is version %s, pin is %s" % (RNS.__version__, PIN_VERSION))

    commit = subprocess.run(["git", "-C", checkout, "rev-parse", "HEAD"],
                            capture_output=True, text=True).stdout.strip()
    if commit != PIN_COMMIT:
        sys.exit("checkout is at %s, pin is %s" % (commit, PIN_COMMIT))

    # The backend is part of the pin, and it is chosen at import time by
    # what happens to be installed. Regenerating under the other one
    # would produce different bytes for the ratchet vectors and a
    # different verdict for the two non-canonical vectors, and nothing
    # downstream could tell which had been used.
    from RNS.Cryptography import Provider
    if Provider.PROVIDER != PIN_BACKEND:
        sys.exit("checkout uses crypto backend %#04x, pin is %#04x (%s); "
                 "install the cryptography package"
                 % (Provider.PROVIDER, PIN_BACKEND, PIN_BACKEND_NAME))

    return RNS


def line(name, value):
    # A name wider than the column shifts the value out of alignment.
    # Two decoders that pad the same way would still compare equal, so
    # nothing downstream can catch it.
    if len(name) > FIELD_WIDTH:
        raise ValueError("field name %r is wider than the %d-column format"
                         % (name, FIELD_WIDTH))
    return "%-*s %s" % (FIELD_WIDTH, name, value)


def field(name, value):
    # An expect value is one word, so that splitting on the first space
    # is exact. meta is prose and uses line() directly.
    value = str(value)
    if " " in value:
        raise ValueError("field %s has a space in its value: %r" % (name, value))
    # A name followed by nothing is a line with a trailing space, which
    # cannot be told from a truncated line. The format spells the empty
    # byte string "-", like every other absent value.
    if value == "":
        raise ValueError("field %s has an empty value; write - instead" % name)
    return line(name, value)


def hexf(b):
    """Hex, or "-" for the empty byte string. See field()."""
    return b.hex() if b else "-"


# The kinds cmd/dump can rebuild raw for. signature is not among them:
# its raw carries a 950-byte message that expect records only by its
# digest, so the vector can be decoded and not rebuilt.
ENCODABLE = ("identity", "keyset", "destination", "announce", "plain",
             "pathrequest", "encrypted", "group", "linkrequest", "linkproof",
             "linkdata", "proof", "ifac")


def determinism(kind, expect):
    """encode when expect holds every byte of raw.

    That is so exactly when the kind has an encoder and the object
    decoded: a vector that names a broken rule carries the rule and the
    numbers behind it, and nothing to rebuild from. Deriving the class
    here rather than declaring it per vector keeps the claim from being
    wrong; cmd/check then tests it.
    """
    if kind not in ENCODABLE:
        return "decode"
    if any(l.startswith("invalid") for l in expect):
        return "decode"
    return "encode"


class Writer:
    # Counted apart, because the number this program prints on a good
    # day is the success signal of the whole repository. "229 files
    # written" was that number, and it reads like a report of 229
    # changes; the run that changes nothing is the run that passes.
    def __init__(self, root, force):
        self.root      = root
        self.force     = force
        self.identical = 0
        self.changed   = 0
        self.created   = 0
        self.differs   = []
        self.names     = []

    def vector(self, kind, name, purpose, raw, expect, source=GENERATED_SOURCE):
        meta = [
            line("source", source),
            line("determinism", determinism(kind, expect)),
            line("purpose", purpose),
        ]

        path = os.path.join(self.root, "test", kind, name)
        os.makedirs(path, exist_ok=True)

        self.file(os.path.join(path, "meta"), meta)
        self.file(os.path.join(path, "raw"), raw)
        self.file(os.path.join(path, "expect"), expect)
        self.names.append(kind + "/" + name)

    # test/INDEX is what makes a count an assertion. cmd/check refuses to
    # run against a test/ that does not hold exactly these vectors, so a
    # copy with some of them removed reports nothing rather than passing
    # the ones it kept.
    def index(self):
        self.file(os.path.join(self.root, "test", "INDEX"),
                  sorted(self.names))

    @staticmethod
    def body(lines):
        return "\n".join(lines) + "\n"

    def file(self, path, lines):
        body = self.body(lines)
        if os.path.exists(path):
            with open(path) as f:
                if f.read() == body:
                    self.identical += 1
                    return
            if not self.force:
                self.differs.append(path)
                return
            self.changed += 1
        else:
            self.created += 1
        with open(path, "w") as f:
            f.write(body)


def make_verifier(RNS):
    """Ed25519 verification, as the reference implementation performs it.

    dump verifies with tweetnacl, so the two sides remain independent
    at the level that matters: two separate curve implementations must
    agree on the same signature over the same assembled message.
    """
    from RNS.Cryptography import Ed25519PublicKey

    def verify(ed25519_public, signature, message):
        try:
            Ed25519PublicKey.from_public_bytes(ed25519_public).verify(signature, message)
            return True
        except Exception:
            return False

    return verify


def gen_identity(RNS, w):
    """Public key to identity hash.

    raw is the public key, not the private key. Deriving one from the
    other is X25519 and Ed25519, standard primitives with their own
    published vectors; the keyset vectors cover that separately.
    """
    for n, (private_hex, hash_hex) in enumerate(UPSTREAM_KEYS):
        identity = RNS.Identity.from_bytes(bytes.fromhex(private_hex))
        public   = identity.get_public_key()
        half     = RNS.Identity.KEYSIZE // 8 // 2

        # The upstream table is the source of truth for these two values.
        # Everything else is derived here and must agree with it.
        assert identity.get_private_key() == bytes.fromhex(private_hex)
        assert identity.hash == bytes.fromhex(hash_hex)

        w.vector("identity", "upstream-%d" % n,
            "public key of upstream key %d" % n,
            [public.hex()],
            [
                field("public_key",     public.hex()),
                field("x25519_public",  public[:half].hex()),
                field("ed25519_public", public[half:].hex()),
                field("identity_hash",  identity.hash.hex()),
            ],
            source=UPSTREAM_KEY_SOURCE)


def gen_keyset(RNS, w):
    """The private-to-public derivation the identity vectors omit."""
    cases  = [("upstream-%d" % n, k, "upstream key %d" % n)
              for n, (k, _) in enumerate(UPSTREAM_KEYS)]
    cases += CLAMP_KEYS

    made = {}
    for name, private_hex, purpose in cases:
        identity = RNS.Identity.from_bytes(bytes.fromhex(private_hex))
        private  = identity.get_private_key()
        public   = identity.get_public_key()
        half     = RNS.Identity.KEYSIZE // 8 // 2
        made[name] = identity

        source = UPSTREAM_KEY_SOURCE if name.startswith("upstream-") else GENERATED_SOURCE

        w.vector("keyset", name, purpose,
            [private.hex()],
            [
                field("private_key",     private.hex()),
                field("x25519_private",  private[:half].hex()),
                field("ed25519_private", private[half:].hex()),
                field("public_key",      public.hex()),
                field("x25519_public",   public[:half].hex()),
                field("ed25519_public",  public[half:].hex()),
                field("identity_hash",   identity.hash.hex()),
            ],
            source=source)

    # The property the clamping pair exists to record.
    assert made["unclamped"].get_private_key() != made["clamped"].get_private_key()
    assert made["unclamped"].get_public_key()  == made["clamped"].get_public_key()
    assert made["unclamped"].hash              == made["clamped"].hash


def gen_destination(RNS, w):
    for name, aspects, key_index, purpose in DESTINATIONS:
        app_name = aspects[0]
        rest     = aspects[1:]

        full       = RNS.Destination.expand_name(None, app_name, *rest)
        name_bytes = full.encode("utf-8")
        name_hash  = RNS.Identity.full_hash(name_bytes)[:RNS.Identity.NAME_HASH_LENGTH // 8]

        if key_index is None:
            identity      = None
            identity_hash = None
        else:
            identity      = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))
            identity_hash = identity.hash

        destination_hash = RNS.Destination.hash(identity, app_name, *rest)

        # Every byte string in the format is hex, names included. A name
        # is arbitrary bytes; printing it as text would let a newline in
        # an aspect forge or hide a field.
        expect = [field("name", hexf(name_bytes)),
                  field("app_name", hexf(app_name.encode("utf-8")))]
        for aspect in rest:
            expect.append(field("aspect", hexf(aspect.encode("utf-8"))))
        expect.append(field("name_hash", name_hash.hex()))
        expect.append(field("identity_hash", identity_hash.hex() if identity_hash else "-"))
        expect.append(field("destination_hash", destination_hash.hex()))

        w.vector("destination", name, purpose,
            [name_bytes.hex(), identity_hash.hex() if identity_hash else "-"],
            expect)


def gen_signature(RNS, w, verify):
    """One adopted signature and one negative counterpart.

    Ed25519 itself has published vectors and is not restated here. What
    this pins is that Identity.sign is plain Ed25519 over the message,
    with no prefix, domain separator or prior hashing.

    Decode class: expect records the message by length and digest, not
    by content, so raw cannot be rebuilt from it.
    """
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[0][0]))
    public   = identity.get_public_key()
    message  = UPSTREAM_SIGNED_MESSAGE.encode("utf-8")
    good     = bytes.fromhex(UPSTREAM_SIGNATURE)

    # The reference implementation must reproduce the adopted value.
    assert identity.sign(message) == good

    bad = bytearray(good)
    bad[0] ^= 0x01
    bad = bytes(bad)

    # The one input in the corpus on which the two backends python-rns
    # ships disagree. The pin names the one that refuses it; the vector
    # records that verdict, and the assertions record that there was a
    # choice to make.
    mangled = non_canonical(good)
    assert not verify(public[32:], mangled, message)
    assert internal_accepts(public[32:], mangled, message)

    cases = [
        ("upstream", good, "adopted signature over the upstream message", UPSTREAM_SIG_SOURCE),
        ("altered", bad, "the same signature with the first byte altered",
         "constructed by tools/gen from signature/upstream"),
        ("non-canonical-s", mangled,
         "the same signature with S re-encoded as S+L; the pinned backend rejects it",
         "constructed by tools/gen from signature/upstream"),
    ]

    for name, signature, purpose, source in cases:
        w.vector("signature", name, purpose,
            [public.hex(), message.hex(), signature.hex()],
            [
                field("ed25519_public", public[32:].hex()),
                field("message_length", "%d" % len(message)),
                field("message_sha256", hashlib.sha256(message).hexdigest()),
                field("signature",      signature.hex()),
                field("valid",          "yes" if verify(public[32:], signature, message) else "no"),
            ],
            source=source)


def gen_sign(RNS, w):
    """The other direction of the same adopted value.

    tests/identity.py:31 asserts what Identity.sign produces, not what
    it verifies. test/signature records the value and asks only that a
    signature check succeed; here the signature is not given, it is
    produced from the private key and the message.

    Ed25519 signing is deterministic, RFC 8032 section 5.1.6, so this
    is a fact a vector can state. An implementation that draws a random
    nonce, or signs with the wrong half of the Reticulum private key,
    passes every other vector in the corpus and emits announces and
    link proofs that nothing accepts.

    Decode class, for the same reason as test/signature: expect records
    the message by length and digest, not by content.
    """
    private = bytes.fromhex(UPSTREAM_KEYS[0][0])
    message = UPSTREAM_SIGNED_MESSAGE.encode("utf-8")

    identity  = RNS.Identity.from_bytes(private)
    signature = identity.sign(message)
    assert signature == bytes.fromhex(UPSTREAM_SIGNATURE)

    w.vector("sign", "upstream",
        "private key and message to the signature upstream asserts",
        [private.hex(), message.hex()],
        [
            field("private_key",     private.hex()),
            field("ed25519_private", private[32:].hex()),
            field("ed25519_public",  identity.get_public_key()[32:].hex()),
            field("message_length",  "%d" % len(message)),
            field("message_sha256",  hashlib.sha256(message).hexdigest()),
            field("signature",       signature.hex()),
        ],
        source="python-rns %s tests/identity.py:31 (%s)" % (PIN_VERSION, PIN))


def gen_proof(RNS, w, verify):
    """The fourth packet type, and the only one nothing else covers.

    A proof is what a receiver sends back for a data packet it accepted.
    It is addressed not to a destination but to the first 16 bytes of
    the proved packet's hash (RNS/Packet.py:378#get_hash), which is how the
    sender recognises the answer to its own packet.

    Both accepted forms are recorded. The reference emits the implicit
    one by default and accepts either (RNS/Packet.py:481#EXPL_LENGTH).
    """
    private   = bytes.fromhex(UPSTREAM_KEYS[0][0])
    recipient = RNS.Identity.from_bytes(private)

    public_only = RNS.Identity(create_keys=False)
    public_only.load_public_key(recipient.get_public_key())

    with pinned(RNS, "proof"):
        destination = RNS.Destination(public_only, RNS.Destination.OUT,
                                      RNS.Destination.SINGLE,
                                      "rns_unit_tests", "link", "establish")
        RNS.Identity.known_ratchets.pop(destination.hash, None)
        proved = RNS.Packet(destination, b"reticulum")
        proved.pack()

    packet_hash = RNS.Identity.full_hash(proved.get_hashable_part())
    assert packet_hash == proved.packet_hash

    # prove() reads the setting through Reticulum.should_use_implicit_proof,
    # which is what a config file sets. gen starts no instance, so the
    # class attribute is set here instead.
    # RNS/Reticulum.py:259#__use_implicit_proof.
    forms = [
        ("implicit", True,
         "the 64-byte form the reference emits by default"),
        ("explicit", False,
         "the 96-byte form, hash and signature, which the reference also accepts"),
    ]

    made = {}
    for name, implicit, purpose in forms:
        RNS.Reticulum._Reticulum__use_implicit_proof = implicit
        with captured(RNS) as sent:
            recipient.prove(proved)
        assert len(sent) == 1
        proof = sent[0]

        payload = proof.raw[19:]
        assert len(payload) == (64 if implicit else 96)

        signature = payload if implicit else payload[32:]
        assert verify(recipient.get_public_key()[32:], signature, packet_hash)

        w.vector("proof", name, purpose,
            [proved.raw.hex(), recipient.get_public_key().hex(), proof.raw.hex()],
            describe_proof(proved.raw, recipient.get_public_key(), proof.raw, verify))
        made[name] = proof

    # The proved packet after a transport node rewrote it, with the proof
    # left exactly as it was. That is the point of excluding the four low
    # flag bits, the hop count and the transport id from the hash: the
    # proof still addresses the right packet and the signature still
    # verifies, over a packet whose bytes have changed.
    transport_id = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0])).hash
    relayed = transport_insert(proved.raw, 3, transport_id)
    assert hashlib.sha256(hashable_part(relayed)).digest() == packet_hash

    described = describe_proof(relayed, recipient.get_public_key(),
                               made["implicit"].raw, verify)
    assert lookup_field(described, "destination_match") == "yes"
    assert lookup_field(described, "signature_valid") == "yes"

    # Neither of the two accepted payload lengths. The reference reads
    # 64 as implicit and 96 as explicit and drops everything else; this
    # is the rejection that names both.
    short = made["implicit"].raw[:-1]
    w.vector("proof", "invalid-length",
        "63-byte payload, neither of the two accepted lengths",
        [proved.raw.hex(), recipient.get_public_key().hex(), short.hex()],
        describe_proof(proved.raw, recipient.get_public_key(), short, verify),
        source="constructed by tools/gen from proof/implicit")

    w.vector("proof", "proved-in-transport",
        "the proved packet at three hops in header 2; the proof is unchanged and still verifies",
        [relayed.hex(), recipient.get_public_key().hex(), made["implicit"].raw.hex()],
        described,
        source="constructed by tools/gen from proof/implicit, "
               "per RNS/Transport.py:1369#HEADER_2")


def describe_proof(proved_raw, signer_public, raw, verify):
    echo = [
        field("proved_packet", proved_raw.hex()),
        field("signer_public", signer_public.hex()),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) not in (SIGLEN, ADDRLEN * 2 + SIGLEN):
        return echo + invalid("invalid-length",
                              ("payload_length", len(payload)),
                              ("implicit_length", SIGLEN),
                              ("explicit_length", ADDRLEN * 2 + SIGLEN))

    explicit    = len(payload) == ADDRLEN * 2 + SIGLEN
    packet_hash = hashlib.sha256(hashable_part(proved_raw, None)).digest()
    signature   = payload[ADDRLEN*2:] if explicit else payload
    signer      = signer_public[KEYHALF:]

    return lines + [
        field("form",             "explicit" if explicit else "implicit"),
        field("packet_hash",      packet_hash.hex()),
        field("proof_hash",       payload[:ADDRLEN*2].hex() if explicit else "-"),
        field("hash_match",       "yes" if not explicit
                                  else ("yes" if payload[:ADDRLEN*2] == packet_hash else "no")),
        field("proof_destination", packet_hash[:ADDRLEN].hex()),
        field("destination_match", "yes" if h["dest_hash"] == packet_hash[:ADDRLEN] else "no"),
        field("signature",        signature.hex()),
        field("signer_ed25519",   signer.hex()),
        field("signature_valid",  "yes" if verify(signer, signature, packet_hash) else "no"),
    ]


def ifac_key(RNS, netname, netkey):
    """The interface identity, composed here rather than called.

    RNS/Reticulum.py:958#ifac_netname to :971 derives it inline in the
    constructor of a running instance and exposes no function to call.
    Every step is an RNS function called with RNS constants, but the
    order is this program's, and the order is exactly what a foreign
    implementation can get wrong: origin is a concatenation of two
    hashes, and neither half is present when that half is not
    configured.

    That is why netname and netkey are lines of raw and the key is a
    field: cmd/dump derives it again, from the same two strings and
    without sharing a line of code, and cmd/check diffs the results.
    """
    origin = b""
    if netname is not None:
        origin += RNS.Identity.full_hash(netname)
    if netkey is not None:
        origin += RNS.Identity.full_hash(netkey)

    return origin, RNS.Cryptography.hkdf(length=64,
                                         derive_from=RNS.Identity.full_hash(origin),
                                         salt=RNS.Reticulum.IFAC_SALT, context=None)


IFACS = [
    ("announce", b"reticulum-vectors", None, 16,
     "a named network, no passphrase; origin is one hash"),
    ("passphrase", b"reticulum-vectors", b"open sesame", 16,
     "network and passphrase; origin is the two hashes, name first"),
    ("passphrase-only", None, b"open sesame", 16,
     "a passphrase and no network; origin is one hash, and not the same one"),
    ("minimum-size", b"reticulum-vectors", None, 1,
     "a one-byte access code, IFAC_MIN_SIZE; the size is not on the wire"),
]


def gen_ifac(RNS, w, announce_raw_bytes):
    """The one transformation of the header that happens below Packet.

    Packet.unpack never reads bit 7 (RNS/Packet.py:250#header_type).
    Transport does, on the way out and on the way in, and a frame on an
    interface with a named network or a passphrase does not look like a
    packet at all until it is unmasked.

    The masking is not composed: the frame is what
    RNS/Transport.py:1069#transmit produced, through Transport.transmit.
    """
    for name, netname, netkey, size, purpose in IFACS:
        origin, key = ifac_key(RNS, netname, netkey)
        identity    = RNS.Identity.from_bytes(key)

        class Interface:
            pass

        iface = Interface()
        iface.ifac_identity = identity
        iface.ifac_size     = size
        iface.ifac_key      = key

        frames = []
        iface.process_outgoing = frames.append

        # transmit logs and swallows exceptions, so the capture is the
        # only evidence that it ran.
        RNS.Transport.transmit(iface, announce_raw_bytes)
        assert len(frames) == 1, "Transport.transmit produced no frame"
        masked = frames[0]

        assert masked[0] & 0x80 == 0x80
        assert len(masked) == len(announce_raw_bytes) + size

        ifac = masked[2:2+size]
        expected_ifac = identity.sign(announce_raw_bytes)[-size:]
        assert ifac == expected_ifac

        w.vector("ifac", name, purpose,
            [hexf(netname or b""), hexf(netkey or b""),
             "%02x" % size, masked.hex()],
            [
                field("netname",       hexf(netname or b"")),
                field("netkey",        hexf(netkey or b"")),
                field("ifac_origin",   origin.hex()),
                field("ifac_key",      key.hex()),
                field("ifac_size",     "%d" % size),
                field("frame_length",  "%d" % len(masked)),
                field("ifac",          ifac.hex()),
                field("packet",        announce_raw_bytes.hex()),
                field("expected_ifac", expected_ifac.hex()),
                field("ifac_valid",    "yes"),
            ])


DEST_TYPES   = ["single", "group", "plain", "link"]
PACKET_TYPES = ["data", "announce", "linkrequest", "proof"]
XPORT_TYPES  = ["broadcast", "transport", "relay", "tunnel"]
CONTEXTS     = {0x00: "none", 0x0b: "path_response", 0x0e: "channel",
                0xfa: "keepalive", 0xfb: "link_identify", 0xfc: "link_close",
                0xfd: "link_proof", 0xfe: "link_rtt", 0xff: "link_request_proof"}

# Only MODE_AES256_CBC is enabled at the pin, RNS/Link.py:133#ENABLED_MODES.
LINK_MODES   = {0x01: "aes256_cbc"}

KEYSIZE     = 64
NAMEHASHLEN = 10
RANDHASHLEN = 10
SIGLEN      = 64
RATCHETLEN  = 32
ADDRLEN     = 16
KEYHALF     = 32
TOKEN_OVERHEAD = 48     # RNS/Cryptography/Token.py:50#TOKEN_OVERHEAD
MAX_HOPS    = 128       # RNS.Transport.PATHFINDER_M
ECPUBSIZE   = 64        # RNS/Link.py:70#ECPUBSIZE, both public keys
SIGNALLEN   = 3         # RNS/Link.py:80#LINK_MTU_SIZE, LINK_MTU_SIZE
MTU_BYTEMASK = 0x1fffff # RNS/Link.py:144#MTU_BYTEMASK
MODE_DEFAULT = 0x01     # RNS/Link.py:134#MODE_DEFAULT
ENVELOPELEN  = 6        # RNS/Channel.py:133#MSGTYPE, three big-endian shorts


# The Ed25519 group order, RFC 8032 section 5.1.
ED25519_L = 2**252 + 27742317777372353535851937790883648493


def non_canonical(signature):
    """The same signature with S re-encoded as S + L.

    RFC 8032 section 5.1.7 admits only S < L, so this is a second
    encoding of one signature rather than a forgery: R is untouched and
    S reduces to the original. The openssl backend refuses it, the
    internal fallback accepts it, and so does an implementation that
    reduces S instead of range-checking it.
    """
    s = int.from_bytes(signature[32:], "little") + ED25519_L
    assert s < 2**256, "S + L does not fit in 32 bytes"
    return signature[:32] + s.to_bytes(32, "little")


def internal_accepts(ed25519_public, signature, message):
    """The verdict of the backend that is not pinned.

    The two non-canonical vectors exist because the answer differs from
    the pinned one. Asserting it here keeps the vector from quietly
    becoming a vector about nothing if a future release aligns them.
    """
    from RNS.Cryptography.pure25519 import ed25519_oop
    try:
        ed25519_oop.VerifyingKey(ed25519_public).verify(signature, message)
        return True
    except Exception:
        return False


def invalid(reason, *evidence):
    """A packet that cannot be decoded yields the reason and the numbers
    behind it, so a disagreement names the rule rather than the stage."""
    return [field("invalid", reason)] + [field(k, "%d" % v) for k, v in evidence]


def describe_header(raw):
    """Every packet kind starts here.

    The layout is read without consulting any RNS object, so gen and
    dump are two independent decoders of the same bytes and check
    compares them. A misreading on one side shows up as a diff.
    """
    if len(raw) < 2:
        return invalid("short-header", ("length", len(raw)), ("minimum_length", 2)), None

    flags, hops = raw[0], raw[1]

    header_type      = (flags & 0b01000000) >> 6
    context_flag     = (flags & 0b00100000) >> 5
    transport_type   = (flags & 0b00010000) >> 4
    destination_type = (flags & 0b00001100) >> 2
    packet_type      = (flags & 0b00000011)

    if hops >= MAX_HOPS:
        return invalid("hop-limit", ("hops", hops), ("hop_limit", MAX_HOPS)), None

    header_len = 3 + ADDRLEN * (header_type + 1)
    if len(raw) < header_len:
        return invalid("short-header", ("length", len(raw)), ("minimum_length", header_len)), None

    if header_type == 1:
        transport_id = raw[2:2+ADDRLEN]
        dest_hash    = raw[2+ADDRLEN:2+2*ADDRLEN]
        context      = raw[2+2*ADDRLEN]
    else:
        transport_id = None
        dest_hash    = raw[2:2+ADDRLEN]
        context      = raw[2+ADDRLEN]
    payload = raw[header_len:]

    lines = [
        field("flags",            "%02x" % flags),
        field("header_type",      "%d" % (header_type + 1)),
        field("context_flag",     "set" if context_flag else "unset"),
        field("transport_type",   XPORT_TYPES[transport_type]),
        field("destination_type", DEST_TYPES[destination_type]),
        field("packet_type",      PACKET_TYPES[packet_type]),
        field("hops",             "%d" % hops),
        field("transport_id",     transport_id.hex() if transport_id else "-"),
        field("destination_hash", dest_hash.hex()),
        field("context",          CONTEXTS.get(context, "%02x" % context)),
        field("payload_length",   "%d" % len(payload)),
    ]
    return lines, {"payload": payload, "context_flag": context_flag,
                   "dest_hash": dest_hash, "context": context}


def describe_announce(raw, verify):
    lines, h = describe_header(raw)
    if h is None:
        return lines

    payload      = h["payload"]
    context_flag = h["context_flag"]
    dest_hash    = h["dest_hash"]

    minimum = KEYSIZE + NAMEHASHLEN + RANDHASHLEN + SIGLEN
    if context_flag == 1:
        minimum += RATCHETLEN
    if len(payload) < minimum:
        return invalid("short-payload",
                       ("payload_length", len(payload)), ("minimum_length", minimum))

    at          = 0
    public_key  = payload[at:at+KEYSIZE];      at += KEYSIZE
    name_hash   = payload[at:at+NAMEHASHLEN];  at += NAMEHASHLEN
    random_hash = payload[at:at+RANDHASHLEN];  at += RANDHASHLEN
    if context_flag == 1:
        ratchet = payload[at:at+RATCHETLEN];   at += RATCHETLEN
    else:
        ratchet = b""
    signature   = payload[at:at+SIGLEN];       at += SIGLEN
    app_data    = payload[at:]

    identity_hash = hashlib.sha256(public_key).digest()[:ADDRLEN]
    expected_hash = hashlib.sha256(name_hash + identity_hash).digest()[:ADDRLEN]

    # app_data is transmitted after the signature but signed before it.
    signed_data = dest_hash + public_key + name_hash + random_hash + ratchet + app_data

    return lines + [
        field("public_key",       public_key.hex()),
        field("name_hash",        name_hash.hex()),
        field("random_hash",      random_hash.hex()),
        field("ratchet",          ratchet.hex() if ratchet else "-"),
        field("signature",        signature.hex()),
        field("app_data",         app_data.hex() if app_data else "-"),
        field("identity_hash",    identity_hash.hex()),
        field("expected_hash",    expected_hash.hex()),
        field("destination_match", "yes" if dest_hash == expected_hash else "no"),
        field("signed_data",      signed_data.hex()),
        field("signature_valid",  "yes" if verify(public_key[32:], signature, signed_data) else "no"),
    ]


def announce_raw(RNS, key_index, aspects, app_data, ratchet, path_response, tag, tmpdir):
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))

    with pinned(RNS, tag):
        destination = RNS.Destination(identity, RNS.Destination.IN,
                                      RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        if ratchet:
            destination.enable_ratchets(os.path.join(tmpdir, tag))

        packet = destination.announce(app_data=app_data, path_response=path_response, send=False)
        packet.pack()

    # The reference implementation must accept what it produced.
    assert RNS.Identity.validate_announce(packet)
    return packet.raw


def transport_insert(raw, hops, transport_id):
    """Rewrite a header 1 packet as a header 2 packet in transport,
    exactly as Transport.mangle_hops does at RNS/Transport.py:1369#HEADER_2."""
    flags = raw[0] | (0x01 << 6) | (0x01 << 4)
    return bytes([flags, hops]) + transport_id + raw[2:]


def gen_announce(RNS, w, tmpdir, verify):
    raws = {}

    for name, key_index, aspects, app_data, ratchet, path_response, purpose in ANNOUNCES:
        raw = announce_raw(RNS, key_index, aspects, app_data, ratchet,
                           path_response, "announce-" + name, tmpdir)
        raws[name] = raw
        w.vector("announce", name, purpose,
            [raw.hex()],
            describe_announce(raw, verify))

    base         = raws["minimal"]
    transport_id = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0])).hash

    # Derived cases. Each states in its source how it was built, since
    # none of them is something the reference implementation emitted.
    derived = [
        ("in-transport", transport_insert(base, 1, transport_id),
         "header 2, one hop, transport id inserted",
         "constructed by tools/gen from announce/minimal, "
         "per RNS/Transport.py:1369#HEADER_2"),

        ("destination-mismatch", base[:2] + bytes(ADDRLEN) + base[2+ADDRLEN:],
         "destination hash replaced with zeroes; the announce decodes but does not match",
         "constructed by tools/gen from announce/minimal"),

        ("short-payload", base[:-1],
         "one byte short of the minimum payload",
         "constructed by tools/gen from announce/minimal"),

        # One byte short of a header 1 header. Nothing about the packet
        # can be read, not even the context byte, so the rejection names
        # a length and not a payload. Until doc/fields was checked
        # against test/, this rule was described in doc/packet with an
        # example and carried by no vector.
        ("short-header", base[:18],
         "18 bytes, one short of a header 1 header",
         "constructed by tools/gen from announce/minimal"),

        ("hop-limit", base[:1] + bytes([MAX_HOPS]) + base[2:],
         "hop count at the limit, which the reference implementation rejects",
         "constructed by tools/gen from announce/minimal"),

        # The other side of the same boundary. Without it a decoder with
        # no hop limit and a decoder whose limit is off by one both fail
        # hop-limit and are indistinguishable; every implementation
        # measured in CONFORMANCE failed it, two of them for different
        # reasons. The hop count is not part of the signed data, so this
        # announce still verifies.
        ("hop-limit-below", base[:1] + bytes([MAX_HOPS - 1]) + base[2:],
         "hop count one below the limit, which decodes",
         "constructed by tools/gen from announce/minimal"),

        ("altered-signature",
         base[:-SIGLEN] + bytes([base[-SIGLEN] ^ 0x01]) + base[-SIGLEN+1:],
         "first signature byte altered; the announce decodes and matches, but the signature does not verify",
         "constructed by tools/gen from announce/minimal"),

        # announce/minimal carries no app data, so the signature is the
        # tail of the packet. The same re-encoding as test/signature,
        # on a whole packet, because that is where it costs something.
        ("non-canonical-s", base[:-SIGLEN] + non_canonical(base[-SIGLEN:]),
         "signature S re-encoded as S+L; the announce decodes and matches, and the pinned backend rejects it",
         "constructed by tools/gen from announce/minimal"),
    ]

    for name, raw, purpose, source in derived:
        w.vector("announce", name, purpose,
            [raw.hex()],
            describe_announce(raw, verify),
            source=source)

    return base


def describe_plain(raw):
    lines, h = describe_header(raw)
    if h is None:
        return lines
    payload = h["payload"]

    return lines + [
        field("plaintext_length", "%d" % len(payload)),
        field("plaintext",        hexf(payload)),
    ]


def gen_plain(RNS, w):
    """Packets to a plain destination, which are not encrypted at all.

    Destination.encrypt returns the plaintext unchanged for this type
    (RNS/Destination.py:603#PLAIN), so there is no ephemeral key, no token and
    no padding: the payload is the data. The type had no vectors, and it
    is the one every transport node has to handle whether or not it ever
    encrypts anything, because path requests are addressed to one.

    The destination has no identity, so its hash is SHA-256 of the name
    hash alone; test/destination/no-identity records that derivation.
    """
    # The payload here is arbitrary bytes, not a path request: what the
    # payload of a path request means is test/pathrequest, and these two
    # vectors record only that a plain destination hands the payload
    # through untouched, whatever it holds.
    wanted = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[0][0]))
    destination_hash = RNS.Destination.hash(wanted, "rns_unit_tests", "link", "establish")

    cases = [
        ("payload", (RNS.Transport.APP_NAME, "path", "request"),
         destination_hash + bytes.fromhex("0102030405060708090a"),
         "26 bytes of payload, delivered unencrypted and undecomposed"),
        ("empty", (RNS.Transport.APP_NAME, "path", "request"), b"",
         "no payload at all, which a plain destination permits and an encrypted one cannot"),
    ]

    for name, aspects, data, purpose in cases:
        with pinned(RNS, "plain-" + name):
            out = RNS.Destination(None, RNS.Destination.OUT, RNS.Destination.PLAIN,
                                  aspects[0], *aspects[1:])
            packet = RNS.Packet(out, data, packet_type=RNS.Packet.DATA,
                                transport_type=RNS.Transport.BROADCAST,
                                header_type=RNS.Packet.HEADER_1)
            packet.pack()

        # The property the kind exists to record: nothing was encrypted.
        assert packet.raw[19:] == data
        assert packet.raw[2:18] == out.hash

        w.vector("plain", name, purpose,
            [packet.raw.hex()],
            describe_plain(packet.raw))


def describe_pathrequest(raw):
    """Which fields a path request carries is decided by how long it is,
    and by nothing else. RNS/Transport.py:2965#TRUNCATED_HASHLENGTH.
    """
    lines, h = describe_header(raw)
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) < ADDRLEN:
        return invalid("short-payload",
                       ("payload_length", len(payload)),
                       ("minimum_length", ADDRLEN))

    wanted = payload[:ADDRLEN]
    if len(payload) > ADDRLEN * 2:
        requester = payload[ADDRLEN:ADDRLEN*2]
        tag       = payload[ADDRLEN*2:]
    else:
        requester = None
        tag       = payload[ADDRLEN:]

    return lines + [
        field("wanted_hash",  wanted.hex()),
        field("requester_id", requester.hex() if requester else "-"),
        field("tag",          hexf(tag)),
        field("unique_tag",   (wanted + tag[:ADDRLEN]).hex() if tag else "-"),
        field("accepted",     "yes" if tag else "no"),
    ]


def gen_pathrequest(RNS, w):
    """The payload a transport node reads before it knows a path is
    being asked for.

    request_path writes two or three fields, and the handler reads them
    back by length alone: there is no count, no type byte and no
    delimiter. A tag of 17 bytes is therefore indistinguishable from a
    transport id followed by a tag of one, and the reference reads it as
    the latter. That ambiguity is the vector.

    The two instance attributes set below are what a running instance
    would hold. request_path reads both and neither is a value the
    corpus asserts anything about; the bytes are the reference's.

        RNS/Transport.py:2871#transport_enabled
        RNS/Reticulum.py:1762#__transport_enabled
    """
    wanted = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[0][0]))
    destination_hash = RNS.Destination.hash(wanted, "rns_unit_tests", "link", "establish")

    RNS.Transport.identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0]))

    cases = [
        ("tagged", False, None,
         "the form an instance that is not a transport node sends"),
        ("transport", True, None,
         "the transport-node form; the requesting instance's id sits between the two"),
        ("tagless", False, b"",
         "the destination hash alone, which the reference reads and then drops"),
        ("ambiguous", False, bytes.fromhex("0102030405060708090a0b0c0d0e0f1011"),
         "a 17-byte tag, which the length rule reads as a transport id and one tag byte"),
        ("long-tag", False, bytes.fromhex("0102030405060708090a0b0c0d0e0f10" * 2 + "11"),
         "a 33-byte tag; 17 bytes are left after the split and 16 of those survive"),
    ]

    for name, transport, tag, purpose in cases:
        RNS.Reticulum._Reticulum__transport_enabled = transport
        with pinned(RNS, "pathrequest-" + name):
            with captured(RNS) as sent:
                RNS.Transport.request_path(destination_hash, tag=tag)
        RNS.Reticulum._Reticulum__transport_enabled = False

        assert len(sent) == 1
        raw = sent[0].raw

        # The handler's own reading of what it just built, so that the
        # decomposition below is measured against RNS and not only
        # against cmd/dump.
        described = describe_pathrequest(raw)
        seen = handler_reads(RNS, raw[19:])
        if seen is None:
            assert lookup_field(described, "accepted") == "no"
        else:
            assert lookup_field(described, "wanted_hash") == seen["destination_hash"].hex()
            assert lookup_field(described, "requester_id") == hexf(seen["transport_id"])
            assert lookup_field(described, "unique_tag") == seen["unique_tag"].hex()

        w.vector("pathrequest", name, purpose, [raw.hex()], described)

    # Shorter than the destination hash it is supposed to name. The
    # handler reads nothing at all from it, which is a rejection with no
    # rule of its own; the corpus names the length that failed.
    with pinned(RNS, "pathrequest-short"):
        out = RNS.Destination(None, RNS.Destination.OUT, RNS.Destination.PLAIN,
                              RNS.Transport.APP_NAME, "path", "request")
        short = RNS.Packet(out, destination_hash[:ADDRLEN-1], packet_type=RNS.Packet.DATA,
                           transport_type=RNS.Transport.BROADCAST,
                           header_type=RNS.Packet.HEADER_1)
        short.pack()

    assert handler_reads(RNS, short.raw[19:]) is None

    w.vector("pathrequest", "short",
        "15 bytes, one short of the destination hash a path request names",
        [short.raw.hex()],
        describe_pathrequest(short.raw))


def handler_reads(RNS, data):
    """What Transport.path_request_handler took the payload to mean.

    The handler acts on what it reads rather than returning it, so the
    call it makes is intercepted and its arguments are the answer. None
    means it made no call: the payload named no destination, or named
    one with no tag.

        RNS/Transport.py:2959#TRUNCATED_HASHLENGTH
    """
    real_request = RNS.Transport.path_request
    seen = []

    def path_request(destination_hash, is_from_local_client, attached_interface,
                     requestor_transport_id=None, tag=None):
        seen.append({"destination_hash": destination_hash,
                     "transport_id": requestor_transport_id,
                     "tag": tag,
                     "unique_tag": destination_hash + tag})

    class Packet:
        receiving_interface = None

    RNS.Transport.path_request = staticmethod(path_request)
    RNS.Transport.discovery_pr_tags.clear()
    try:
        RNS.Transport.path_request_handler(data, Packet())
    finally:
        RNS.Transport.path_request = real_request

    return seen[0] if seen else None


def hashable_part(raw, payload_len=None):
    """The bytes a packet is hashed over, RNS/Packet.py:348#get_hashable_part.

    The low four flag bits and the hop count are excluded so that a
    packet keeps its hash while it travels. That much is the packet
    hash, which a proof is taken over.

    A link id is the same hash with any signalling bytes chopped off
    the end first, so that signalling the MTU does not change the
    identity of the link (RNS/Link.py:336#link_id_from_lr_packet). Pass
    the payload length to get that; leave it out for the packet hash.
    """
    header_type = (raw[0] & 0b01000000) >> 6
    part = bytes([raw[0] & 0x0f]) + (raw[2+ADDRLEN:] if header_type else raw[2:])
    if payload_len is None:
        return part
    excess = payload_len - ECPUBSIZE
    return part[:len(part)-excess] if excess > 0 else part


def describe_signalling(signalling):
    """Three bytes, big endian: three bits of mode and 21 of mtu.

    A link request and the proof that answers it carry the same three
    bytes in different positions and read them the same way. None means
    the shorter form, where the mode falls back to the default and the
    mtu has no fallback at all. RNS/Link.py:148#signalling_bytes.
    """
    if signalling is None:
        mode, mtu = MODE_DEFAULT, None
    else:
        value = int.from_bytes(signalling, "big")
        mode  = (value >> 21) & 0x07
        mtu   = value & MTU_BYTEMASK

    return [
        field("signalling", signalling.hex() if signalling is not None else "-"),
        field("mode",       LINK_MODES.get(mode, "%02x" % mode)),
        field("mtu",        "-" if mtu is None else "%d" % mtu),
    ]


def describe_linkrequest(raw):
    lines, h = describe_header(raw)
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) not in (ECPUBSIZE, ECPUBSIZE + SIGNALLEN):
        return invalid("invalid-length",
                       ("payload_length", len(payload)),
                       ("accepted_length", ECPUBSIZE),
                       ("signalled_length", ECPUBSIZE + SIGNALLEN))

    signalled = len(payload) == ECPUBSIZE + SIGNALLEN
    link_id   = hashlib.sha256(hashable_part(raw, len(payload))).digest()[:ADDRLEN]

    return lines + [
        field("x25519_public",  payload[:KEYHALF].hex()),
        field("ed25519_public", payload[KEYHALF:ECPUBSIZE].hex()),
    ] + describe_signalling(payload[ECPUBSIZE:] if signalled else None) + [
        field("link_id",        link_id.hex()),
    ]


@contextlib.contextmanager
def captured(RNS):
    """Packet.send hands the packet to Transport, which is not running.
    The corpus wants the bytes, so send packs and records instead."""
    real_send = RNS.Packet.send
    sent = []

    def send(self):
        self.pack()
        sent.append(self)
        return True

    RNS.Packet.send = send
    try:
        yield sent
    finally:
        RNS.Packet.send = real_send


def link_session(RNS, tag):
    """Establish one link, far enough to produce packets from both ends.

    The request is assembled as Link.__init__ does at
    RNS/Link.py:304#initiator. The initiator half of that constructor
    reaches for a running instance three lines earlier, so the four
    lines that produce bytes are run here instead. The responder is then
    built as validate_request builds it at
    RNS/Link.py:189#peer_sig_pub_bytes, up to and including prove; what
    follows there registers the link and starts a watchdog, and produces
    no bytes.

    Everything that shapes a byte is the reference's own: the key
    classes Link resolves, its signalling encoder, its handshake, its
    prove, and Packet.pack.

    One pinned block covers all of it. The responder draws a key of its
    own, and it has to come from the same stream for the proof to be
    reproducible.
    """
    key_index, aspects = LINK_DESTINATION
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))

    public_only = RNS.Identity(create_keys=False)
    public_only.load_public_key(identity.get_public_key())

    link_mod = sys.modules["RNS.Link"]
    with pinned(RNS, tag):
        out_destination = RNS.Destination(public_only, RNS.Destination.OUT,
                                          RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        prv     = link_mod.X25519PrivateKey.generate()
        sig_prv = link_mod.Ed25519PrivateKey.generate()

        signalling   = RNS.Link.signalling_bytes(RNS.Reticulum.MTU, RNS.Link.MODE_DEFAULT)
        request_data = prv.public_key().public_bytes() + \
                       sig_prv.public_key().public_bytes() + signalling

        request = RNS.Packet(out_destination, request_data,
                             packet_type=RNS.Packet.LINKREQUEST)
        request.pack()

        in_destination = RNS.Destination(identity, RNS.Destination.IN,
                                         RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        link = RNS.Link(owner=in_destination,
                        peer_pub_bytes=request_data[:KEYHALF],
                        peer_sig_pub_bytes=request_data[KEYHALF:ECPUBSIZE])
        link.set_link_id(request)
        link.mtu  = RNS.Link.mtu_from_lr_packet(request)
        link.mode = RNS.Link.mode_from_lr_packet(request)
        link.handshake()

        with captured(RNS) as sent:
            link.prove()

    return {
        "identity":       identity,
        "in_destination": in_destination,
        "prv":            prv,
        "sig_prv":        sig_prv,
        "request":        request,
        "link":           link,
        "proof":          sent[0],
    }


def initiator_link(RNS, session):
    """The initiator half, as validate_proof completes it at
    RNS/Link.py:405#initiator.

    Link.__init__ draws keys of its own, and the initiator's are already
    fixed by the request it sent, so the object is built through the
    inert constructor and then given those keys. Status is set to
    ACTIVE, which is what validate_proof does at RNS/Link.py:424#ACTIVE once
    the signature checks out, and what identify requires.
    """
    proof_data = session["proof"].data
    peer_ed25519 = session["identity"].get_public_key()[KEYHALF:]

    link = RNS.Link(owner=session["in_destination"])
    link.initiator     = True
    link.prv           = session["prv"]
    link.sig_prv       = session["sig_prv"]
    link.pub_bytes     = link.prv.public_key().public_bytes()
    link.sig_pub_bytes = link.sig_prv.public_key().public_bytes()
    link.set_link_id(session["request"])
    link.mtu           = session["link"].mtu
    link.mode          = session["link"].mode
    link.load_peer(proof_data[SIGLEN:SIGLEN+KEYHALF], peer_ed25519)
    link.handshake()
    link.status = RNS.Link.ACTIVE

    # The point of the handshake: two ends, no shared secret in any
    # packet, one key.
    assert link.derived_key == session["link"].derived_key
    return link


def gen_linkrequest(RNS, w, session):
    raw = session["request"].raw
    packet = session["request"]

    # The reference must agree with the decoder above about which link
    # this request opens, and about what it signalled.
    link_id = bytes.fromhex(
        lookup_field(describe_linkrequest(raw), "link_id"))
    assert link_id == RNS.Link.link_id_from_lr_packet(packet)
    assert RNS.Link.mtu_from_lr_packet(packet) == RNS.Reticulum.MTU
    assert RNS.Link.mode_from_lr_packet(packet) == RNS.Link.MODE_DEFAULT

    w.vector("linkrequest", "signalling",
        "link request as the reference emits it, mode and mtu signalled",
        [raw.hex()],
        describe_linkrequest(raw))

    # Without signalling is the shorter form validate_request still
    # accepts at RNS/Link.py:187#LINK_MTU_SIZE. It opens the same link:
    # the signalling bytes are excluded from the link id.
    unsignalled = raw[:-SIGNALLEN]
    w.vector("linkrequest", "no-signalling",
        "the 64-byte form; same link id, mode falls back to the default",
        [unsignalled.hex()],
        describe_linkrequest(unsignalled),
        source="constructed by tools/gen from linkrequest/signalling")

    short = raw[:-1]
    w.vector("linkrequest", "invalid-length",
        "66-byte payload, neither of the two accepted lengths",
        [short.hex()],
        describe_linkrequest(short),
        source="constructed by tools/gen from linkrequest/signalling")

    # The same request after a transport node rewrote it. The link id is
    # taken over the packet with the four high flag bits cleared, the hop
    # count removed and the transport id removed, so it must be the id
    # above. Until this vector, header 2 appeared once in the corpus, on
    # an announce, and announces derive no link id and no packet hash:
    # the branch that drops the transport id before hashing was in both
    # decoders and exercised by neither.
    transport_id = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0])).hash
    relayed = transport_insert(raw, 1, transport_id)
    assert lookup_field(describe_linkrequest(relayed), "link_id") == link_id.hex()

    w.vector("linkrequest", "in-transport",
        "header 2, one hop; the same link id as linkrequest/signalling",
        [relayed.hex()],
        describe_linkrequest(relayed),
        source="constructed by tools/gen from linkrequest/signalling, "
               "per RNS/Transport.py:1369#HEADER_2")


def describe_linkproof(request_raw, identity_public, raw, verify):
    """Three of the four parts that were signed are not in the packet. The
    link id comes from the request, the peer Ed25519 key from the
    identity of the destination the request was addressed to, and the
    signalling bytes are signed in the position they occupy here.
    """
    # The two input blobs are echoed so that expect holds every byte of
    # raw. Without them the vector could be decoded but not rebuilt.
    echo = [
        field("link_request",  request_raw.hex()),
        field("signer_public", identity_public.hex()),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) not in (SIGLEN + KEYHALF, SIGLEN + KEYHALF + SIGNALLEN):
        return echo + invalid("invalid-length",
                              ("payload_length", len(payload)),
                              ("accepted_length", SIGLEN + KEYHALF),
                              ("signalled_length", SIGLEN + KEYHALF + SIGNALLEN))

    _, rh = describe_header(request_raw)
    link_id = hashlib.sha256(
        hashable_part(request_raw, len(rh["payload"]))).digest()[:ADDRLEN]

    signalled  = len(payload) == SIGLEN + KEYHALF + SIGNALLEN
    signature  = payload[:SIGLEN]
    x25519     = payload[SIGLEN:SIGLEN+KEYHALF]
    signalling = payload[SIGLEN+KEYHALF:]

    signer_ed25519 = identity_public[KEYHALF:]
    signed_data    = link_id + x25519 + signer_ed25519 + signalling

    return lines + [
        field("link_id",         link_id.hex()),
        field("link_id_match",   "yes" if h["dest_hash"] == link_id else "no"),
        field("signature",       signature.hex()),
        field("x25519_public",   x25519.hex()),
    ] + describe_signalling(signalling if signalled else None) + [
        field("signer_ed25519",  signer_ed25519.hex()),
        field("signed_data",     signed_data.hex()),
        field("signature_valid", "yes" if verify(signer_ed25519, signature, signed_data) else "no"),
    ]


def gen_linkproof(RNS, w, verify, session):
    identity, request = session["identity"], session["request"]
    link, proof = session["link"], session["proof"]

    public  = identity.get_public_key()
    request_raw, raw = request.raw, proof.raw
    blobs = [request_raw.hex(), public.hex()]

    # The reference must accept its own proof. validate_proof drives a
    # link state machine, so the two facts it turns on are asserted
    # instead: the address field is the link id, and the signature is
    # over the four parts assembled below.
    assert proof.raw[2:2+ADDRLEN] == link.link_id
    assert lookup_field(describe_linkproof(request_raw, public, raw, verify),
                        "signature_valid") == "yes"

    w.vector("linkproof", "signalling",
        "link request proof as the reference emits it, mtu confirmed",
        blobs + [raw.hex()],
        describe_linkproof(request_raw, public, raw, verify))

    # The 96-byte form validate_proof also accepts, at
    # RNS/Link.py:405#initiator.
    # The reference never emits it: prove always signals. Removing the
    # bytes removes them from the signed material too, so the signature
    # no longer verifies, which is the point of the vector.
    removed = raw[:-SIGNALLEN]
    w.vector("linkproof", "signalling-removed",
        "signalling bytes removed; the proof still decodes and the signature does not verify",
        blobs + [removed.hex()],
        describe_linkproof(request_raw, public, removed, verify),
        source="constructed by tools/gen from linkproof/signalling")

    altered = raw[:19] + bytes([raw[19] ^ 0x01]) + raw[20:]
    w.vector("linkproof", "altered-signature",
        "first signature byte altered",
        blobs + [altered.hex()],
        describe_linkproof(request_raw, public, altered, verify),
        source="constructed by tools/gen from linkproof/signalling")


def describe_linkdata(request_raw, responder_private, raw, verify):
    """Unlike a packet to a destination, this one carries no ephemeral
    key: both ends already hold the shared secret. The salt of the
    derivation is the link id, which is in no packet either.
    """
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey, X25519PublicKey

    # The two input blobs are echoed so that expect holds every byte of
    # raw. Without them the vector could be decoded but not rebuilt.
    echo = [
        field("link_request",      request_raw.hex()),
        field("responder_private", responder_private.hex()),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    _, rh = describe_header(request_raw)
    link_id = hashlib.sha256(
        hashable_part(request_raw, len(rh["payload"]))).digest()[:ADDRLEN]

    lines += [
        field("link_id",       link_id.hex()),
        field("link_id_match", "yes" if h["dest_hash"] == link_id else "no"),
    ]

    # Keepalives carry no data and are the one link packet the
    # reference does not encrypt. RNS/Packet.py:206#KEEPALIVE.
    if h["context"] == 0xfa:
        return lines + [
            field("encrypted",        "no"),
            field("plaintext_length", "%d" % len(payload)),
            field("plaintext",        payload.hex() if payload else "-"),
        ]

    lines.append(field("encrypted", "yes"))

    if len(payload) < TOKEN_OVERHEAD:
        return lines + invalid("short-payload",
                               ("payload_length", len(payload)),
                               ("minimum_length", TOKEN_OVERHEAD))

    initiator_public = rh["payload"][:KEYHALF]
    shared = X25519PrivateKey.from_private_bytes(responder_private).exchange(
        X25519PublicKey.from_public_bytes(initiator_public))
    derived = hkdf_sha256(64, shared, link_id)

    t = token_open(payload, derived)
    plaintext = t["plaintext"]

    lines += token_parts(t) + [
        field("shared_key",     shared.hex()),
        field("signing_key",    derived[:32].hex()),
        field("encryption_key", derived[32:].hex()),
    ] + token_plaintext(t)

    # A channel envelope is six bytes of big-endian header and then the
    # message. The length it declares is not read back: Envelope.unpack
    # takes everything after the six bytes. RNS/Channel.py:118#unpack.
    if h["context"] == 0x0e and plaintext is not None and len(plaintext) >= ENVELOPELEN:
        lines += [
            field("msgtype",        plaintext[:2].hex()),
            field("sequence",       "%d" % int.from_bytes(plaintext[2:4], "big")),
            field("declared_length", "%d" % int.from_bytes(plaintext[4:6], "big")),
            field("message",        hexf(plaintext[ENVELOPELEN:])),
        ]

    # An identify proof names the initiator, which nothing else on a
    # link does. Its signature covers the link id, so it cannot be
    # replayed onto another link. RNS/Link.py:464#signed_data.
    if h["context"] == 0xfb and plaintext is not None and len(plaintext) == KEYSIZE + SIGLEN:
        identity_public = plaintext[:KEYSIZE]
        signature       = plaintext[KEYSIZE:]
        signed_data     = link_id + identity_public
        lines += [
            field("identity_public",    identity_public.hex()),
            field("identity_hash",      hashlib.sha256(identity_public).digest()[:ADDRLEN].hex()),
            field("identity_signed",    signed_data.hex()),
            field("identity_valid",     "yes" if verify(identity_public[KEYHALF:], signature, signed_data) else "no"),
        ]

    return lines


def gen_linkdata(RNS, w, verify, session):
    from RNS.vendor import umsgpack
    from RNS.Buffer import StreamDataMessage
    from RNS.Channel import Envelope, LinkChannelOutlet

    request_raw = session["request"].raw
    responder_private = session["link"].prv.private_bytes()

    # A second identity, so that the one identifying over the link is
    # plainly not the one the link was established to.
    initiator_identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[1][0]))

    # The measured round trip time is zero under a pinned clock, which
    # would record the msgpack layout of a value no link ever reports.
    rtt = 0.0625

    # Channel.send is the sequence counter, a retry ring and a watchdog
    # around the two lines that make bytes,
    # RNS/Channel.py:507#reserved_sequence. Those
    # two are run here for the same reason link_session runs four lines
    # of Link.__init__: the rest reaches for an instance and produces
    # nothing. The envelope and the packet are still the reference's.
    messages = [
        StreamDataMessage(stream_id=1, data=b"reticulum"),
        StreamDataMessage(stream_id=1, data=b"", eof=True),
    ]

    with pinned(RNS, "linkdata"):
        link   = initiator_link(RNS, session)
        outlet = LinkChannelOutlet(link)
        with captured(RNS) as sent:
            RNS.Packet(link, b"reticulum").send()
            link.identify(initiator_identity)
            RNS.Packet(link, umsgpack.packb(rtt), context=RNS.Packet.LRRTT).send()
            RNS.Packet(link, link.link_id, context=RNS.Packet.LINKCLOSE).send()
            link.send_keepalive()
            for sequence, message in enumerate(messages):
                envelope = Envelope(outlet, message=message, sequence=sequence)
                outlet.send(envelope.pack())

                # The reference must read back what it just wrote.
                read = Envelope(outlet, raw=envelope.raw)
                assert read.unpack({StreamDataMessage.MSGTYPE: StreamDataMessage}) \
                    .pack() == message.pack()
                assert read.sequence == sequence

    cases = [
        ("minimal",   sent[0], "nine bytes of plaintext over the link"),
        ("identify",  sent[1], "the initiator names itself, signing over the link id"),
        ("rtt",       sent[2], "round trip time, msgpack encoded, sent by the initiator"),
        ("close",     sent[3], "teardown; the plaintext is the link id"),
        ("keepalive", sent[4], "one byte, and the one link packet that is not encrypted"),
        ("channel",   sent[5], "a channel message, sequence 0, inside the six-byte envelope"),
        ("channel-eof", sent[6],
         "sequence 1, and a message that is its own two-byte header and nothing else"),
    ]

    for name, packet, purpose in cases:
        blobs = [request_raw.hex(), responder_private.hex(), packet.raw.hex()]
        described = describe_linkdata(request_raw, responder_private, packet.raw, verify)
        w.vector("linkdata", name, purpose, blobs, described)

    base = sent[0].raw
    altered = base[:-1] + bytes([base[-1] ^ 0x01])
    w.vector("linkdata", "altered-hmac",
        "last byte of the token hmac altered; nothing is decrypted",
        [request_raw.hex(), responder_private.hex(), altered.hex()],
        describe_linkdata(request_raw, responder_private, altered, verify),
        source="constructed by tools/gen from linkdata/minimal")


def lookup_field(lines, name):
    for line in lines:
        if line.startswith(name + " "):
            return line.split(None, 1)[1]
    raise KeyError(name)


def hkdf_sha256(length, ikm, salt, context=b""):
    """RFC 5869, which is what RNS/Cryptography/HKDF.py:35#hkdf implements."""
    import hmac as _hmac

    def mac(key, data):
        return _hmac.new(key, data, hashlib.sha256).digest()

    prk = mac(salt if salt else bytes(32), ikm)
    block, derived = b"", b""
    for i in range((length + 31) // 32):
        block = mac(prk, block + context + bytes([(i + 1) % 256]))
        derived += block
    return derived[:length]


def check_hkdf(RNS):
    """The one function above that RNS also offers.

    expect is asserted against RNS wherever RNS exposes something to
    assert against, and here it does. Two lengths, because the second
    block is where an implementation of RFC 5869 goes wrong.
    """
    for length in (32, 64):
        assert hkdf_sha256(length, b"ikm", b"salt") == \
            RNS.Cryptography.hkdf(length=length, derive_from=b"ikm",
                                  salt=b"salt", context=None)


def token_open(payload, key):
    """iv || ciphertext || hmac, opened with a 64-byte key.

    A packet to a destination, a packet to a group and a packet on a
    link differ only in where the key came from, which is the whole of
    what the three kinds do not share. cmd/dump has the same function.

    A key of None means no key agreement was possible: the token is
    still laid out, because its three parts are in the packet, but no
    verdict about it can be reached.

        RNS/Cryptography/Token.py:100#decrypt
    """
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    import hmac as _hmac

    t = {"iv": payload[:16], "ciphertext": payload[16:-32], "mac": payload[-32:],
         "mac_ok": None, "plaintext": None}
    if key is None:
        return t

    signing_key, encryption_key = key[:32], key[32:]
    t["mac_ok"] = _hmac.compare_digest(
        t["mac"], _hmac.new(signing_key, t["iv"] + t["ciphertext"],
                            hashlib.sha256).digest())

    if t["mac_ok"] and len(t["ciphertext"]) > 0 and len(t["ciphertext"]) % 16 == 0:
        dec = Cipher(algorithms.AES(encryption_key), modes.CBC(t["iv"])).decryptor()
        padded = dec.update(t["ciphertext"]) + dec.finalize()
        n = padded[-1]
        if 0 < n <= 16 and n <= len(padded):
            t["plaintext"] = padded[:len(padded) - n]

    return t


def token_parts(t):
    return [
        field("iv",         t["iv"].hex()),
        field("ciphertext", t["ciphertext"].hex()),
        field("hmac",       t["mac"].hex()),
    ]


def token_plaintext(t):
    plaintext = t["plaintext"]
    return [
        field("hmac_valid",       "-" if t["mac_ok"] is None
                                  else ("yes" if t["mac_ok"] else "no")),
        field("plaintext_length", "-" if plaintext is None else "%d" % len(plaintext)),
        field("plaintext",        plaintext.hex() if plaintext else "-"),
    ]


def describe_encrypted(raw, private, ratchet_private):
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey, X25519PublicKey

    # The two input blobs are echoed so that expect holds every byte of
    # raw. Without them the vector could be decoded but not rebuilt.
    echo = [
        field("recipient_private", private.hex()),
        field("ratchet_private",
              ratchet_private.hex() if ratchet_private is not None else "-"),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) < KEYHALF + TOKEN_OVERHEAD:
        return echo + invalid("short-payload",
                              ("payload_length", len(payload)),
                              ("minimum_length", KEYHALF + TOKEN_OVERHEAD))

    ephemeral     = payload[:KEYHALF]
    public_key    = private_to_public(private)
    identity_hash = hashlib.sha256(public_key).digest()[:ADDRLEN]

    # The salt is always the recipient's identity hash, including when
    # the shared secret came from a ratchet. RNS/Identity.py:841#get_salt.
    if ratchet_private is not None:
        agree_with = ratchet_private
        ratchet_public = X25519PrivateKey.from_private_bytes(ratchet_private) \
            .public_key().public_bytes_raw()
    else:
        agree_with = private[:KEYHALF]
        ratchet_public = None

    # X25519 against a point of small order yields an all-zero secret,
    # which the pinned backend raises on rather than returning. Nothing
    # about the token can then be decided, and its three parts are still
    # in the packet. The internal fallback returns the zero secret and
    # carries on; see doc/encryption.
    try:
        shared = X25519PrivateKey.from_private_bytes(agree_with).exchange(
            X25519PublicKey.from_public_bytes(ephemeral))
    except ValueError:
        shared = None

    derived = hkdf_sha256(64, shared, identity_hash) if shared is not None else None
    t = token_open(payload[KEYHALF:], derived)

    return lines + [
        field("ephemeral_public", ephemeral.hex()),
    ] + token_parts(t) + [
        field("identity_hash",   identity_hash.hex()),
        field("ratchet_public",  ratchet_public.hex() if ratchet_public else "-"),
        field("shared_key",      "-" if shared is None else shared.hex()),
        field("signing_key",     "-" if derived is None else derived[:32].hex()),
        field("encryption_key",  "-" if derived is None else derived[32:].hex()),
    ] + token_plaintext(t)


def describe_group(raw, group_key):
    """A third payload shape, and the one with no key agreement in it.

    The group key is the token key: no ephemeral key is sent, no HKDF
    runs, and the two halves are the key as it was configured. An
    implementation that derives here decrypts nothing, and one that
    does not derive for test/encrypted decrypts nothing there.
    """
    echo = [field("group_key", group_key.hex())]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) < TOKEN_OVERHEAD:
        return echo + invalid("short-payload",
                              ("payload_length", len(payload)),
                              ("minimum_length", TOKEN_OVERHEAD))

    t = token_open(payload, group_key)

    return lines + token_parts(t) + [
        field("signing_key",    group_key[:32].hex()),
        field("encryption_key", group_key[32:].hex()),
    ] + token_plaintext(t)


def gen_group(RNS, w):
    """Destination type 1, the one with a key nobody negotiates.

    An outbound group destination still needs an identity, because its
    hash is derived exactly as a single destination's is. The identity
    then plays no part in the encryption: the payload is a bare token
    under the shared symmetric key, with no ephemeral key in front of
    it and no derivation behind it.

        RNS/Destination.py:612#GROUP
    """
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[1][0]))
    plaintext = b"reticulum"

    with pinned(RNS, "group"):
        destination = RNS.Destination(identity, RNS.Destination.OUT,
                                      RNS.Destination.GROUP,
                                      "rns_unit_tests", "group")
        destination.create_keys()
        group_key = destination.get_private_key()

        packet = RNS.Packet(destination, plaintext)
        packet.pack()

    # The reference must recover what it encrypted, and the key must be
    # the token key rather than something derived from it.
    assert destination.decrypt(packet.ciphertext) == plaintext
    assert len(group_key) == KEYSIZE
    assert packet.raw[19:] == packet.ciphertext

    w.vector("group", "minimal",
        "nine bytes under a group key, no ephemeral key and no derivation",
        [group_key.hex(), packet.raw.hex()],
        describe_group(packet.raw, group_key))

    altered = packet.raw[:-1] + bytes([packet.raw[-1] ^ 0x01])
    w.vector("group", "altered-hmac",
        "last byte of the token hmac altered; nothing is decrypted",
        [group_key.hex(), altered.hex()],
        describe_group(altered, group_key),
        source="constructed by tools/gen from group/minimal")


def private_to_public(private):
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    x = X25519PrivateKey.from_private_bytes(private[:KEYHALF]).public_key().public_bytes_raw()
    e = Ed25519PrivateKey.from_private_bytes(private[KEYHALF:]).public_key().public_bytes_raw()
    return x + e


def encrypted_raw(RNS, key_index, aspects, plaintext, use_ratchet, tag):
    private   = bytes.fromhex(UPSTREAM_KEYS[key_index][0])
    recipient = RNS.Identity.from_bytes(private)

    # An outbound destination holds only the public key, as a sender does.
    public_only = RNS.Identity(create_keys=False)
    public_only.load_public_key(recipient.get_public_key())

    ratchet_private = None
    with pinned(RNS, tag):
        destination = RNS.Destination(public_only, RNS.Destination.OUT,
                                      RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        RNS.Identity.known_ratchets.pop(destination.hash, None)
        if use_ratchet:
            ratchet_private = RNS.Identity._generate_ratchet()
            RNS.Identity.known_ratchets[destination.hash] = \
                RNS.Identity._ratchet_public_bytes(ratchet_private)

        packet = RNS.Packet(destination, plaintext)
        packet.pack()

    # The reference implementation must recover what it encrypted.
    ratchets = [ratchet_private] if ratchet_private else None
    assert recipient.decrypt(packet.ciphertext, ratchets=ratchets) == plaintext

    return private, ratchet_private, packet.raw


def gen_encrypted(RNS, w):
    made = {}
    for name, key_index, aspects, plaintext, use_ratchet, purpose in ENCRYPTED:
        private, ratchet, raw = encrypted_raw(RNS, key_index, aspects, plaintext,
                                              use_ratchet, "encrypted-" + name)
        made[name] = (private, ratchet, raw)
        w.vector("encrypted", name, purpose,
            [private.hex(), ratchet.hex() if ratchet else "-", raw.hex()],
            describe_encrypted(raw, private, ratchet))

    private, ratchet, raw = made["minimal"]
    altered = raw[:-1] + bytes([raw[-1] ^ 0x01])
    w.vector("encrypted", "altered-hmac",
        "last byte of the token hmac altered; nothing is decrypted",
        [private.hex(), "-", altered.hex()],
        describe_encrypted(altered, private, None),
        source="constructed by tools/gen from encrypted/minimal")

    # The ephemeral key replaced with the all-zero point, which has
    # order 1. The header is 19 bytes and the key is the first 32 of the
    # payload. The pinned backend will not produce a secret from it at
    # all; the internal fallback produces the one every reader of the
    # announce can compute for themselves.
    low_order = raw[:19] + bytes(KEYHALF) + raw[19+KEYHALF:]
    assert len(low_order) == len(raw)

    from RNS.Cryptography.X25519 import X25519PrivateKey as InternalX25519
    assert InternalX25519.from_private_bytes(private[:KEYHALF]) \
        .exchange(bytes(KEYHALF)) == bytes(KEYHALF)

    w.vector("encrypted", "low-order-ephemeral",
        "ephemeral key replaced with a point of small order; no shared secret exists",
        [private.hex(), "-", low_order.hex()],
        describe_encrypted(low_order, private, None),
        source="constructed by tools/gen from encrypted/minimal")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--checkout", default=CHECKOUT)
    ap.add_argument("--force", action="store_true")
    args = ap.parse_args()

    RNS    = load_rns(args.checkout)
    check_hkdf(RNS)
    w      = Writer(ROOT, args.force)
    verify = make_verifier(RNS)

    tmpdir = tempfile.mkdtemp(prefix="reticulum-vectors-")
    stub_transport(RNS, tmpdir)
    try:
        gen_identity(RNS, w)
        gen_keyset(RNS, w)
        gen_destination(RNS, w)
        gen_signature(RNS, w, verify)
        gen_sign(RNS, w)
        announce_minimal = gen_announce(RNS, w, tmpdir, verify)
        gen_plain(RNS, w)
        gen_pathrequest(RNS, w)
        gen_proof(RNS, w, verify)
        gen_ifac(RNS, w, announce_minimal)
        gen_encrypted(RNS, w)
        gen_group(RNS, w)

        session = link_session(RNS, "link")
        gen_linkrequest(RNS, w, session)
        gen_linkproof(RNS, w, verify, session)
        gen_linkdata(RNS, w, verify, session)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

    w.index()

    counted = [("%d identical" % w.identical)]
    if w.changed: counted.append("%d changed" % w.changed)
    if w.created: counted.append("%d new" % w.created)
    print(", ".join(counted))

    if w.differs:
        print("%d files differ and were left alone:" % len(w.differs))
        for path in w.differs:
            print("    %s" % os.path.relpath(path, ROOT))
        print("run with --force to replace them, after examining why they changed")
        sys.exit(1)


if __name__ == "__main__":
    main()

# The timestamp pinned into random_hash while generating. Any fixed
# value inside the five-byte field will do; this one is a round number
# well clear of both ends.
PINNED_TIME = 1750000000


class DetRandom:
    """A deterministic byte stream, so that regenerating a vector
    produces the same bytes. Consumers never see it, and the encode
    class does not rest on it: expect records what these bytes came out
    as, which is what raw is rebuilt from."""

    def __init__(self, tag):
        self.seed    = tag.encode("utf-8")
        self.counter = 0
        self.buf     = b""

    def bytes(self, n):
        while len(self.buf) < n:
            self.buf += hashlib.sha256(self.seed + self.counter.to_bytes(4, "big")).digest()
            self.counter += 1
        out, self.buf = self.buf[:n], self.buf[n:]
        return out


def pinned_keyclass(real, rng):
    return type("Pinned", (), {
        "generate": staticmethod(lambda: real.from_private_bytes(rng.bytes(32))),
        "from_private_bytes": staticmethod(real.from_private_bytes),
    })


@contextlib.contextmanager
def pinned(RNS, tag):
    """Replace the clock and the two randomness sources an announce
    reaches for, so that regenerating produces identical bytes.

    Both are patched on RNS rather than on os.urandom. Patching
    os.urandom is not enough: under the openssl backend
    _generate_ratchet reaches X25519PrivateKey.generate in PyCA
    (RNS/Cryptography/Proxies.py:43), which draws from OpenSSL's own
    generator and never touches os.urandom.
    """
    rng = DetRandom(tag)

    real_time    = time.time
    real_urandom = os.urandom
    real_rand    = RNS.Identity.get_random_hash
    real_ratchet = RNS.Identity._generate_ratchet
    identity_mod = sys.modules["RNS.Identity"]
    link_mod     = sys.modules["RNS.Link"]
    real_x25519  = identity_mod.X25519PrivateKey
    real_lx25519 = link_mod.X25519PrivateKey
    real_led     = link_mod.Ed25519PrivateKey

    time.time  = lambda: float(PINNED_TIME)
    os.urandom = rng.bytes
    RNS.Identity.get_random_hash   = staticmethod(lambda: rng.bytes(16))
    RNS.Identity._generate_ratchet = staticmethod(lambda: rng.bytes(32))

    # Identity.encrypt resolves X25519PrivateKey as a global of the
    # RNS.Identity module, so the shim is installed on the module
    # rather than on the class of the same name.
    # os.urandom is pinned as well because Token.encrypt takes its
    # initialisation vector from it directly.
    identity_mod.X25519PrivateKey = pinned_keyclass(real_x25519, rng)

    # RNS.Link imports both key classes for itself (RNS/Link.py:31) and
    # draws a fresh pair for every link end (RNS/Link.py:276, :284), so
    # the same shim is installed there.
    link_mod.X25519PrivateKey  = pinned_keyclass(real_lx25519, rng)
    link_mod.Ed25519PrivateKey = pinned_keyclass(real_led, rng)
    try:
        yield
    finally:
        time.time  = real_time
        os.urandom = real_urandom
        RNS.Identity.get_random_hash   = real_rand
        RNS.Identity._generate_ratchet = real_ratchet
        identity_mod.X25519PrivateKey  = real_x25519
        link_mod.X25519PrivateKey      = real_lx25519
        link_mod.Ed25519PrivateKey     = real_led


class TransportStub:
    """Destination registration and ratchet persistence reach into a
    running Reticulum instance. Neither affects the bytes on the wire,
    so both are stubbed rather than starting an instance."""
    is_connected_to_shared_instance = False


def stub_transport(RNS, tmpdir):
    RNS.Transport.owner = TransportStub()
    RNS.Transport.register_destination = staticmethod(lambda d: None)
    RNS.Identity._remember_ratchet = staticmethod(lambda h, r: None)
    # Identity.get_ratchet falls back to the storage path when a
    # destination has no remembered ratchet. Pointing it at an empty
    # directory keeps that lookup from reaching a real instance.
    RNS.Reticulum.storagepath = tmpdir


def load_rns(checkout):
    if not os.path.isdir(os.path.join(checkout, "RNS")):
        sys.exit("no RNS package under %s" % checkout)

    sys.path.insert(0, checkout)
    import RNS

    if not os.path.abspath(RNS.__file__).startswith(os.path.abspath(checkout)):
        sys.exit("imported RNS from %s, not from the checkout" % RNS.__file__)

    if RNS.__version__ != PIN_VERSION:
        sys.exit("checkout is version %s, pin is %s" % (RNS.__version__, PIN_VERSION))

    commit = subprocess.run(["git", "-C", checkout, "rev-parse", "HEAD"],
                            capture_output=True, text=True).stdout.strip()
    if commit != PIN_COMMIT:
        sys.exit("checkout is at %s, pin is %s" % (commit, PIN_COMMIT))

    return RNS


def line(name, value):
    # A name wider than the column shifts the value out of alignment.
    # Two decoders that pad the same way would still compare equal, so
    # nothing downstream can catch it.
    if len(name) > FIELD_WIDTH:
        raise ValueError("field name %r is wider than the %d-column format"
                         % (name, FIELD_WIDTH))
    return "%-*s %s" % (FIELD_WIDTH, name, value)


def field(name, value):
    # An expect value is one word, so that splitting on the first space
    # is exact. meta is prose and uses line() directly.
    if " " in str(value):
        raise ValueError("field %s has a space in its value: %r" % (name, value))
    return line(name, value)


# The kinds cmd/dump can rebuild raw for. signature is not among them:
# its raw carries a 950-byte message that expect records only by its
# digest, so the vector can be decoded and not rebuilt.
ENCODABLE = ("identity", "keyset", "destination", "announce", "encrypted",
             "linkrequest", "linkproof", "linkdata")


def determinism(kind, expect):
    """encode when expect holds every byte of raw.

    That is so exactly when the kind has an encoder and the object
    decoded: a vector that names a broken rule carries the rule and the
    numbers behind it, and nothing to rebuild from. Deriving the class
    here rather than declaring it per vector keeps the claim from being
    wrong; cmd/check then tests it.
    """
    if kind not in ENCODABLE:
        return "decode"
    if any(l.startswith("invalid") for l in expect):
        return "decode"
    return "encode"


class Writer:
    def __init__(self, root, force):
        self.root    = root
        self.force   = force
        self.written = 0
        self.differs = []
        self.names   = []

    def vector(self, kind, name, purpose, raw, expect, source=GENERATED_SOURCE):
        meta = [
            line("source", source),
            line("determinism", determinism(kind, expect)),
            line("purpose", purpose),
        ]

        path = os.path.join(self.root, "test", kind, name)
        os.makedirs(path, exist_ok=True)

        self.file(os.path.join(path, "meta"), meta)
        self.file(os.path.join(path, "raw"), raw)
        self.file(os.path.join(path, "expect"), expect)
        self.names.append(kind + "/" + name)

    # test/INDEX is what makes a count an assertion. cmd/check refuses to
    # run against a test/ that does not hold exactly these vectors, so a
    # copy with some of them removed reports nothing rather than passing
    # the ones it kept.
    def index(self):
        self.file(os.path.join(self.root, "test", "INDEX"),
                  sorted(self.names))

    @staticmethod
    def body(lines):
        return "\n".join(lines) + "\n"

    def file(self, path, lines):
        body = self.body(lines)
        if os.path.exists(path) and not self.force:
            with open(path) as f:
                if f.read() != body:
                    self.differs.append(path)
                    return
        with open(path, "w") as f:
            f.write(body)
        self.written += 1


def make_verifier(RNS):
    """Ed25519 verification, as the reference implementation performs it.

    dump verifies with tweetnacl, so the two sides remain independent
    at the level that matters: two separate curve implementations must
    agree on the same signature over the same assembled message.
    """
    from RNS.Cryptography import Ed25519PublicKey

    def verify(ed25519_public, signature, message):
        try:
            Ed25519PublicKey.from_public_bytes(ed25519_public).verify(signature, message)
            return True
        except Exception:
            return False

    return verify


def gen_identity(RNS, w):
    """Public key to identity hash.

    raw is the public key, not the private key. Deriving one from the
    other is X25519 and Ed25519, standard primitives with their own
    published vectors; the keyset vectors cover that separately.
    """
    for n, (private_hex, hash_hex) in enumerate(UPSTREAM_KEYS):
        identity = RNS.Identity.from_bytes(bytes.fromhex(private_hex))
        public   = identity.get_public_key()
        half     = RNS.Identity.KEYSIZE // 8 // 2

        # The upstream table is the source of truth for these two values.
        # Everything else is derived here and must agree with it.
        assert identity.get_private_key() == bytes.fromhex(private_hex)
        assert identity.hash == bytes.fromhex(hash_hex)

        w.vector("identity", "upstream-%d" % n,
            "public key of upstream key %d" % n,
            [public.hex()],
            [
                field("public_key",     public.hex()),
                field("x25519_public",  public[:half].hex()),
                field("ed25519_public", public[half:].hex()),
                field("identity_hash",  identity.hash.hex()),
            ],
            source=UPSTREAM_KEY_SOURCE)


def gen_keyset(RNS, w):
    """The private-to-public derivation the identity vectors omit."""
    cases  = [("upstream-%d" % n, k, "upstream key %d" % n)
              for n, (k, _) in enumerate(UPSTREAM_KEYS)]
    cases += CLAMP_KEYS

    made = {}
    for name, private_hex, purpose in cases:
        identity = RNS.Identity.from_bytes(bytes.fromhex(private_hex))
        private  = identity.get_private_key()
        public   = identity.get_public_key()
        half     = RNS.Identity.KEYSIZE // 8 // 2
        made[name] = identity

        source = UPSTREAM_KEY_SOURCE if name.startswith("upstream-") else GENERATED_SOURCE

        w.vector("keyset", name, purpose,
            [private.hex()],
            [
                field("private_key",     private.hex()),
                field("x25519_private",  private[:half].hex()),
                field("ed25519_private", private[half:].hex()),
                field("public_key",      public.hex()),
                field("x25519_public",   public[:half].hex()),
                field("ed25519_public",  public[half:].hex()),
                field("identity_hash",   identity.hash.hex()),
            ],
            source=source)

    # The property the clamping pair exists to record.
    assert made["unclamped"].get_private_key() != made["clamped"].get_private_key()
    assert made["unclamped"].get_public_key()  == made["clamped"].get_public_key()
    assert made["unclamped"].hash              == made["clamped"].hash


def gen_destination(RNS, w):
    for name, aspects, key_index, purpose in DESTINATIONS:
        app_name = aspects[0]
        rest     = aspects[1:]

        full       = RNS.Destination.expand_name(None, app_name, *rest)
        name_bytes = full.encode("utf-8")
        name_hash  = RNS.Identity.full_hash(name_bytes)[:RNS.Identity.NAME_HASH_LENGTH // 8]

        if key_index is None:
            identity      = None
            identity_hash = None
        else:
            identity      = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))
            identity_hash = identity.hash

        destination_hash = RNS.Destination.hash(identity, app_name, *rest)

        # Every byte string in the format is hex, names included. A name
        # is arbitrary bytes; printing it as text would let a newline in
        # an aspect forge or hide a field.
        expect = [field("name", name_bytes.hex()),
                  field("app_name", app_name.encode("utf-8").hex())]
        for aspect in rest:
            expect.append(field("aspect", aspect.encode("utf-8").hex()))
        expect.append(field("name_hash", name_hash.hex()))
        expect.append(field("identity_hash", identity_hash.hex() if identity_hash else "-"))
        expect.append(field("destination_hash", destination_hash.hex()))

        w.vector("destination", name, purpose,
            [name_bytes.hex(), identity_hash.hex() if identity_hash else "-"],
            expect)


def gen_signature(RNS, w, verify):
    """One adopted signature and one negative counterpart.

    Ed25519 itself has published vectors and is not restated here. What
    this pins is that Identity.sign is plain Ed25519 over the message,
    with no prefix, domain separator or prior hashing.

    Decode class: expect records the message by length and digest, not
    by content, so raw cannot be rebuilt from it.
    """
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[0][0]))
    public   = identity.get_public_key()
    message  = UPSTREAM_SIGNED_MESSAGE.encode("utf-8")
    good     = bytes.fromhex(UPSTREAM_SIGNATURE)

    # The reference implementation must reproduce the adopted value.
    assert identity.sign(message) == good

    bad = bytearray(good)
    bad[0] ^= 0x01
    bad = bytes(bad)

    cases = [
        ("upstream", good, "adopted signature over the upstream message", UPSTREAM_SIG_SOURCE),
        ("altered", bad, "the same signature with the first byte altered",
         "constructed by tools/gen from signature/upstream"),
    ]

    for name, signature, purpose, source in cases:
        w.vector("signature", name, purpose,
            [public.hex(), message.hex(), signature.hex()],
            [
                field("ed25519_public", public[32:].hex()),
                field("message_length", "%d" % len(message)),
                field("message_sha256", hashlib.sha256(message).hexdigest()),
                field("signature",      signature.hex()),
                field("valid",          "yes" if verify(public[32:], signature, message) else "no"),
            ],
            source=source)


def gen_sign(RNS, w):
    """The other direction of the same adopted value.

    tests/identity.py:31 asserts what Identity.sign produces, not what
    it verifies. test/signature records the value and asks only that a
    signature check succeed; here the signature is not given, it is
    produced from the private key and the message.

    Ed25519 signing is deterministic, RFC 8032 section 5.1.6, so this
    is a fact a vector can state. An implementation that draws a random
    nonce, or signs with the wrong half of the Reticulum private key,
    passes every other vector in the corpus and emits announces and
    link proofs that nothing accepts.

    Decode class, for the same reason as test/signature: expect records
    the message by length and digest, not by content.
    """
    private = bytes.fromhex(UPSTREAM_KEYS[0][0])
    message = UPSTREAM_SIGNED_MESSAGE.encode("utf-8")

    identity  = RNS.Identity.from_bytes(private)
    signature = identity.sign(message)
    assert signature == bytes.fromhex(UPSTREAM_SIGNATURE)

    w.vector("sign", "upstream",
        "private key and message to the signature upstream asserts",
        [private.hex(), message.hex()],
        [
            field("private_key",     private.hex()),
            field("ed25519_private", private[32:].hex()),
            field("ed25519_public",  identity.get_public_key()[32:].hex()),
            field("message_length",  "%d" % len(message)),
            field("message_sha256",  hashlib.sha256(message).hexdigest()),
            field("signature",       signature.hex()),
        ],
        source="python-rns %s tests/identity.py:31 (%s)" % (PIN_VERSION, PIN_COMMIT[:8]))



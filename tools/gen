    published vectors; the keyset vectors cover that separately.
    """
    for n, (private_hex, hash_hex) in enumerate(UPSTREAM_KEYS):
        identity = RNS.Identity.from_bytes(bytes.fromhex(private_hex))
        public   = identity.get_public_key()
        half     = RNS.Identity.KEYSIZE // 8 // 2

        # The upstream table is the source of truth for these two values.
        # Everything else is derived here and must agree with it.
        assert identity.get_private_key() == bytes.fromhex(private_hex)
        assert identity.hash == bytes.fromhex(hash_hex)

        w.vector("identity", "upstream-%d" % n,
            "public key of upstream key %d" % n,
            [public.hex()],
            [
                field("public_key",     public.hex()),
                field("x25519_public",  public[:half].hex()),
                field("ed25519_public", public[half:].hex()),
                field("identity_hash",  identity.hash.hex()),
            ],
            source=UPSTREAM_KEY_SOURCE)


def gen_keyset(RNS, w):
    """The private-to-public derivation the identity vectors omit."""
    cases  = [("upstream-%d" % n, k, "upstream key %d" % n)
              for n, (k, _) in enumerate(UPSTREAM_KEYS)]
    cases += CLAMP_KEYS

    made = {}
    for name, private_hex, purpose in cases:
        identity = RNS.Identity.from_bytes(bytes.fromhex(private_hex))
        private  = identity.get_private_key()
        public   = identity.get_public_key()
        half     = RNS.Identity.KEYSIZE // 8 // 2
        made[name] = identity

        source = UPSTREAM_KEY_SOURCE if name.startswith("upstream-") else GENERATED_SOURCE

        w.vector("keyset", name, purpose,
            [private.hex()],
            [
                field("private_key",     private.hex()),
                field("x25519_private",  private[:half].hex()),
                field("ed25519_private", private[half:].hex()),
                field("public_key",      public.hex()),
                field("x25519_public",   public[:half].hex()),
                field("ed25519_public",  public[half:].hex()),
                field("identity_hash",   identity.hash.hex()),
            ],
            source=source)

    # The property the clamping pair exists to record.
    assert made["unclamped"].get_private_key() != made["clamped"].get_private_key()
    assert made["unclamped"].get_public_key()  == made["clamped"].get_public_key()
    assert made["unclamped"].hash              == made["clamped"].hash


def gen_destination(RNS, w):
    for name, aspects, key_index, purpose in DESTINATIONS:
        app_name = aspects[0]
        rest     = aspects[1:]

        full       = RNS.Destination.expand_name(None, app_name, *rest)
        name_bytes = full.encode("utf-8")
        name_hash  = RNS.Identity.full_hash(name_bytes)[:RNS.Identity.NAME_HASH_LENGTH // 8]

        if key_index is None:
            identity      = None
            identity_hash = None
        else:
            identity      = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))
            identity_hash = identity.hash

        destination_hash = RNS.Destination.hash(identity, app_name, *rest)

        # Every byte string in the format is hex, names included. A name
        # is arbitrary bytes; printing it as text would let a newline in
        # an aspect forge or hide a field.
        expect = [field("name", hexf(name_bytes)),
                  field("app_name", hexf(app_name.encode("utf-8")))]
        for aspect in rest:
            expect.append(field("aspect", hexf(aspect.encode("utf-8"))))
        expect.append(field("name_hash", name_hash.hex()))
        expect.append(field("identity_hash", identity_hash.hex() if identity_hash else "-"))
        expect.append(field("destination_hash", destination_hash.hex()))

        w.vector("destination", name, purpose,
            [name_bytes.hex(), identity_hash.hex() if identity_hash else "-"],
            expect)


def gen_signature(RNS, w, verify):
    """One adopted signature and one negative counterpart.

    Ed25519 itself has published vectors and is not restated here. What
    this pins is that Identity.sign is plain Ed25519 over the message,
    with no prefix, domain separator or prior hashing.

    Decode class: expect records the message by length and digest, not
    by content, so raw cannot be rebuilt from it.
    """
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[0][0]))
    public   = identity.get_public_key()
    message  = UPSTREAM_SIGNED_MESSAGE.encode("utf-8")
    good     = bytes.fromhex(UPSTREAM_SIGNATURE)

    # The reference implementation must reproduce the adopted value.
    assert identity.sign(message) == good

    bad = bytearray(good)
    bad[0] ^= 0x01
    bad = bytes(bad)

    # The one input in the corpus on which the two backends python-rns
    # ships disagree. The pin names the one that refuses it; the vector
    # records that verdict, and the assertions record that there was a
    # choice to make.
    mangled = non_canonical(good)
    assert not verify(public[32:], mangled, message)
    assert internal_accepts(public[32:], mangled, message)

    def blobs(signature):
        return [public.hex(), message.hex(), signature.hex()]

    def described(signature):
        return [
            field("ed25519_public", public[32:].hex()),
            field("message_length", "%d" % len(message)),
            field("message_sha256", hashlib.sha256(message).hexdigest()),
            field("signature",      signature.hex()),
            field("valid",          "yes" if verify(public[32:], signature, message) else "no"),
        ]

    w.vector("signature", "upstream",
        "adopted signature over the upstream message",
        blobs(good), described(good),
        source=UPSTREAM_SIG_SOURCE)

    built = derived_from(w, "signature", "upstream", blobs, described)

    built("altered", bad,
        "the same signature with the first byte altered")

    built("non-canonical-s", mangled,
        "the same signature with S re-encoded as S+L; the pinned backend rejects it")


def gen_sign(RNS, w):
    """The other direction of the same adopted value.

    tests/identity.py#sig_from_key_0 asserts what Identity.sign produces, not what
    it verifies. test/signature records the value and asks only that a
    signature check succeed; here the signature is not given, it is
    produced from the private key and the message.

    Ed25519 signing is deterministic, RFC 8032 section 5.1.6, so this
    is a fact a vector can state. An implementation that draws a random
    nonce, or signs with the wrong half of the Reticulum private key,
    passes every other vector in the corpus and emits announces and
    link proofs that nothing accepts.

    Decode class, for the same reason as test/signature: expect records
    the message by length and digest, not by content.
    """
    private = bytes.fromhex(UPSTREAM_KEYS[0][0])
    message = UPSTREAM_SIGNED_MESSAGE.encode("utf-8")

    identity  = RNS.Identity.from_bytes(private)
    signature = identity.sign(message)
    assert signature == bytes.fromhex(UPSTREAM_SIGNATURE)

    w.vector("sign", "upstream",
        "private key and message to the signature upstream asserts",
        [private.hex(), message.hex()],
        [
            field("private_key",     private.hex()),
            field("ed25519_private", private[32:].hex()),
            field("ed25519_public",  identity.get_public_key()[32:].hex()),
            field("message_length",  "%d" % len(message)),
            field("message_sha256",  hashlib.sha256(message).hexdigest()),
            field("signature",       signature.hex()),
        ],
        source="python-rns %s tests/identity.py#sig_from_key_0 (%s)" % (PIN_VERSION, PIN))


def gen_proof(RNS, w, verify):
    """The fourth packet type, and the only one nothing else covers.

    A proof is what a receiver sends back for a data packet it accepted.
    It is addressed not to a destination but to the first 16 bytes of
    the proved packet's hash (RNS/Packet.py#get_hash), which is how the
    sender recognises the answer to its own packet.

    Both accepted forms are recorded. The reference emits the implicit
    one by default and accepts either (RNS/Packet.py#EXPL_LENGTH).
    """
    private   = bytes.fromhex(UPSTREAM_KEYS[0][0])
    recipient = RNS.Identity.from_bytes(private)

    public_only = RNS.Identity(create_keys=False)
    public_only.load_public_key(recipient.get_public_key())

    with pinned(RNS, "proof"):
        destination = RNS.Destination(public_only, RNS.Destination.OUT,
                                      RNS.Destination.SINGLE,
                                      "rns_unit_tests", "link", "establish")
        RNS.Identity.known_ratchets.pop(destination.hash, None)
        proved = RNS.Packet(destination, b"reticulum")
        proved.pack()

    packet_hash = RNS.Identity.full_hash(proved.get_hashable_part())
    assert packet_hash == proved.packet_hash

    # prove() reads the setting through Reticulum.should_use_implicit_proof,
    # which is what a config file sets. gen starts no instance, so the
    # class attribute is set here instead.
    # RNS/Reticulum.py#__use_implicit_proof.
    forms = [
        ("implicit", True,
         "the 64-byte form the reference emits by default"),
        ("explicit", False,
         "the 96-byte form, hash and signature, which the reference also accepts"),
    ]

    made = {}
    for name, implicit, purpose in forms:
        RNS.Reticulum._Reticulum__use_implicit_proof = implicit
        with captured(RNS) as sent:
            recipient.prove(proved)
        assert len(sent) == 1
        proof = sent[0]

        payload = proof.raw[HEADER1LEN:]
        assert len(payload) == (64 if implicit else 96)

        signature = payload if implicit else payload[32:]
        assert verify(recipient.get_public_key()[32:], signature, packet_hash)

        w.vector("proof", name, purpose,
            [proved.raw.hex(), recipient.get_public_key().hex(), proof.raw.hex()],
            describe_proof(proved.raw, recipient.get_public_key(), proof.raw, verify))
        made[name] = proof

    # The proved packet after a transport node rewrote it, with the proof
    # left exactly as it was. That is the point of excluding the four low
    # flag bits, the hop count and the transport id from the hash: the
    # proof still addresses the right packet and the signature still
    # verifies, over a packet whose bytes have changed.
    transport_id = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0])).hash
    relayed = transport_insert(proved.raw, 3, transport_id)
    assert hashlib.sha256(hashable_part(relayed)).digest() == packet_hash

    described = describe_proof(relayed, recipient.get_public_key(),
                               made["implicit"].raw, verify)
    assert lookup_field(described, "destination_match") == "yes"
    assert lookup_field(described, "signature_valid") == "yes"

    public = recipient.get_public_key()

    # Neither of the two accepted payload lengths. The reference reads
    # 64 as implicit and 96 as explicit and drops everything else; this
    # is the rejection that names both.
    built = derived_from(w, "proof", "implicit",
                    lambda r: [proved.raw.hex(), public.hex(), r.hex()],
                    lambda r: describe_proof(proved.raw, public, r, verify))

    built("invalid-length", made["implicit"].raw[:-1],
        "63-byte payload, neither of the two accepted lengths")

    # The one derived vector in the corpus that alters the packet the
    # proof is about rather than the proof, so its blobs run the other
    # way: the proof below is the base vector's, byte for byte.
    relaying = derived_from(w, "proof", "implicit",
                       lambda r: [r.hex(), public.hex(), made["implicit"].raw.hex()],
                       lambda r: describe_proof(r, public, made["implicit"].raw, verify))

    relaying("proved-in-transport", relayed,
        "the proved packet at three hops in header 2; the proof is unchanged and still verifies",
        per="RNS/Transport.py#HEADER_2")

    # An explicit proof names the packet it proves and the signature is
    # over the hash the reader computes, not over the hash the packet
    # carries. So the two can disagree while the signature verifies, and
    # hash_match is the field that says which one was read. A decoder
    # that prints the carried hash back as packet_hash reports yes for
    # any 96 bytes at all.
    explicit = made["explicit"].raw
    naming = derived_from(w, "proof", "explicit",
                     lambda r: [proved.raw.hex(), public.hex(), r.hex()],
                     lambda r: describe_proof(proved.raw, public, r, verify))

    naming("hash-mismatch",
        explicit[:HEADER1LEN] + bytes([explicit[HEADER1LEN] ^ 0x01]) + explicit[HEADER1LEN+1:],
        "first byte of the named packet hash altered; the signature still verifies")


def describe_proof(proved_raw, signer_public, raw, verify):
    echo = [
        field("proved_packet", proved_raw.hex()),
        field("signer_public", signer_public.hex()),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) not in (SIGLEN, ADDRLEN * 2 + SIGLEN):
        return echo + invalid("invalid-length",
                              ("payload_length", len(payload)),
                              ("implicit_length", SIGLEN),
                              ("explicit_length", ADDRLEN * 2 + SIGLEN))

    explicit    = len(payload) == ADDRLEN * 2 + SIGLEN
    packet_hash = hashlib.sha256(hashable_part(proved_raw, None)).digest()
    signature   = payload[ADDRLEN*2:] if explicit else payload

    # On a link the proof is addressed to the link id rather than to the
    # hash it proves, and the key that verifies it is a single Ed25519
    # public rather than the two halves of an identity. Which of the two
    # applies is in the flags byte and nowhere else.
    on_link = h["destination_type"] == 3
    signer  = signer_public if on_link else signer_public[KEYHALF:]

    if on_link:
        _, ph = describe_header(proved_raw)
        addressed = [
            field("link_id",       ph["dest_hash"].hex()),
            field("link_id_match", "yes" if h["dest_hash"] == ph["dest_hash"] else "no"),
        ]
    else:
        addressed = [
            field("proof_destination", packet_hash[:ADDRLEN].hex()),
            field("destination_match",
                  "yes" if h["dest_hash"] == packet_hash[:ADDRLEN] else "no"),
        ]

    return lines + [
        field("form",             "explicit" if explicit else "implicit"),
        field("packet_hash",      packet_hash.hex()),
        field("proof_hash",       payload[:ADDRLEN*2].hex() if explicit else "-"),
        field("hash_match",       "yes" if not explicit
                                  else ("yes" if payload[:ADDRLEN*2] == packet_hash else "no")),
    ] + addressed + [
        field("signature",        signature.hex()),
        field("signer_ed25519",   signer.hex()),
        field("signature_valid",  "yes" if verify(signer, signature, packet_hash) else "no"),
    ]


def ifac_key(RNS, netname, netkey):
    """The interface identity, composed here rather than called.

    RNS/Reticulum.py#ifac_netname to :971 derives it inline in the
    constructor of a running instance and exposes no function to call.
    Every step is an RNS function called with RNS constants, but the
    order is this program's, and the order is exactly what a foreign
    implementation can get wrong: origin is a concatenation of two
    hashes, and neither half is present when that half is not
    configured.

    That is why netname and netkey are lines of raw and the key is a
    field: cmd/dump derives it again, from the same two strings and
    without sharing a line of code, and cmd/check diffs the results.
    """
    origin = b""
    if netname is not None:
        origin += RNS.Identity.full_hash(netname)
    if netkey is not None:
        origin += RNS.Identity.full_hash(netkey)

    return origin, RNS.Cryptography.hkdf(length=64,
                                         derive_from=RNS.Identity.full_hash(origin),
                                         salt=RNS.Reticulum.IFAC_SALT, context=None)


IFACS = [
    ("announce", b"reticulum-vectors", None, 16,
     "a named network, no passphrase; origin is one hash"),
    ("passphrase", b"reticulum-vectors", b"open sesame", 16,
     "network and passphrase; origin is the two hashes, name first"),
    ("passphrase-only", None, b"open sesame", 16,
     "a passphrase and no network; origin is one hash, and not the same one"),
    ("minimum-size", b"reticulum-vectors", None, 1,
     "a one-byte access code, IFAC_MIN_SIZE; the size is not on the wire"),
]


def gen_ifac(RNS, w, announce_raw_bytes):
    """The one transformation of the header that happens below Packet.

    Packet.unpack never reads bit 7 (RNS/Packet.py#header_type).
    Transport does, on the way out and on the way in, and a frame on an
    interface with a named network or a passphrase does not look like a
    packet at all until it is unmasked.

    The masking is not composed: the frame is what
    RNS/Transport.py#transmit produced, through Transport.transmit.
    """
    for name, netname, netkey, size, purpose in IFACS:
        origin, key = ifac_key(RNS, netname, netkey)
        identity    = RNS.Identity.from_bytes(key)

        class Interface:
            pass

        iface = Interface()
        iface.ifac_identity = identity
        iface.ifac_size     = size
        iface.ifac_key      = key

        frames = []
        iface.process_outgoing = frames.append

        # transmit logs and swallows exceptions, so the capture is the
        # only evidence that it ran.
        RNS.Transport.transmit(iface, announce_raw_bytes)
        assert len(frames) == 1, "Transport.transmit produced no frame"
        masked = frames[0]

        assert masked[0] & 0x80 == 0x80
        assert len(masked) == len(announce_raw_bytes) + size

        assert masked[2:2+size] == identity.sign(announce_raw_bytes)[-size:]

        def blobs(frame, netname=netname, netkey=netkey, size=size):
            return [hexf(netname or b""), hexf(netkey or b""),
                    "%02x" % size, frame.hex()]

        def describe(packet, frame, origin=origin, key=key,
                     identity=identity, netname=netname, netkey=netkey, size=size):
            ifac = frame[2:2+size]
            expected_ifac = identity.sign(packet)[-size:]
            return [
                field("netname",       hexf(netname or b"")),
                field("netkey",        hexf(netkey or b"")),
                field("ifac_origin",   origin.hex()),
                field("ifac_key",      key.hex()),
                field("ifac_size",     "%d" % size),
                field("frame_length",  "%d" % len(frame)),
                field("ifac",          ifac.hex()),
                field("packet",        packet.hex()),
                field("expected_ifac", expected_ifac.hex()),
                field("ifac_valid",    "yes" if ifac == expected_ifac else "no"),
            ]

        w.vector("ifac", name, purpose, blobs(masked),
                 describe(announce_raw_bytes, masked))

        if name != "announce":
            continue

        # The mask is a keystream keyed by the access code, so a bit
        # flipped in the last byte of the frame is the same bit flipped
        # in the last byte of the packet that comes back out, and the
        # code that should have covered it is unchanged. One
        # configuration carries this: what the vector tests is the
        # comparison at the end, which is the same four times.
        altered_packet = announce_raw_bytes[:-1] + bytes([announce_raw_bytes[-1] ^ 0x01])
        altered_frame  = masked[:-1] + bytes([masked[-1] ^ 0x01])

        one = derived_from(w, "ifac", name, blobs,
                           lambda f, p=altered_packet: describe(p, f))
        one("altered-frame",  altered_frame,
            "last byte of the frame altered; the code no longer covers what comes out")


DEST_TYPES   = ["single", "group", "plain", "link"]
PACKET_TYPES = ["data", "announce", "linkrequest", "proof"]
XPORT_TYPES  = ["broadcast", "transport"]
CONTEXTS     = {0x00: "none",
                0x01: "resource", 0x02: "resource_adv", 0x03: "resource_req",
                0x04: "resource_hmu", 0x05: "resource_prf",
                0x06: "resource_icl", 0x07: "resource_rcl",
                0x09: "request", 0x0a: "response", 0x0b: "path_response", 0x0e: "channel",
                0xfa: "keepalive", 0xfb: "link_identify", 0xfc: "link_close",
                0xfd: "link_proof", 0xfe: "link_rtt", 0xff: "link_request_proof"}

# Only MODE_AES256_CBC is enabled at the pin, RNS/Link.py#ENABLED_MODES.
LINK_MODES   = {0x01: "aes256_cbc"}

KEYSIZE     = 64
NAMEHASHLEN = 10
RANDHASHLEN = 10
SIGLEN      = 64
RATCHETLEN  = 32
ADDRLEN     = 16
KEYHALF     = 32
TOKEN_OVERHEAD = 48     # RNS/Cryptography/Token.py#TOKEN_OVERHEAD
HEADER1LEN  = 19        # RNS/Reticulum.py#HEADER_MINSIZE
HASHLEN     = 32        # RNS/Identity.py#HASHLENGTH
MAPHASHLEN  = 4         # RNS/Resource.py#MAPHASH_LEN
EXHAUSTED   = 0xff      # RNS/Resource.py#HASHMAP_IS_EXHAUSTED
MAX_HOPS    = 128       # RNS.Transport.PATHFINDER_M
ECPUBSIZE   = 64        # RNS/Link.py#ECPUBSIZE, both public keys
SIGNALLEN   = 3         # RNS/Link.py#LINK_MTU_SIZE, LINK_MTU_SIZE
MTU_BYTEMASK = 0x1fffff # RNS/Link.py#MTU_BYTEMASK
MODE_DEFAULT = 0x01     # RNS/Link.py#MODE_DEFAULT
ENVELOPELEN  = 6        # RNS/Channel.py#MSGTYPE, three big-endian shorts


# The Ed25519 group order, RFC 8032 section 5.1.
ED25519_L = 2**252 + 27742317777372353535851937790883648493


def non_canonical(signature):
    """The same signature with S re-encoded as S + L.

    RFC 8032 section 5.1.7 admits only S < L, so this is a second
    encoding of one signature rather than a forgery: R is untouched and
    S reduces to the original. The openssl backend refuses it, the
    internal fallback accepts it, and so does an implementation that
    reduces S instead of range-checking it.
    """
    s = int.from_bytes(signature[32:], "little") + ED25519_L
    assert s < 2**256, "S + L does not fit in 32 bytes"
    return signature[:32] + s.to_bytes(32, "little")


def internal_accepts(ed25519_public, signature, message):
    """The verdict of the backend that is not pinned.

    The two non-canonical vectors exist because the answer differs from
    the pinned one. Asserting it here keeps the vector from quietly
    becoming a vector about nothing if a future release aligns them.
    """
    from RNS.Cryptography.pure25519 import ed25519_oop
    try:
        ed25519_oop.VerifyingKey(ed25519_public).verify(signature, message)
        return True
    except Exception:
        return False


def invalid(reason, *evidence):
    """A packet that cannot be decoded yields the reason and the numbers
    behind it, so a disagreement names the rule rather than the stage."""
    return [field("invalid", reason)] + [field(k, "%d" % v) for k, v in evidence]


def describe_header(raw):
    """Every packet kind starts here.

    The layout is read without consulting any RNS object, so gen and
    dump are two independent decoders of the same bytes and check
    compares them. A misreading on one side shows up as a diff.
    """
    if len(raw) < 2:
        return invalid("short-header", ("length", len(raw)), ("minimum_length", 2)), None

    flags, hops = raw[0], raw[1]

    header_type      = (flags & 0b01000000) >> 6
    context_flag     = (flags & 0b00100000) >> 5
    transport_type   = (flags & 0b00010000) >> 4
    destination_type = (flags & 0b00001100) >> 2
    packet_type      = (flags & 0b00000011)

    if hops >= MAX_HOPS:
        return invalid("hop-limit", ("hops", hops), ("hop_limit", MAX_HOPS)), None

    header_len = 3 + ADDRLEN * (header_type + 1)
    if len(raw) < header_len:
        return invalid("short-header", ("length", len(raw)), ("minimum_length", header_len)), None

    if header_type == 1:
        transport_id = raw[2:2+ADDRLEN]
        dest_hash    = raw[2+ADDRLEN:2+2*ADDRLEN]
        context      = raw[2+2*ADDRLEN]
    else:
        transport_id = None
        dest_hash    = raw[2:2+ADDRLEN]
        context      = raw[2+ADDRLEN]
    payload = raw[header_len:]

    lines = [
        field("flags",            "%02x" % flags),
        field("header_type",      "%d" % (header_type + 1)),
        field("context_flag",     "set" if context_flag else "unset"),
        field("transport_type",   XPORT_TYPES[transport_type]),
        field("destination_type", DEST_TYPES[destination_type]),
        field("packet_type",      PACKET_TYPES[packet_type]),
        field("hops",             "%d" % hops),
        field("transport_id",     transport_id.hex() if transport_id else "-"),
        field("destination_hash", dest_hash.hex()),
        field("context",          CONTEXTS.get(context, "%02x" % context)),
        field("payload_length",   "%d" % len(payload)),
    ]
    return lines, {"payload": payload, "context_flag": context_flag,
                   "dest_hash": dest_hash, "context": context,
                   "destination_type": destination_type}


def describe_announce(raw, verify):
    lines, h = describe_header(raw)
    if h is None:
        return lines

    payload      = h["payload"]
    context_flag = h["context_flag"]
    dest_hash    = h["dest_hash"]

    minimum = KEYSIZE + NAMEHASHLEN + RANDHASHLEN + SIGLEN
    if context_flag == 1:
        minimum += RATCHETLEN
    if len(payload) < minimum:
        return invalid("short-payload",
                       ("payload_length", len(payload)), ("minimum_length", minimum))

    at          = 0
    public_key  = payload[at:at+KEYSIZE];      at += KEYSIZE
    name_hash   = payload[at:at+NAMEHASHLEN];  at += NAMEHASHLEN
    random_hash = payload[at:at+RANDHASHLEN];  at += RANDHASHLEN
    if context_flag == 1:
        ratchet = payload[at:at+RATCHETLEN];   at += RATCHETLEN
    else:
        ratchet = b""
    signature   = payload[at:at+SIGLEN];       at += SIGLEN
    app_data    = payload[at:]

    identity_hash = hashlib.sha256(public_key).digest()[:ADDRLEN]
    expected_hash = hashlib.sha256(name_hash + identity_hash).digest()[:ADDRLEN]

    # app_data is transmitted after the signature but signed before it.
    signed_data = dest_hash + public_key + name_hash + random_hash + ratchet + app_data

    return lines + [
        field("public_key",       public_key.hex()),
        field("name_hash",        name_hash.hex()),
        field("random_hash",      random_hash.hex()),
        field("ratchet",          ratchet.hex() if ratchet else "-"),
        field("signature",        signature.hex()),
        field("app_data",         app_data.hex() if app_data else "-"),
        field("identity_hash",    identity_hash.hex()),
        field("expected_hash",    expected_hash.hex()),
        field("destination_match", "yes" if dest_hash == expected_hash else "no"),
        field("signed_data",      signed_data.hex()),
        field("signature_valid",  "yes" if verify(public_key[32:], signature, signed_data) else "no"),
    ]


def announce_raw(RNS, key_index, aspects, app_data, ratchet, path_response, tag, tmpdir):
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))

    with pinned(RNS, tag):
        destination = RNS.Destination(identity, RNS.Destination.IN,
                                      RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        if ratchet:
            destination.enable_ratchets(os.path.join(tmpdir, tag))

        packet = destination.announce(app_data=app_data, path_response=path_response, send=False)
        packet.pack()

    # The reference implementation must accept what it produced.
    assert RNS.Identity.validate_announce(packet)
    return packet.raw


def transport_insert(raw, hops, transport_id):
    """Rewrite a header 1 packet as a header 2 packet in transport,
    exactly as Transport.mangle_hops does at RNS/Transport.py#HEADER_2."""
    flags = raw[0] | (0x01 << 6) | (0x01 << 4)
    return bytes([flags, hops]) + transport_id + raw[2:]


def gen_announce(RNS, w, tmpdir, verify):
    raws = {}

    for name, key_index, aspects, app_data, ratchet, path_response, purpose in ANNOUNCES:
        raw = announce_raw(RNS, key_index, aspects, app_data, ratchet,
                           path_response, "announce-" + name, tmpdir)
        raws[name] = raw
        w.vector("announce", name, purpose,
            [raw.hex()],
            describe_announce(raw, verify))

    base         = raws["minimal"]
    transport_id = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0])).hash

    # Derived cases. Each states in its source how it was built, since
    # none of them is something the reference implementation emitted.
    built = derived_from(w, "announce", "minimal",
                    lambda raw: [raw.hex()],
                    lambda raw: describe_announce(raw, verify))

    built("in-transport", transport_insert(base, 1, transport_id),
        "header 2, one hop, transport id inserted",
        per="RNS/Transport.py#HEADER_2")

    built("destination-mismatch", base[:2] + bytes(ADDRLEN) + base[2+ADDRLEN:],
        "destination hash replaced with zeroes; the announce decodes but does not match")

    built("short-payload", base[:-1],
        "one byte short of the minimum payload")

    # One byte short of a header 1 header. Nothing about the packet can
    # be read, not even the context byte, so the rejection names a
    # length and not a payload.
    built("short-header", base[:18],
        "18 bytes, one short of a header 1 header")

    # The other threshold, and the only one that is not a header length:
    # how long a header has to be does not follow from the bytes until
    # the header type is read, and the header type is in the first of
    # them. A decoder that reaches for byte 0 alone and then for the
    # length is right about this packet by accident.
    built("no-header", base[:1],
        "one byte, too short to say which of the two header lengths applies")

    built("hop-limit", base[:1] + bytes([MAX_HOPS]) + base[2:],
        "hop count at the limit, which the reference implementation rejects")

    # The third threshold, and the one a constant cannot express. A
    # header 2 is 35 bytes where a header 1 is 19, and which applies is
    # bit 6 of the flags byte. A decoder that takes 19 for granted reads
    # 34 bytes as a whole packet and takes the transport id for a
    # destination hash. The two vectors above name 2 and 19 and neither
    # can catch that.
    relayed = derived_from(w, "announce", "in-transport",
                      lambda raw: [raw.hex()],
                      lambda raw: describe_announce(raw, verify))

    relayed("short-header-2", transport_insert(base, 1, transport_id)[:34],
        "34 bytes, one short of a header 2 header")

    # The other side of the same boundary. Without it a decoder with no
    # hop limit and a decoder whose limit is off by one both fail
    # hop-limit and are indistinguishable; every implementation measured
    # in CONFORMANCE failed it, two of them for different reasons. The
    # hop count is not part of the signed data, so this announce still
    # verifies.
    built("hop-limit-below", base[:1] + bytes([MAX_HOPS - 1]) + base[2:],
        "hop count one below the limit, which decodes")

    built("altered-signature",
        base[:-SIGLEN] + bytes([base[-SIGLEN] ^ 0x01]) + base[-SIGLEN+1:],
        "first signature byte altered; the announce decodes and matches, but the signature does not verify")

    # announce/minimal carries no app data, so the signature is the tail
    # of the packet. The same re-encoding as test/signature, on a whole
    # packet, because that is where it costs something.
    built("non-canonical-s", base[:-SIGLEN] + non_canonical(base[-SIGLEN:]),
        "signature S re-encoded as S+L; the announce decodes and matches, and the pinned backend rejects it")

    return base


def describe_plain(raw):
    lines, h = describe_header(raw)
    if h is None:
        return lines
    payload = h["payload"]

    return lines + [
        field("plaintext_length", "%d" % len(payload)),
        field("plaintext",        hexf(payload)),
    ]


def gen_plain(RNS, w):
    """Packets to a plain destination, which are not encrypted at all.

    Destination.encrypt returns the plaintext unchanged for this type
    (RNS/Destination.py#PLAIN), so there is no ephemeral key, no token and
    no padding: the payload is the data. The type had no vectors, and it
    is the one every transport node has to handle whether or not it ever
    encrypts anything, because path requests are addressed to one.

    The destination has no identity, so its hash is SHA-256 of the name
    hash alone; test/destination/no-identity records that derivation.
    """
    # The payload here is arbitrary bytes, not a path request: what the
    # payload of a path request means is test/pathrequest, and these two
    # vectors record only that a plain destination hands the payload
    # through untouched, whatever it holds.
    wanted = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[0][0]))
    destination_hash = RNS.Destination.hash(wanted, "rns_unit_tests", "link", "establish")

    made = {}
    cases = [
        ("payload", (RNS.Transport.APP_NAME, "path", "request"),
         destination_hash + bytes.fromhex("0102030405060708090a"),
         "26 bytes of payload, delivered unencrypted and undecomposed"),
        ("empty", (RNS.Transport.APP_NAME, "path", "request"), b"",
         "no payload at all, which a plain destination permits and an encrypted one cannot"),
    ]

    for name, aspects, data, purpose in cases:
        with pinned(RNS, "plain-" + name):
            out = RNS.Destination(None, RNS.Destination.OUT, RNS.Destination.PLAIN,
                                  aspects[0], *aspects[1:])
            packet = RNS.Packet(out, data, packet_type=RNS.Packet.DATA,
                                transport_type=RNS.Transport.BROADCAST,
                                header_type=RNS.Packet.HEADER_1)
            packet.pack()

        # The property the kind exists to record: nothing was encrypted.
        assert packet.raw[HEADER1LEN:] == data
        assert packet.raw[2:18] == out.hash

        w.vector("plain", name, purpose,
            [packet.raw.hex()],
            describe_plain(packet.raw))
        made[name] = packet.raw

    # The context byte of a cache request, RNS/Packet.py#CACHE_REQUEST.
    # The reference defines the name and this corpus does not, because
    # no vector carries such a packet, so the byte prints as two hex
    # digits. That fallback is the one place a value form depends on the
    # value; every other vector carries a byte the format has a name
    # for. It is a plain packet because the fallback is in the header
    # and a plain packet is the shortest thing with one.
    base  = made["payload"]
    built = derived_from(w, "plain", "payload",
                    lambda r: [r.hex()], describe_plain)

    built("unnamed-context", base[:HEADER1LEN-1] + bytes([0x08]) + base[HEADER1LEN:],
        "a context byte this format has no name for, which prints as hex")


def describe_pathrequest(raw):
    """Which fields a path request carries is decided by how long it is,
    and by nothing else. RNS/Transport.py#TRUNCATED_HASHLENGTH.
    """
    lines, h = describe_header(raw)
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) < ADDRLEN:
        return invalid("short-payload",
                       ("payload_length", len(payload)),
                       ("minimum_length", ADDRLEN))

    wanted = payload[:ADDRLEN]
    if len(payload) > ADDRLEN * 2:
        requester = payload[ADDRLEN:ADDRLEN*2]
        tag       = payload[ADDRLEN*2:]
    else:
        requester = None
        tag       = payload[ADDRLEN:]

    return lines + [
        field("wanted_hash",  wanted.hex()),
        field("requester_id", requester.hex() if requester else "-"),
        field("tag",          hexf(tag)),
        field("unique_tag",   (wanted + tag[:ADDRLEN]).hex() if tag else "-"),
        field("accepted",     "yes" if tag else "no"),
    ]


def gen_pathrequest(RNS, w):
    """The payload a transport node reads before it knows a path is
    being asked for.

    request_path writes two or three fields, and the handler reads them
    back by length alone: there is no count, no type byte and no
    delimiter. A tag of 17 bytes is therefore indistinguishable from a
    transport id followed by a tag of one, and the reference reads it as
    the latter. That ambiguity is the vector.

    The two instance attributes set below are what a running instance
    would hold. request_path reads both and neither is a value the
    corpus asserts anything about; the bytes are the reference's.

        RNS/Transport.py#transport_enabled
        RNS/Reticulum.py#__transport_enabled
    """
    wanted = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[0][0]))
    destination_hash = RNS.Destination.hash(wanted, "rns_unit_tests", "link", "establish")

    RNS.Transport.identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0]))

    cases = [
        ("tagged", False, None,
         "the form an instance that is not a transport node sends"),
        ("transport", True, None,
         "the transport-node form; the requesting instance's id sits between the two"),
        ("tagless", False, b"",
         "the destination hash alone, which the reference reads and then drops"),
        ("ambiguous", False, bytes.fromhex("0102030405060708090a0b0c0d0e0f1011"),
         "a 17-byte tag, which the length rule reads as a transport id and one tag byte"),
        ("long-tag", False, bytes.fromhex("0102030405060708090a0b0c0d0e0f10" * 2 + "11"),
         "a 33-byte tag; 17 bytes are left after the split and 16 of those survive"),
    ]

    for name, transport, tag, purpose in cases:
        RNS.Reticulum._Reticulum__transport_enabled = transport
        with pinned(RNS, "pathrequest-" + name):
            with captured(RNS) as sent:
                RNS.Transport.request_path(destination_hash, tag=tag)
        RNS.Reticulum._Reticulum__transport_enabled = False

        assert len(sent) == 1
        raw = sent[0].raw

        # The handler's own reading of what it just built, so that the
        # decomposition below is measured against RNS and not only
        # against cmd/dump.
        described = describe_pathrequest(raw)
        seen = handler_reads(RNS, raw[HEADER1LEN:])
        if seen is None:
            assert lookup_field(described, "accepted") == "no"
        else:
            assert lookup_field(described, "wanted_hash") == seen["destination_hash"].hex()
            assert lookup_field(described, "requester_id") == hexf(seen["transport_id"])
            assert lookup_field(described, "unique_tag") == seen["unique_tag"].hex()

        w.vector("pathrequest", name, purpose, [raw.hex()], described)

    # Shorter than the destination hash it is supposed to name. The
    # handler reads nothing at all from it, which is a rejection with no
    # rule of its own; the corpus names the length that failed.
    with pinned(RNS, "pathrequest-short"):
        out = RNS.Destination(None, RNS.Destination.OUT, RNS.Destination.PLAIN,
                              RNS.Transport.APP_NAME, "path", "request")
        short = RNS.Packet(out, destination_hash[:ADDRLEN-1], packet_type=RNS.Packet.DATA,
                           transport_type=RNS.Transport.BROADCAST,
                           header_type=RNS.Packet.HEADER_1)
        short.pack()

    assert handler_reads(RNS, short.raw[19:]) is None

    w.vector("pathrequest", "short",
        "15 bytes, one short of the destination hash a path request names",
        [short.raw.hex()],
        describe_pathrequest(short.raw))


def handler_reads(RNS, data):
    """What Transport.path_request_handler took the payload to mean.

    The handler acts on what it reads rather than returning it, so the
    call it makes is intercepted and its arguments are the answer. None
    means it made no call: the payload named no destination, or named
    one with no tag.

        RNS/Transport.py#TRUNCATED_HASHLENGTH
    """
    real_request = RNS.Transport.path_request
    seen = []

    def path_request(destination_hash, is_from_local_client, attached_interface,
                     requestor_transport_id=None, tag=None):
        seen.append({"destination_hash": destination_hash,
                     "transport_id": requestor_transport_id,
                     "tag": tag,
                     "unique_tag": destination_hash + tag})

    class Packet:
        receiving_interface = None

    RNS.Transport.path_request = staticmethod(path_request)
    RNS.Transport.discovery_pr_tags.clear()
    try:
        RNS.Transport.path_request_handler(data, Packet())
    finally:
        RNS.Transport.path_request = real_request

    return seen[0] if seen else None


def hashable_part(raw, payload_len=None):
    """The bytes a packet is hashed over, RNS/Packet.py#get_hashable_part.

    The low four flag bits and the hop count are excluded so that a
    packet keeps its hash while it travels. That much is the packet
    hash, which a proof is taken over.

    A link id is the same hash with any signalling bytes chopped off
    the end first, so that signalling the MTU does not change the
    identity of the link (RNS/Link.py#link_id_from_lr_packet). Pass
    the payload length to get that; leave it out for the packet hash.
    """
    header_type = (raw[0] & 0b01000000) >> 6
    part = bytes([raw[0] & 0x0f]) + (raw[2+ADDRLEN:] if header_type else raw[2:])
    if payload_len is None:
        return part
    excess = payload_len - ECPUBSIZE
    return part[:len(part)-excess] if excess > 0 else part


def describe_signalling(signalling):
    """Three bytes, big endian: three bits of mode and 21 of mtu.

    A link request and the proof that answers it carry the same three
    bytes in different positions and read them the same way. None means
    the shorter form, where the mode falls back to the default and the
    mtu has no fallback at all. RNS/Link.py#signalling_bytes.
    """
    if signalling is None:
        mode, mtu = MODE_DEFAULT, None
    else:
        value = int.from_bytes(signalling, "big")
        mode  = (value >> 21) & 0x07
        mtu   = value & MTU_BYTEMASK

    return [
        field("signalling", signalling.hex() if signalling is not None else "-"),
        field("mode",       LINK_MODES.get(mode, "%02x" % mode)),
        field("mtu",        "-" if mtu is None else "%d" % mtu),
    ]


def describe_linkrequest(raw):
    lines, h = describe_header(raw)
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) not in (ECPUBSIZE, ECPUBSIZE + SIGNALLEN):
        return invalid("invalid-length",
                       ("payload_length", len(payload)),
                       ("accepted_length", ECPUBSIZE),
                       ("signalled_length", ECPUBSIZE + SIGNALLEN))

    signalled = len(payload) == ECPUBSIZE + SIGNALLEN
    link_id   = hashlib.sha256(hashable_part(raw, len(payload))).digest()[:ADDRLEN]

    return lines + [
        field("x25519_public",  payload[:KEYHALF].hex()),
        field("ed25519_public", payload[KEYHALF:ECPUBSIZE].hex()),
    ] + describe_signalling(payload[ECPUBSIZE:] if signalled else None) + [
        field("link_id",        link_id.hex()),
    ]


@contextlib.contextmanager
def captured(RNS):
    """Packet.send hands the packet to Transport, which is not running.
    The corpus wants the bytes, so send packs and records instead.

    It returns what the real send returns, where that can be built. A
    receipt holds two hashes and six fields and starts nothing, and
    Link.request sets a timeout on the one it gets back, so returning
    True there ends the request before it has one. Over a destination
    rather than a link the receipt asks the running instance for the
    first hop timeout (RNS/Packet.py#get_first_hop_timeout), and
    there is nothing to return but True.
    """
    real_send = RNS.Packet.send
    sent = []

    def send(self):
        self.pack()
        sent.append(self)
        if self.destination.type == RNS.Destination.LINK:
            return RNS.PacketReceipt(self)
        return True

    RNS.Packet.send = send
    try:
        yield sent
    finally:
        RNS.Packet.send = real_send


def link_session(RNS, tag):
    """Establish one link, far enough to produce packets from both ends.

    The request is assembled as Link.__init__ does at
    RNS/Link.py#initiator. The initiator half of that constructor
    reaches for a running instance three lines earlier, so the four
    lines that produce bytes are run here instead. The responder is then
    built as validate_request builds it at
    RNS/Link.py#peer_sig_pub_bytes, up to and including prove; what
    follows there registers the link and starts a watchdog, and produces
    no bytes.

    Everything that shapes a byte is the reference's own: the key
    classes Link resolves, its signalling encoder, its handshake, its
    prove, and Packet.pack.

    One pinned block covers all of it. The responder draws a key of its
    own, and it has to come from the same stream for the proof to be
    reproducible.
    """
    key_index, aspects = LINK_DESTINATION
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))

    public_only = RNS.Identity(create_keys=False)
    public_only.load_public_key(identity.get_public_key())

    link_mod = sys.modules["RNS.Link"]
    with pinned(RNS, tag):
        out_destination = RNS.Destination(public_only, RNS.Destination.OUT,
                                          RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        prv     = link_mod.X25519PrivateKey.generate()
        sig_prv = link_mod.Ed25519PrivateKey.generate()

        signalling   = RNS.Link.signalling_bytes(RNS.Reticulum.MTU, RNS.Link.MODE_DEFAULT)
        request_data = prv.public_key().public_bytes() + \
                       sig_prv.public_key().public_bytes() + signalling

        request = RNS.Packet(out_destination, request_data,
                             packet_type=RNS.Packet.LINKREQUEST)
        request.pack()

        in_destination = RNS.Destination(identity, RNS.Destination.IN,
                                         RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        link = RNS.Link(owner=in_destination,
                        peer_pub_bytes=request_data[:KEYHALF],
                        peer_sig_pub_bytes=request_data[KEYHALF:ECPUBSIZE])
        link.set_link_id(request)
        link.mtu  = RNS.Link.mtu_from_lr_packet(request)
        link.mode = RNS.Link.mode_from_lr_packet(request)
        link.update_mdu()
        link.destination = in_destination
        link.rtt = PINNED_RTT
        link.handshake()

        with captured(RNS) as sent:
            link.prove()

    return {
        "identity":       identity,
        "in_destination": in_destination,
        "prv":            prv,
        "sig_prv":        sig_prv,
        "request":        request,
        "link":           link,
        "proof":          sent[0],
    }


def initiator_link(RNS, session):
    """The initiator half, as validate_proof completes it at
    RNS/Link.py#initiator.

    Link.__init__ draws keys of its own, and the initiator's are already
    fixed by the request it sent, so the object is built through the
    inert constructor and then given those keys. Status is set to
    ACTIVE, which is what validate_proof does at RNS/Link.py#ACTIVE once
    the signature checks out, and what identify requires.
    """
    proof_data = session["proof"].data
    peer_ed25519 = session["identity"].get_public_key()[KEYHALF:]

    link = RNS.Link(owner=session["in_destination"])
    link.initiator     = True
    link.prv           = session["prv"]
    link.sig_prv       = session["sig_prv"]
    link.pub_bytes     = link.prv.public_key().public_bytes()
    link.sig_pub_bytes = link.sig_prv.public_key().public_bytes()
    link.set_link_id(session["request"])
    link.mtu           = session["link"].mtu
    link.mode          = session["link"].mode
    link.rtt           = PINNED_RTT
    link.update_mdu()
    link.load_peer(proof_data[SIGLEN:SIGLEN+KEYHALF], peer_ed25519)
    link.handshake()
    link.status = RNS.Link.ACTIVE

    # The point of the handshake: two ends, no shared secret in any
    # packet, one key.
    assert link.derived_key == session["link"].derived_key
    return link


def gen_linkrequest(RNS, w, session):
    raw = session["request"].raw
    packet = session["request"]

    # The reference must agree with the decoder above about which link
    # this request opens, and about what it signalled.
    link_id = bytes.fromhex(
        lookup_field(describe_linkrequest(raw), "link_id"))
    assert link_id == RNS.Link.link_id_from_lr_packet(packet)
    assert RNS.Link.mtu_from_lr_packet(packet) == RNS.Reticulum.MTU
    assert RNS.Link.mode_from_lr_packet(packet) == RNS.Link.MODE_DEFAULT

    w.vector("linkrequest", "signalling",
        "link request as the reference emits it, mode and mtu signalled",
        [raw.hex()],
        describe_linkrequest(raw))

    built = derived_from(w, "linkrequest", "signalling",
                    lambda r: [r.hex()],
                    describe_linkrequest)

    # Without signalling is the shorter form validate_request still
    # accepts at RNS/Link.py#LINK_MTU_SIZE. It opens the same link:
    # the signalling bytes are excluded from the link id.
    built("no-signalling", raw[:-SIGNALLEN],
        "the 64-byte form; same link id, mode falls back to the default")

    built("invalid-length", raw[:-1],
        "66-byte payload, neither of the two accepted lengths")

    # MODE_AES128_CBC, which the reference defines and does not enable:
    # signalling_bytes raises on any mode outside ENABLED_MODES
    # (RNS/Link.py#ENABLED_MODES), so no request it emits carries
    # this one, and the format has no name for it. The mode is the top
    # three bits of the signalling word. The signalling bytes are
    # trimmed before the link id is taken, so this opens the same link
    # as linkrequest/signalling and differs from it in one field.
    modeless = raw[:-SIGNALLEN] + bytes([raw[-SIGNALLEN] & 0x1f]) + raw[-SIGNALLEN+1:]
    assert lookup_field(describe_linkrequest(modeless), "link_id") == link_id.hex()
    assert lookup_field(describe_linkrequest(modeless), "mode") == "00"
    assert RNS.Link.MODE_AES128_CBC not in RNS.Link.ENABLED_MODES

    built("unnamed-mode", modeless,
        "a mode the reference defines and does not enable, which prints as hex")

    # The same request after a transport node rewrote it. The link id is
    # taken over the packet with the four high flag bits cleared, the hop
    # count removed and the transport id removed, so it must be the id
    # above. It is the only vector that exercises the branch dropping a
    # transport id before hashing: an announce carries header 2 too, but
    # derives no link id and no packet hash.
    transport_id = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0])).hash
    relayed = transport_insert(raw, 1, transport_id)
    assert lookup_field(describe_linkrequest(relayed), "link_id") == link_id.hex()

    built("in-transport", relayed,
        "header 2, one hop; the same link id as linkrequest/signalling",
        per="RNS/Transport.py#HEADER_2")


def describe_linkproof(request_raw, identity_public, raw, verify):
    """Three of the four parts that were signed are not in the packet. The
    link id comes from the request, the peer Ed25519 key from the
    identity of the destination the request was addressed to, and the
    signalling bytes are signed in the position they occupy here.
    """
    # The two input blobs are echoed so that expect holds every byte of
    # raw. Without them the vector could be decoded but not rebuilt.
    echo = [
        field("link_request",  request_raw.hex()),
        field("signer_public", identity_public.hex()),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) not in (SIGLEN + KEYHALF, SIGLEN + KEYHALF + SIGNALLEN):
        return echo + invalid("invalid-length",
                              ("payload_length", len(payload)),
                              ("accepted_length", SIGLEN + KEYHALF),
                              ("signalled_length", SIGLEN + KEYHALF + SIGNALLEN))

    _, rh = describe_header(request_raw)
    link_id = hashlib.sha256(
        hashable_part(request_raw, len(rh["payload"]))).digest()[:ADDRLEN]

    signalled  = len(payload) == SIGLEN + KEYHALF + SIGNALLEN
    signature  = payload[:SIGLEN]
    x25519     = payload[SIGLEN:SIGLEN+KEYHALF]
    signalling = payload[SIGLEN+KEYHALF:]

    signer_ed25519 = identity_public[KEYHALF:]
    signed_data    = link_id + x25519 + signer_ed25519 + signalling

    return lines + [
        field("link_id",         link_id.hex()),
        field("link_id_match",   "yes" if h["dest_hash"] == link_id else "no"),
        field("signature",       signature.hex()),
        field("x25519_public",   x25519.hex()),
    ] + describe_signalling(signalling if signalled else None) + [
        field("signer_ed25519",  signer_ed25519.hex()),
        field("signed_data",     signed_data.hex()),
        field("signature_valid", "yes" if verify(signer_ed25519, signature, signed_data) else "no"),
    ]


def gen_linkproof(RNS, w, verify, session):
    identity, request = session["identity"], session["request"]
    link, proof = session["link"], session["proof"]

    public  = identity.get_public_key()
    request_raw, raw = request.raw, proof.raw
    blobs = [request_raw.hex(), public.hex()]

    # The reference must accept its own proof. validate_proof drives a
    # link state machine, so the two facts it turns on are asserted
    # instead: the address field is the link id, and the signature is
    # over the four parts assembled below.
    assert proof.raw[2:2+ADDRLEN] == link.link_id
    assert lookup_field(describe_linkproof(request_raw, public, raw, verify),
                        "signature_valid") == "yes"

    w.vector("linkproof", "signalling",
        "link request proof as the reference emits it, mtu confirmed",
        blobs + [raw.hex()],
        describe_linkproof(request_raw, public, raw, verify))

    built = derived_from(w, "linkproof", "signalling",
                    lambda r: blobs + [r.hex()],
                    lambda r: describe_linkproof(request_raw, public, r, verify))

    # The 96-byte form validate_proof also accepts, at
    # RNS/Link.py#initiator.
    # The reference never emits it: prove always signals. Removing the
    # bytes removes them from the signed material too, so the signature
    # no longer verifies, which is the point of the vector.
    removed = raw[:-SIGNALLEN]
    built("signalling-removed", removed,
        "signalling bytes removed; the proof still decodes and the signature does not verify")

    built("altered-signature", raw[:19] + bytes([raw[19] ^ 0x01]) + raw[20:],
        "first signature byte altered")

    # The signature covers the link id the request derives, not the
    # address field that carries it. So a proof addressed elsewhere
    # verifies, and link_id_match is the only field that reports it. A
    # decoder that prints the address field twice, once as
    # destination_hash and once as link_id, passes every other vector of
    # this kind.
    built("link-id-mismatch", raw[:2] + bytes(ADDRLEN) + raw[2+ADDRLEN:],
        "address field replaced with zeroes; the signature verifies and the proof is for another link")

    # Neither accepted length. linkproof and linkrequest each have two,
    # and they are not the same two: a proof carries a signature where a
    # request carries an Ed25519 key. A decoder that checks the request
    # and takes the proof on trust passes linkrequest/invalid-length and
    # opens a link on 95 bytes of nothing.
    built("invalid-length", removed[:-1],
        "95-byte payload, neither of the two accepted lengths",
        base="signalling-removed")


def describe_linkdata(request_raw, responder_private, raw, verify):
    """Unlike a packet to a destination, this one carries no ephemeral
    key: both ends already hold the shared secret. The salt of the
    derivation is the link id, which is in no packet either.
    """
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey, X25519PublicKey

    # The two input blobs are echoed so that expect holds every byte of
    # raw. Without them the vector could be decoded but not rebuilt.
    echo = [
        field("link_request",      request_raw.hex()),
        field("responder_private", responder_private.hex()),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    _, rh = describe_header(request_raw)
    link_id = hashlib.sha256(
        hashable_part(request_raw, len(rh["payload"]))).digest()[:ADDRLEN]

    lines += [
        field("link_id",       link_id.hex()),
        field("link_id_match", "yes" if h["dest_hash"] == link_id else "no"),
    ]

    # A resource part is not encrypted by the packet layer either: the
    # resource encrypted its whole data through the link once and cut
    # the token into parts. RNS/Packet.py#RESOURCE.
    if h["context"] == RESOURCE:
        return lines + [
            field("encrypted",        "no"),
            field("plaintext_length", "%d" % len(payload)),
            field("plaintext",        hexf(payload)),
        ]

    # Keepalives carry no data and are the one link packet the
    # reference does not encrypt. RNS/Packet.py#KEEPALIVE.
    if h["context"] == 0xfa:
        return lines + [
            field("encrypted",        "no"),
            field("plaintext_length", "%d" % len(payload)),
            field("plaintext",        payload.hex() if payload else "-"),
        ]

    lines.append(field("encrypted", "yes"))

    if len(payload) < TOKEN_OVERHEAD:
        return lines + invalid("short-payload",
                               ("payload_length", len(payload)),
                               ("minimum_length", TOKEN_OVERHEAD))

    initiator_public = rh["payload"][:KEYHALF]
    shared = X25519PrivateKey.from_private_bytes(responder_private).exchange(
        X25519PublicKey.from_public_bytes(initiator_public))
    derived = hkdf_sha256(64, shared, link_id)

    t = token_open(payload, derived)
    plaintext = t["plaintext"]

    lines += token_parts(t) + [
        field("shared_key",     shared.hex()),
        field("signing_key",    derived[:32].hex()),
        field("encryption_key", derived[32:].hex()),
    ] + token_plaintext(t)

    # A channel envelope is six bytes of big-endian header and then the
    # message. The length it declares is not read back: Envelope.unpack
    # takes everything after the six bytes. RNS/Channel.py#unpack.
    #
    # Too short for it is the same rule the resource contexts name, for
    # the same reason: the reader is bounded by a length and not by
    # framing. cmd/dump names it in the same place.
    if h["context"] == 0x0e and plaintext is not None:
        if len(plaintext) < ENVELOPELEN:
            return lines + invalid("short-plaintext",
                                   ("minimum_length", ENVELOPELEN))
        lines += [
            field("msgtype",        plaintext[:2].hex()),
            field("sequence",       "%d" % int.from_bytes(plaintext[2:4], "big")),
            field("declared_length", "%d" % int.from_bytes(plaintext[4:6], "big")),
            field("message",        hexf(plaintext[ENVELOPELEN:])),
        ]

    # A request is a three-element array and a response a two-element
    # one, both msgpack and neither with a length or type byte of its
    # own around it. The array header is one byte and everything inside
    # it carries its own length, so an empty plaintext is the one case
    # msgpack cannot report on. RNS/Link.py#unpacked_request,
    # RNS/Link.py#packed_response.
    if h["context"] in (0x09, 0x0a) and plaintext is not None:
        if len(plaintext) < 1:
            return lines + invalid("short-plaintext", ("minimum_length", 1))
        if h["context"] == 0x09:
            parts = msgpack_elements(plaintext, 3)
            lines += [
                field("request_time",      hexf(parts[0])),
                field("request_path_hash", hexf(parts[1])),
                field("request_data",      hexf(parts[2])),
            ]
        else:
            parts = msgpack_elements(plaintext, 2)
            lines += [
                field("request_id",    hexf(parts[0])),
                field("response_data", hexf(parts[1])),
            ]

    if plaintext is not None:
        lines += describe_resource(h["context"], plaintext)

    # An identify proof names the initiator, which nothing else on a
    # link does. Its signature covers the link id, so it cannot be
    # replayed onto another link. RNS/Link.py#signed_data.
    #
    # The length is a rule and not a bound: the reference reads the key
    # and the signature at fixed offsets and tests the whole against one
    # number, so a plaintext of any other length names nobody. The
    # number is repeated here rather than the length, which the token
    # already printed. RNS/Link.py#LINKIDENTIFY.
    if h["context"] == 0xfb and plaintext is not None:
        if len(plaintext) != KEYSIZE + SIGLEN:
            return lines + invalid("identify-length",
                                   ("required_length", KEYSIZE + SIGLEN))
        identity_public = plaintext[:KEYSIZE]
        signature       = plaintext[KEYSIZE:]
        signed_data     = link_id + identity_public
        lines += [
            field("identity_public",    identity_public.hex()),
            field("identity_hash",      hashlib.sha256(identity_public).digest()[:ADDRLEN].hex()),
            field("identity_signed",    signed_data.hex()),
            field("identity_valid",     "yes" if verify(identity_public[KEYHALF:], signature, signed_data) else "no"),
        ]

    return lines


def gen_linkdata(RNS, w, verify, session):
    from RNS.vendor import umsgpack
    from RNS.Buffer import StreamDataMessage
    from RNS.Channel import Envelope, LinkChannelOutlet

    request_raw = session["request"].raw
    responder_private = session["link"].prv.private_bytes()

    # A second identity, so that the one identifying over the link is
    # plainly not the one the link was established to.
    initiator_identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[1][0]))

    # Channel.send is the sequence counter, a retry ring and a watchdog
    # around the two lines that make bytes,
    # RNS/Channel.py#reserved_sequence. Those
    # two are run here for the same reason link_session runs four lines
    # of Link.__init__: the rest reaches for an instance and produces
    # nothing. The envelope and the packet are still the reference's.
    messages = [
        StreamDataMessage(stream_id=1, data=b"reticulum"),
        StreamDataMessage(stream_id=1, data=b"", eof=True),
    ]

    with pinned(RNS, "linkdata"):
        link   = initiator_link(RNS, session)
        outlet = LinkChannelOutlet(link)
        with captured(RNS) as sent:
            RNS.Packet(link, b"reticulum").send()
            link.identify(initiator_identity)
            RNS.Packet(link, umsgpack.packb(PINNED_RTT), context=RNS.Packet.LRRTT).send()
            RNS.Packet(link, link.link_id, context=RNS.Packet.LINKCLOSE).send()
            link.send_keepalive()
            for sequence, message in enumerate(messages):
                envelope = Envelope(outlet, message=message, sequence=sequence)
                outlet.send(envelope.pack())

                # The reference must read back what it just wrote.
                read = Envelope(outlet, raw=envelope.raw)
                assert read.unpack({StreamDataMessage.MSGTYPE: StreamDataMessage}) \
                    .pack() == message.pack()
                assert read.sequence == sequence

            # Two payloads the reference's own layers never build, in
            # packets the reference itself encrypted and packed. Every
            # context above is read by a length rule, and the two here
            # are the rule broken: five bytes where an envelope header
            # is six, and nothing at all where a msgpack array starts.
            # Sent last so that no packet above depends on them.
            RNS.Packet(link, b"\xff\x00\x00\x00\x00",
                       context=RNS.Packet.CHANNEL).send()
            RNS.Packet(link, b"", context=RNS.Packet.REQUEST).send()

            # An array header announcing three elements and holding
            # none. Past the first byte msgpack bounds the read itself,
            # so this is not a rejection: the reader stops and the
            # three fields are the third meaning of the dash.
            RNS.Packet(link, b"\x93", context=RNS.Packet.REQUEST).send()

            # The same proof Link.identify assembles, signed over 16
            # zero bytes where the link id belongs: what a replay onto
            # another link carries. The signature is the reference's own
            # and verifies over the data it was made over, which is not
            # the data this link derives. RNS/Link.py#signed_data.
            elsewhere = initiator_identity.get_public_key()
            RNS.Packet(link,
                       elsewhere + initiator_identity.sign(bytes(ADDRLEN) + elsewhere),
                       context=RNS.Packet.LINKIDENTIFY).send()

            # A first byte that is no array header at all. doc/link
            # names two ways a msgpack body can hold less than the
            # context wants, and this is the second: request-truncated
            # runs out, this one never begins. Both print three dashes
            # and they are not the same defect in a reader.
            RNS.Packet(link, b"\x01", context=RNS.Packet.REQUEST).send()

            # The same byte in the other context. A request is three
            # elements and a response two, so a reader has two array
            # lengths to get right and the request vectors exercise one
            # of them. RNS/Link.py#packed_response.
            RNS.Packet(link, b"\x01", context=RNS.Packet.RESPONSE).send()

            # An identify proof one byte short of the length the
            # reference tests for. Everything in it is the reference's
            # own and the key is where a reader would look for it; the
            # signature is not all there, and the length is the only
            # thing that says so. RNS/Link.py#LINKIDENTIFY.
            short = initiator_identity.get_public_key()
            RNS.Packet(link,
                       (short + initiator_identity.sign(link.link_id + short))[:-1],
                       context=RNS.Packet.LINKIDENTIFY).send()

    cases = [
        ("minimal",   sent[0], "nine bytes of plaintext over the link"),
        ("identify",  sent[1], "the initiator names itself, signing over the link id"),
        ("rtt",       sent[2], "round trip time, msgpack encoded, sent by the initiator"),
        ("close",     sent[3], "teardown; the plaintext is the link id"),
        ("keepalive", sent[4], "one byte, and the one link packet that is not encrypted"),
        ("channel",   sent[5], "a channel message, sequence 0, inside the six-byte envelope"),
        ("channel-eof", sent[6],
         "sequence 1, and a message that is only its own two-byte header"),
        ("channel-short", sent[7],
         "five bytes of plaintext in the channel context, one short of an envelope header"),
        ("request-short", sent[8],
         "an empty plaintext in the request context, where a msgpack array is expected"),
        ("request-truncated", sent[9],
         "a msgpack array header announcing three elements over a plaintext that holds none"),
        ("identify-elsewhere", sent[10],
         "an identify proof signed over another link id, which is what a replay carries"),
        ("request-not-an-array", sent[11],
         "a one-byte plaintext that is no msgpack array header, where a request is expected"),
        ("response-not-an-array", sent[12],
         "the same plaintext in the response context, where a two-element array is expected"),
        ("identify-short", sent[13],
         "an identify proof of 127 bytes, one short of the length the reference requires"),
    ]

    # The seven above whose plaintext was chosen here rather than built
    # by a layer of the reference. They are sent through the reference
    # all the same, and the difference is in the source rather than in
    # the bytes around it. identify-elsewhere is one of them: the
    # signature in it is the reference's own, over data chosen here.
    chosen = {"channel-short", "request-short", "request-truncated",
              "identify-elsewhere", "request-not-an-array",
              "response-not-an-array", "identify-short"}

    for name, packet, purpose in cases:
        blobs = [request_raw.hex(), responder_private.hex(), packet.raw.hex()]
        described = describe_linkdata(request_raw, responder_private, packet.raw, verify)
        w.vector("linkdata", name, purpose, blobs, described,
            source=CHOSEN_SOURCE if name in chosen else GENERATED_SOURCE)

    base  = sent[0].raw
    built = derived_from(w, "linkdata", "minimal",
                    lambda r: [request_raw.hex(), responder_private.hex(), r.hex()],
                    lambda r: describe_linkdata(request_raw, responder_private, r, verify))

    built("altered-hmac", base[:-1] + bytes([base[-1] ^ 0x01]),
        "last byte of the token hmac altered; nothing is decrypted")

    # The one rejection in the corpus that happens after the header is
    # printed. A link data packet is not known to carry a token until
    # the context byte is read, so the header is printed first and the
    # length rule applies to what is left. That makes it the vector the
    # class derivation in determinism() is written against; see there.
    built("short-payload", base[:HEADER1LEN + TOKEN_OVERHEAD - 1],
        "47-byte payload, one short of an empty token, in a context that says there is one")

    # The address field is outside the token, so replacing it leaves a
    # packet that still decrypts under this link's keys and belongs to
    # another link. test/linkproof/link-id-mismatch is the same cut on
    # the packet that establishes one; this is the traffic that follows.
    built("link-id-mismatch", base[:2] + bytes(ADDRLEN) + base[2 + ADDRLEN:],
        "address field replaced with zeroes; the token opens and the packet is for another link")

    gen_request(RNS, w, verify, session, link, request_raw, responder_private)
    return link, sent[0]


REQUEST_PATH = "/vectors/echo"
EMPTY_PATH   = "/vectors/empty"


def gen_request(RNS, w, verify, session, initiator, request_raw, responder_private):
    """A request and the response to it, both msgpack over the link.

    Link.request runs whole, including the receipt it sets a timeout on.
    The response side needs a handler registered on the destination,
    because that is the only way into Link.handle_request; what the
    reference does before calling it is decrypt the packet and unpack
    it, which is done here with its own two functions.

        RNS/Link.py#request_path_hash, RNS/Link.py#getTruncatedHash
    """
    from RNS.vendor import umsgpack

    responder = session["link"]
    responder.status = RNS.Link.ACTIVE
    session["in_destination"].register_request_handler(REQUEST_PATH,
        response_generator=lambda path, data, rid, lid, ident, at: b"ok",
        allow=RNS.Destination.ALLOW_ALL)

    # The empty body, on both sides. msgpack writes it as a bin of
    # length zero where an absent one is nil, so the two differ in raw
    # and print the same "-": hex cannot spell the empty byte string.
    # A decoder that reads the length and returns before the bytes gets
    # the same line for the wrong reason.
    session["in_destination"].register_request_handler(EMPTY_PATH,
        response_generator=lambda path, data, rid, lid, ident, at: b"",
        allow=RNS.Destination.ALLOW_ALL)

    with pinned(RNS, "linkdata-request"):
        with captured(RNS) as asked:
            initiator.request(REQUEST_PATH, data=b"reticulum")
            initiator.request(REQUEST_PATH)

        packed = responder.decrypt(asked[0].raw[HEADER1LEN:])
        with captured(RNS) as answered:
            responder.handle_request(asked[0].getTruncatedHash(),
                                     umsgpack.unpackb(packed))

        # Last, so that every packet above draws the randomness it drew
        # before this pair existed. pinned() replaces both sources with
        # a counter, and an insertion anywhere earlier moves every iv
        # after it.
        with captured(RNS) as asked_empty:
            initiator.request(EMPTY_PATH, data=b"")
        with captured(RNS) as answered_empty:
            responder.handle_request(asked_empty[0].getTruncatedHash(),
                umsgpack.unpackb(responder.decrypt(asked_empty[0].raw[HEADER1LEN:])))

    asked    += asked_empty
    answered += answered_empty

    # The id in the response names the request packet, not the request.
    assert umsgpack.unpackb(packed) == umsgpack.unpackb(asked[0].data)
    assert umsgpack.unpackb(responder.decrypt(answered[0].raw[HEADER1LEN:]))[0] \
        == asked[0].getTruncatedHash()

    # msgpack_read is this program's own reading. Where umsgpack
    # exposes the same values, the two must agree.
    for packet in asked + answered:
        theirs = umsgpack.unpackb(responder.decrypt(packet.raw[HEADER1LEN:]))
        mine   = msgpack_one(responder.decrypt(packet.raw[HEADER1LEN:]))
        if packet.context == RNS.Packet.REQUEST:
            assert struct.unpack(">d", mine[0])[0] == theirs[0]
            assert mine[1:] == theirs[1:]
        else:
            assert mine == theirs

    cases = [
        ("request", asked[0],
         "a request: the time, the hash of the path, and the data"),
        ("request-no-data", asked[1],
         "a request with no data, which msgpack writes as nil"),
        ("request-empty-data", asked[2],
         "a request whose body is the empty byte string, which msgpack writes as a bin of length zero"),
        ("response", answered[0],
         "the answer, naming the request by the truncated hash of its packet"),
        ("response-empty-data", answered[1],
         "an answer whose body is the empty byte string; the dash a body of nil would also print"),
    ]
    for name, packet, purpose in cases:
        w.vector("linkdata", name, purpose,
            [request_raw.hex(), responder_private.hex(), packet.raw.hex()],
            describe_linkdata(request_raw, responder_private, packet.raw, verify))


@contextlib.contextmanager
def inline_threads(RNS):
    """Resource.receive_part assembles in a thread, and assemble is what
    sends the proof. Run the target where it is started, so that the
    packet lands inside captured() rather than after it.

        RNS/Resource.py#assemble
    """
    import threading

    real = threading.Thread

    class Inline:
        def __init__(self, target=None, daemon=None, **kw):
            self.target = target

        def start(self):
            self.target()

    threading.Thread = Inline
    try:
        yield
    finally:
        threading.Thread = real


def resource_transfer(RNS, tag, data, complete=True, metadata=None):
    """One resource, carried from advertisement to proof.

    Every packet is the reference's own. What is replaced is the
    scheduling around it: the watchdog that would retransmit, and the
    thread assembly runs in. Neither shapes a byte.

    The receiver asks for the next window from inside receive_part as
    well as from request_next, so the driver takes whatever was sent
    rather than assuming which call sent it.
    """
    ResMod = sys.modules["RNS.Resource"]
    real_watchdog = ResMod.Resource.watchdog_job
    ResMod.Resource.watchdog_job = lambda self: None

    session = link_session(RNS, tag)
    sender  = session["link"]
    sender.status = RNS.Link.ACTIVE
    receiver = initiator_link(RNS, session)
    receiver.status = RNS.Link.ACTIVE

    seen = {}

    def keep(packets):
        """First of each context, and the exhausted part request too:
        the flag is the one field of that packet with two states."""
        for packet in packets:
            seen.setdefault(packet.context, packet)
            if packet.context == RNS.Packet.RESOURCE_REQ and packet.data[0]:
                seen.setdefault("exhausted", packet)

    try:
        with pinned(RNS, tag + "-resource"), inline_threads(RNS):
            with captured(RNS) as out:
                resource = RNS.Resource(data, sender, auto_compress=False,
                                        metadata=metadata)
            advertisement = out[0]
            advertisement.link = receiver
            advertisement.plaintext = receiver.decrypt(advertisement.raw[HEADER1LEN:])
            keep(out)

            with captured(RNS) as out:
                incoming = ResMod.Resource.accept(advertisement, callback=lambda r: None)
            keep(out)

            # Either end sends a cancel only while it still believes the
            # transfer is running, so the two of them come from a
            # resource that is not carried to the end.
            if not complete:
                for end in (resource, incoming):
                    with captured(RNS) as out:
                        end.cancel()
                    keep(out)
                return session, resource, seen

            pending = [p for p in out if p.context == RNS.Packet.RESOURCE_REQ]
            while pending:
                request, pending = pending[0], []

                with captured(RNS) as answer:
                    resource.request(sender.decrypt(request.raw[HEADER1LEN:]))
                keep(answer)

                for packet in answer:
                    if packet.context == RNS.Packet.RESOURCE_HMU:
                        incoming.hashmap_update_packet(
                            receiver.decrypt(packet.raw[HEADER1LEN:]))
                        continue
                    if packet.context != RNS.Packet.RESOURCE:
                        continue
                    packet.link = receiver
                    packet.plaintext = packet.data
                    with captured(RNS) as more:
                        incoming.receive_part(packet)
                    keep(more)
                    pending += [p for p in more
                                if p.context == RNS.Packet.RESOURCE_REQ]

                if incoming.status == ResMod.Resource.COMPLETE:
                    break
                if not pending:
                    with captured(RNS) as out:
                        incoming.request_next()
                    keep(out)
                    pending = [p for p in out
                               if p.context == RNS.Packet.RESOURCE_REQ]
    finally:
        ResMod.Resource.watchdog_job = real_watchdog

    return session, resource, seen


def gen_linkpacketproof(RNS, w, verify, session, link, proved):
    """A delivery proof on a link, which the two ends sign differently.

    Link.__init__ gives the initiator a fresh Ed25519 key and gives the
    responder the identity key of the destination, RNS/Link.py#X25519PrivateKey
    and RNS/Link.py#X25519PrivateKey. prove_packet signs with
    whichever of the two the end holds, so a proof from the initiator
    verifies under a key that is in the link request and a proof from
    the responder verifies under a key that is in an announce. Nothing
    in either packet says which.

    Neither is encrypted, and both are the 96-byte explicit form:
    prove_packet has the implicit branch commented out.

        RNS/Packet.py#PROOF, RNS/Link.py#prove_packet
    """
    with pinned(RNS, "linkpacketproof"):
        # The responder proves the initiator's packet, and then the
        # initiator proves one of the responder's, so that both keys are
        # exercised over the same link.
        with captured(RNS) as sent:
            session["link"].prove_packet(proved)
            RNS.Packet(session["link"], b"reticulum").send()
        from_responder = sent[0]
        responder_data = sent[1]

        with captured(RNS) as sent:
            link.prove_packet(responder_data)
        from_initiator = sent[0]

    cases = [
        ("link-responder", proved, session["identity"].get_public_key()[KEYHALF:],
         from_responder,
         "the responder proves; the signer is the identity of the destination"),
        ("link-initiator", responder_data, link.sig_pub_bytes, from_initiator,
         "the initiator proves; the signer is the key it drew for this link"),
    ]

    for name, packet, signer, proof, purpose in cases:
        assert len(proof.raw[19:]) == 32 + SIGLEN
        assert len(signer) == KEYHALF

        described = describe_proof(packet.raw, signer, proof.raw, verify)
        assert lookup_field(described, "signature_valid") == "yes"

        w.vector("proof", name, purpose,
            [packet.raw.hex(), signer.hex(), proof.raw.hex()],
            described)

    # The key each end holds for the other is the key the other signs
    # with, and they are not the same key.
    assert session["link"].sig_pub_bytes != link.sig_pub_bytes
    assert link.peer_sig_pub_bytes == session["identity"].get_public_key()[KEYHALF:]
    assert session["link"].peer_sig_pub_bytes == link.sig_pub_bytes


def lookup_field(lines, name):
    for line in lines:
        if line.startswith(name + " "):
            return line.split(None, 1)[1]
    raise KeyError(name)


def hkdf_sha256(length, ikm, salt, context=b""):
    """RFC 5869, which is what RNS/Cryptography/HKDF.py#hkdf implements."""
    import hmac as _hmac

    def mac(key, data):
        return _hmac.new(key, data, hashlib.sha256).digest()

    prk = mac(salt if salt else bytes(32), ikm)
    block, derived = b"", b""
    for i in range((length + 31) // 32):
        block = mac(prk, block + context + bytes([(i + 1) % 256]))
        derived += block
    return derived[:length]


def check_hkdf(RNS):
    """The one function above that RNS also offers.

    expect is asserted against RNS wherever RNS exposes something to
    assert against, and here it does. Two lengths, because the second
    block is where an implementation of RFC 5869 goes wrong.
    """
    for length in (32, 64):
        assert hkdf_sha256(length, b"ikm", b"salt") == \
            RNS.Cryptography.hkdf(length=length, derive_from=b"ikm",
                                  salt=b"salt", context=None)


def token_open(payload, key):
    """iv || ciphertext || hmac, opened with a 64-byte or 32-byte key.

    A packet to a destination, a packet to a group and a packet on a
    link differ only in where the key came from, which is the whole of
    what the three kinds do not share. cmd/dump has the same function.

    A key of None means no key agreement was possible: the token is
    still laid out, because its three parts are in the packet, but no
    verdict about it can be reached.

        RNS/Cryptography/Token.py#decrypt
    """
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    import hmac as _hmac

    t = {"iv": payload[:16], "ciphertext": payload[16:-32], "mac": payload[-32:],
         "mac_ok": None, "plaintext": None}
    if key is None:
        return t

    # The key splits in half whatever its length, and the length of the
    # second half is what selects AES-128 or AES-256. The hmac is 32
    # bytes either way. RNS/Cryptography/Token.py#_signing_key.
    half = len(key) // 2
    signing_key, encryption_key = key[:half], key[half:]
    t["mac_ok"] = _hmac.compare_digest(
        t["mac"], _hmac.new(signing_key, t["iv"] + t["ciphertext"],
                            hashlib.sha256).digest())

    if t["mac_ok"] and len(t["ciphertext"]) > 0 and len(t["ciphertext"]) % 16 == 0:
        dec = Cipher(algorithms.AES(encryption_key), modes.CBC(t["iv"])).decryptor()
        padded = dec.update(t["ciphertext"]) + dec.finalize()
        # The upper bound is the only one the reference applies.
        # RNS/Cryptography/PKCS7.py#bs
        n = padded[-1]
        if n <= 16:
            t["plaintext"] = padded[:len(padded) - n]

    return t


def token_parts(t):
    return [
        field("iv",         t["iv"].hex()),
        field("ciphertext", t["ciphertext"].hex()),
        field("hmac",       t["mac"].hex()),
    ]


def token_plaintext(t):
    plaintext = t["plaintext"]
    return [
        field("hmac_valid",       "-" if t["mac_ok"] is None
                                  else ("yes" if t["mac_ok"] else "no")),
        field("plaintext_length", "-" if plaintext is None else "%d" % len(plaintext)),
        field("plaintext",        plaintext.hex() if plaintext else "-"),
    ]


def describe_encrypted(raw, private, ratchet_private):
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey, X25519PublicKey

    # The two input blobs are echoed so that expect holds every byte of
    # raw. Without them the vector could be decoded but not rebuilt.
    echo = [
        field("recipient_private", private.hex()),
        field("ratchet_private",
              ratchet_private.hex() if ratchet_private is not None else "-"),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) < KEYHALF + TOKEN_OVERHEAD:
        return echo + invalid("short-payload",
                              ("payload_length", len(payload)),
                              ("minimum_length", KEYHALF + TOKEN_OVERHEAD))

    ephemeral     = payload[:KEYHALF]
    public_key    = private_to_public(private)
    identity_hash = hashlib.sha256(public_key).digest()[:ADDRLEN]

    # The salt is always the recipient's identity hash, including when
    # the shared secret came from a ratchet. RNS/Identity.py#get_salt.
    if ratchet_private is not None:
        agree_with = ratchet_private
        ratchet_public = X25519PrivateKey.from_private_bytes(ratchet_private) \
            .public_key().public_bytes_raw()
    else:
        agree_with = private[:KEYHALF]
        ratchet_public = None

    # X25519 against a point of small order yields an all-zero secret,
    # which the pinned backend raises on rather than returning. Nothing
    # about the token can then be decided, and its three parts are still
    # in the packet. The internal fallback returns the zero secret and
    # carries on; see doc/encryption.
    try:
        shared = X25519PrivateKey.from_private_bytes(agree_with).exchange(
            X25519PublicKey.from_public_bytes(ephemeral))
    except ValueError:
        shared = None

    derived = hkdf_sha256(64, shared, identity_hash) if shared is not None else None
    t = token_open(payload[KEYHALF:], derived)

    return lines + [
        field("ephemeral_public", ephemeral.hex()),
    ] + token_parts(t) + [
        field("identity_hash",   identity_hash.hex()),
        field("ratchet_public",  ratchet_public.hex() if ratchet_public else "-"),
        field("shared_key",      "-" if shared is None else shared.hex()),
        field("signing_key",     "-" if derived is None else derived[:32].hex()),
        field("encryption_key",  "-" if derived is None else derived[32:].hex()),
    ] + token_plaintext(t)


def describe_group(raw, group_key):
    """A third payload shape, and the one with no key agreement in it.

    The group key is the token key: no ephemeral key is sent, no HKDF
    runs, and the two halves are the key as it was configured. An
    implementation that derives here decrypts nothing, and one that
    does not derive for test/encrypted decrypts nothing there.
    """
    echo = [field("group_key", group_key.hex())]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) < TOKEN_OVERHEAD:
        return echo + invalid("short-payload",
                              ("payload_length", len(payload)),
                              ("minimum_length", TOKEN_OVERHEAD))

    t    = token_open(payload, group_key)
    half = len(group_key) // 2

    return lines + token_parts(t) + [
        field("signing_key",    group_key[:half].hex()),
        field("encryption_key", group_key[half:].hex()),
    ] + token_plaintext(t)


def gen_group(RNS, w):
    """Destination type 1, the one with a key nobody negotiates.

    An outbound group destination still needs an identity, because its
    hash is derived exactly as a single destination's is. The identity
    then plays no part in the encryption: the payload is a bare token
    under the shared symmetric key, with no ephemeral key in front of
    it and no derivation behind it.

        RNS/Destination.py#GROUP
    """
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[1][0]))
    plaintext = b"reticulum"

    with pinned(RNS, "group"):
        destination = RNS.Destination(identity, RNS.Destination.OUT,
                                      RNS.Destination.GROUP,
                                      "rns_unit_tests", "group")
        destination.create_keys()
        group_key = destination.get_private_key()

        packet = RNS.Packet(destination, plaintext)
        packet.pack()

    # The reference must recover what it encrypted, and the key must be
    # the token key rather than something derived from it.
    assert destination.decrypt(packet.ciphertext) == plaintext
    assert len(group_key) == KEYSIZE
    assert packet.raw[19:] == packet.ciphertext

    w.vector("group", "minimal",
        "nine bytes under a group key, no ephemeral key and no derivation",
        [group_key.hex(), packet.raw.hex()],
        describe_group(packet.raw, group_key))

    # The other key length Token accepts, and the only way to reach it.
    # A 32-byte key halves both parts: AES-128 and a 16-byte hmac key.
    # Identity encryption derives 64 bytes and create_keys writes 64, so
    # a group key typed at half that is the one door to the mode.
    # RNS/Cryptography/Token.py#_signing_key.
    short_key = bytes.fromhex(GROUP_AES128_KEY)
    assert len(short_key) == KEYSIZE // 2

    with pinned(RNS, "group-aes128"):
        aes128 = RNS.Destination(identity, RNS.Destination.OUT,
                                 RNS.Destination.GROUP,
                                 "rns_unit_tests", "group")
        aes128.load_private_key(short_key)

        short_packet = RNS.Packet(aes128, plaintext)
        short_packet.pack()

    from RNS.Cryptography.AES import AES_128_CBC
    assert aes128.prv.mode == AES_128_CBC
    assert aes128.decrypt(short_packet.ciphertext) == plaintext

    w.vector("group", "aes128",
        "a 32-byte group key, the one configuration that selects AES-128 and a 16-byte hmac key",
        [short_key.hex(), short_packet.raw.hex()],
        describe_group(short_packet.raw, short_key))

    built = derived_from(w, "group", "minimal",
                    lambda r: [group_key.hex(), r.hex()],
                    lambda r: describe_group(r, group_key))

    built("altered-hmac", packet.raw[:-1] + bytes([packet.raw[-1] ^ 0x01]),
        "last byte of the token hmac altered; nothing is decrypted")

    # One byte short of an iv and an hmac with nothing between them. A
    # group packet carries no ephemeral key, so its threshold is the
    # token overhead alone and not the one test/encrypted applies.
    built("short-payload", packet.raw[:HEADER1LEN + TOKEN_OVERHEAD - 1],
        "47-byte payload, one short of an empty token")

    # PKCS7.pad writes 1..16, so the reference cannot be asked for a
    # token with a padding length of zero, and PKCS7.unpad accepts one:
    # it applies only the upper bound, and removes nothing.
    # Everything but pad is the reference running normally, and the
    # verdict below is the reference's own. See doc/encryption.
    from RNS.Cryptography import PKCS7

    with pinned(RNS, "group-zero-padding"):
        real_pad = PKCS7.pad
        try:
            PKCS7.pad = staticmethod(lambda data, bs=16: data)
            zero = RNS.Packet(destination, b"reticulum______" + bytes(1))
            zero.pack()
        finally:
            PKCS7.pad = real_pad

    assert destination.decrypt(zero.ciphertext) == b"reticulum______" + bytes(1)

    w.vector("group", "zero-padding",
        "a padding length of zero, which the reference accepts and removes nothing for",
        [group_key.hex(), zero.raw.hex()],
        describe_group(zero.raw, group_key),
        source="python-rns 1.4.2 (b48b96e6, openssl backend), "
               "RNS/Cryptography/PKCS7.py#pad stubbed to the identity")


RESOURCE     = 0x01
RESOURCE_ADV = 0x02
RESOURCE_REQ = 0x03
RESOURCE_HMU = 0x04
RESOURCE_ICL = 0x06
RESOURCE_RCL = 0x07


def describe_resource(context, plaintext):
    """What the plaintext holds for each resource context.

    The advertisement is a msgpack map of eleven one-letter keys. The
    part request is three concatenated pieces with no framing, read by
    length. The two cancels are the resource hash by itself.

        RNS/Resource.py#dictionary, RNS/Resource.py#request_data
    """
    if context == RESOURCE_ADV:
        adv = msgpack_one(plaintext)
        # Read by key and not by position. unpack names all eleven and
        # in an order pack does not write them in, so neither the order
        # nor the count is a rule of the format, and a key that is not
        # there takes only its own field with it. A value of the wrong
        # type is the same absence: the field the key would have filled
        # is "-". RNS/Resource.py#unpack.
        if not isinstance(adv, dict):
            adv = {}

        def num(key, fmt):
            v = adv.get(key)
            return fmt % v if isinstance(v, int) else "-"

        def blob(key):
            v = adv.get(key)
            return hexf(v) if isinstance(v, (bytes, bytearray)) else "-"

        return [
            field("transfer_size",  num("t", "%d")),
            field("data_size",      num("d", "%d")),
            field("resource_parts", num("n", "%d")),
            field("resource_hash",  blob("h")),
            field("resource_random", blob("r")),
            field("original_hash",  blob("o")),
            field("segment_index",  num("i", "%d")),
            field("total_segments", num("l", "%d")),
            field("request_id",     blob("q")),
            field("resource_flags", num("f", "%02x")),
            field("hashmap",        blob("m")),
        ]

    if context == RESOURCE_REQ:
        # Read by length, with no framing to run out of, so the
        # plaintext is the only bound there is. The length itself is
        # already on the line above as plaintext_length; naming it
        # again here would put the field in the output twice.
        if len(plaintext) < 1:
            return invalid("short-plaintext", ("minimum_length", 1))
        # One value and not a boolean: the reference compares the byte
        # against HASHMAP_IS_EXHAUSTED, so every other byte, 0x01
        # included, says the hashmap is not exhausted.
        exhausted = plaintext[0] == EXHAUSTED
        need = 1 + (MAPHASHLEN if exhausted else 0) + HASHLEN
        if len(plaintext) < need:
            return invalid("short-plaintext", ("minimum_length", need))
        at = 1
        last = None
        if exhausted:
            last, at = plaintext[at:at + MAPHASHLEN], at + MAPHASHLEN
        return [
            field("hashmap_exhausted", "yes" if exhausted else "no"),
            field("last_map_hash",     hexf(last)),
            field("resource_hash",     plaintext[at:at + HASHLEN].hex()),
            field("requested_hashes",  hexf(plaintext[at + HASHLEN:])),
        ]

    if context == RESOURCE_HMU:
        # The hash is fixed width and the msgpack array follows it, so
        # one byte past the hash is the least that can be read.
        if len(plaintext) < HASHLEN + 1:
            return invalid("short-plaintext", ("minimum_length", HASHLEN + 1))
        # The array is read the way a request body is: what it does not
        # yield is "-" rather than a rejection. The hash before it is
        # fixed width and is there either way. See doc/link.
        segment, hashmap = msgpack_elements(plaintext[HASHLEN:], 2)
        return [
            field("resource_hash", plaintext[:HASHLEN].hex()),
            field("segment_index", "%d" % segment if isinstance(segment, int) else "-"),
            field("hashmap",       hexf(hashmap)),
        ]

    if context in (RESOURCE_ICL, RESOURCE_RCL):
        return [field("resource_hash", plaintext.hex())]

    return []


def describe_resourceproof(advertised, raw):
    """A proof over a resource, which is not a proof over a packet.

    Same packet type and the same 64 bytes as an implicit delivery
    proof, and neither half means there what it means here: the first
    32 name the resource and the second are a hash of its data, not a
    signature over anything. The context byte is all that says so, and
    it is why this is a kind of its own rather than a branch of proof.

        RNS/Resource.py#proof_data
    """
    echo = [field("advertised_hash", advertised.hex())]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) != 2 * HASHLEN:
        return lines + invalid("invalid-length",
                               ("payload_length", len(payload)),
                               ("accepted_length", 2 * HASHLEN))

    return lines + [
        field("resource_hash",  payload[:HASHLEN].hex()),
        field("resource_proof", payload[HASHLEN:].hex()),
        field("hash_match",     "yes" if payload[:HASHLEN] == advertised else "no"),
    ]


def gen_resource_short(RNS, w, verify, session):
    """Plaintexts too short for the context that carries them.

    A part request and a hashmap update are read by length: the first
    byte of a request decides whether four more follow it, and neither
    payload carries a length of its own. A reader that trusts the
    context byte and not the length walks off the end of the plaintext,
    and the four cases below are the four ways it can.

    No receiver sends these, and only the plaintext is chosen here.
    Everything around it is the reference's: Link.encrypt draws the
    initialisation vector and Packet.pack writes the header, so raw is
    its output as it is for every other vector of this kind.
    """
    cases = [
        ("resource-request-empty", RNS.Packet.RESOURCE_REQ, b"",
         "a part request with no bytes at all, not even the hashmap flag"),
        ("resource-request-short", RNS.Packet.RESOURCE_REQ, b"\x00",
         "the flag says the hashmap is not exhausted; the resource hash is missing"),
        ("resource-request-exhausted-short", RNS.Packet.RESOURCE_REQ,
         bytes([EXHAUSTED]) + b"\xaa" * MAPHASHLEN,
         "the flag says exhausted, so the last map hash is read and the hash is not"),
        ("resource-hashmap-update-short", RNS.Packet.RESOURCE_HMU, bytes(HASHLEN - 1),
         "a hashmap update one byte short of the resource hash it opens with"),
    ]

    link = session["link"]
    link.status = RNS.Link.ACTIVE

    with pinned(RNS, "resource-short"):
        with captured(RNS) as sent:
            for _, context, plaintext, _ in cases:
                RNS.Packet(link, plaintext, context=context).send()

    request_raw = session["request"].raw
    responder_private = link.prv.private_bytes()

    for (name, _, plaintext, purpose), packet in zip(cases, sent):
        described = describe_linkdata(request_raw, responder_private, packet.raw, verify)

        # The reference must recover the plaintext that was chosen, and
        # the vector must be the one the rule is about.
        assert link.decrypt(packet.raw[HEADER1LEN:]) == plaintext
        assert lookup_field(described, "invalid") == "short-plaintext"

        w.vector("linkdata", name, purpose,
            [request_raw.hex(), responder_private.hex(), packet.raw.hex()],
            described,
            source=CHOSEN_SOURCE)


def gen_resource_shape(RNS, w, verify, session, advertisement):
    """Plaintexts whose msgpack shape is not the one the context wants.

    An advertisement is a map of eleven one-letter keys and a hashmap
    update a two-element array, and neither is read by position. unpack
    names the eleven keys in an order pack does not write them in, so
    the order of the map is no rule of the format and neither is its
    size: a key that is not there takes its own field and no other, and
    a key that is there and has no field takes nothing at all.

        RNS/Resource.py#unpack, RNS/Resource.py#dictionary

    No sender builds any of these. Only the plaintext is chosen here,
    and the four that are msgpack at all are written by the
    reference's own umsgpack out of the values of an advertisement it
    wrote.
    """
    from RNS.vendor import umsgpack

    adv        = msgpack_one(advertisement)
    read_order = "tdnhromfilq"

    reordered = umsgpack.packb({k: adv[k] for k in read_order})
    no_hash   = umsgpack.packb({k: adv[k] for k in read_order if k != "h"})

    # A twelfth key, in the map rather than after it, so that a reader
    # which stops at the key it has no name for loses ten of the eleven
    # and not none of them. The name is two bytes and the value a
    # float64, neither of which an advertisement holds anywhere else:
    # the reference steps over both by reading the map into a
    # dictionary and asking it for eleven names.
    extra = umsgpack.packb(dict({"t": adv["t"], "tt": 1.5},
                                **{k: adv[k] for k in read_order if k != "t"}))

    # The reference must read each of these as the map it wrote, which
    # is the whole claim the two vectors make.
    unpack = sys.modules["RNS.Resource"].ResourceAdvertisement.unpack
    ours   = unpack(advertisement)

    def fields(a):
        return (a.t, a.d, a.n, a.h, a.r, a.o, a.i, a.l, a.q, a.f, a.m)

    assert len(reordered) == len(advertisement) and reordered != advertisement
    assert fields(unpack(reordered)) == fields(ours)
    assert len(extra) > len(advertisement)
    assert fields(unpack(extra)) == fields(ours)

    cases = [
        ("resource-advertisement-reordered", RNS.Packet.RESOURCE_ADV, reordered,
         "the same advertisement with its keys in the order unpack reads them"),
        ("resource-advertisement-no-hash", RNS.Packet.RESOURCE_ADV, no_hash,
         "an advertisement of ten keys; the one that is missing is the only field lost"),
        ("resource-advertisement-not-a-map", RNS.Packet.RESOURCE_ADV, b"\x01",
         "a one-byte plaintext that is no msgpack map header, where an advertisement is expected"),
        ("resource-hashmap-update-not-an-array", RNS.Packet.RESOURCE_HMU,
         adv["h"] + b"\x01",
         "a hashmap update whose resource hash is followed by no array header"),
        ("resource-advertisement-not-a-number", RNS.Packet.RESOURCE_ADV,
         umsgpack.packb(dict({k: adv[k] for k in read_order}, t="1856")),
         "an advertisement whose transfer size is a string; the ten keys after it still read"),
        ("resource-advertisement-extra-key", RNS.Packet.RESOURCE_ADV, extra,
         "a twelfth key, named in two bytes and holding a float; the eleven still read"),
    ]

    link = session["link"]
    link.status = RNS.Link.ACTIVE

    with pinned(RNS, "resource-shape"):
        with captured(RNS) as sent:
            for _, context, plaintext, _ in cases:
                RNS.Packet(link, plaintext, context=context).send()

    request_raw = session["request"].raw
    responder_private = link.prv.private_bytes()

    for (name, _, plaintext, purpose), packet in zip(cases, sent):
        described = describe_linkdata(request_raw, responder_private, packet.raw, verify)
        assert link.decrypt(packet.raw[HEADER1LEN:]) == plaintext

        w.vector("linkdata", name, purpose,
            [request_raw.hex(), responder_private.hex(), packet.raw.hex()],
            described,
            source=CHOSEN_SOURCE)


def gen_resource(RNS, w, verify):
    """The seven contexts a resource transfer uses, less one.

    A resource encrypts its data once, through the link, and then slices
    the token into parts. So a part is a slice of one token and not a
    token of its own: only the first carries the initialisation vector
    and only the last carries the hmac, and no part can be opened alone.
    The packet layer does not encrypt them either, for the same reason a
    keepalive is not encrypted.

        RNS/Resource.py#link.encrypt, RNS/Packet.py#RESOURCE
    """
    single, resource, seen = resource_transfer(RNS, "resource", b"reticulum" * 200)

    # More parts than one hashmap segment holds, which is the only way
    # to reach a request that says so and the update that answers it.
    split_session, _, split = resource_transfer(RNS, "resource-split",
                                                bytes(range(256)) * 200)

    stop_session, _, stopped = resource_transfer(RNS, "resource-cancel",
                                                 b"reticulum" * 200, complete=False)

    # The one advertisement whose flags byte is not 0x01. Metadata is
    # prepended to the data and announced by bit 5, so a decoder that
    # prints the byte and a decoder that reads the bits agree on every
    # other vector of this kind. The map is the same 11 keys either way:
    # nothing but f says the metadata is there.
    # RNS/Resource.py#has_metadata.
    meta_session, _, with_metadata = resource_transfer(
        RNS, "resource-metadata", b"reticulum" * 200,
        metadata={"filename": "reticulum.txt"})

    # Every msgpack width the format can reach, in one advertisement.
    # 100000 bytes is 216 parts, so the part count is a uint8 where
    # every other advertisement has a fixint; the two sizes pass 65536
    # and become uint32; and the hashmap is HASHMAP_MAX_LEN entries,
    # 296 bytes, which is a bin16 where every other byte string in the
    # corpus is a bin8. A decoder with no branch for those three widths
    # passes every other vector here and fails the first resource of
    # any size. RNS/Resource.py#HASHMAP_MAX_LEN.
    #
    # The transfer is not carried to the end: only the advertisement is
    # wanted, and 216 parts through the driver buy nothing else.
    large_session, _, large = resource_transfer(
        RNS, "resource-large", bytes(range(256)) * 390 + bytes(160),
        complete=False)

    cases = [
        (single, seen[RNS.Packet.RESOURCE_ADV], "resource-advertisement",
         "the msgpack map that opens a transfer"),
        (single, seen[RNS.Packet.RESOURCE], "resource-part",
         "one part, a slice of the token the whole resource was encrypted to"),
        (single, seen[RNS.Packet.RESOURCE_REQ], "resource-request",
         "a part request: the hashmap flag, the resource hash, and four-byte map hashes"),
        (split_session, split["exhausted"], "resource-request-exhausted",
         "the receiver has asked for every hash it was given and names the last"),
        (split_session, split[RNS.Packet.RESOURCE_HMU], "resource-hashmap-update",
         "the next segment of the hashmap, which no advertisement had room for"),
        (stop_session, stopped[RNS.Packet.RESOURCE_ICL], "resource-cancel",
         "the sender gives up; the payload is the resource hash"),
        (stop_session, stopped[RNS.Packet.RESOURCE_RCL], "resource-cancel-receiver",
         "the receiver gives up, with the same payload and a different context"),
        (meta_session, with_metadata[RNS.Packet.RESOURCE_ADV],
         "resource-advertisement-metadata",
         "an advertisement whose resource carries metadata, which is bit 5 of the flags byte"),
        (large_session, large[RNS.Packet.RESOURCE_ADV],
         "resource-advertisement-large",
         "100000 bytes: the sizes as msgpack uint32, the part count as uint8, and a full hashmap as bin16"),
    ]
    # msgpack_read is this program's own reading. The advertisement is
    # the one resource payload the reference will read back, so it is
    # read back.
    adv = seen[RNS.Packet.RESOURCE_ADV]
    theirs = sys.modules["RNS.Resource"].ResourceAdvertisement.unpack(adv.data)
    mine = msgpack_one(adv.data)
    assert (mine["t"], mine["d"], mine["n"], mine["h"], mine["r"], mine["o"],
            mine["i"], mine["l"], mine["q"], mine["f"], mine["m"]) == \
           (theirs.t, theirs.d, theirs.n, theirs.h, theirs.r, theirs.o,
            theirs.i, theirs.l, theirs.q, theirs.f, theirs.m)

    for session, packet, name, purpose in cases:
        request_raw = session["request"].raw
        responder_private = session["link"].prv.private_bytes()
        w.vector("linkdata", name, purpose,
            [request_raw.hex(), responder_private.hex(), packet.raw.hex()],
            describe_linkdata(request_raw, responder_private, packet.raw, verify))

    gen_resource_short(RNS, w, verify, single)
    gen_resource_shape(RNS, w, verify, single, adv.data)

    proof = seen[RNS.Packet.RESOURCE_PRF]
    assert proof.data[:HASHLEN] == resource.hash
    assert proof.data[HASHLEN:] == resource.expected_proof
    w.vector("resourceproof", "complete",
        "the receiver has the whole resource and hashes it back",
        [resource.hash.hex(), proof.raw.hex()],
        describe_resourceproof(resource.hash, proof.raw))

    # A resource proof has one accepted length where a delivery proof
    # has two, and the two kinds are the same packet type at a different
    # context byte. A decoder that reads 63 bytes here as an implicit
    # delivery proof has taken a hash for a signature.
    built = derived_from(w, "resourceproof", "complete",
                    lambda r: [resource.hash.hex(), r.hex()],
                    lambda r: describe_resourceproof(resource.hash, r))

    built("invalid-length", proof.raw[:-1],
        "63-byte payload, one short of the resource hash and its proof")

    # The payload names a resource and hashes its data, and only the
    # name can be checked against anything the reader holds. A receiver
    # answering about a resource it was never advertised is the one case
    # that separates a decoder comparing the two halves from one
    # printing yes.
    built("hash-mismatch",
        proof.raw[:HEADER1LEN] + bytes([proof.raw[HEADER1LEN] ^ 0x01]) + proof.raw[HEADER1LEN+1:],
        "first byte of the named resource hash altered; the proof is for another resource")


def private_to_public(private):
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    x = X25519PrivateKey.from_private_bytes(private[:KEYHALF]).public_key().public_bytes_raw()
    e = Ed25519PrivateKey.from_private_bytes(private[KEYHALF:]).public_key().public_bytes_raw()
    return x + e


def encrypted_raw(RNS, key_index, aspects, plaintext, use_ratchet, tag):
    private   = bytes.fromhex(UPSTREAM_KEYS[key_index][0])
    recipient = RNS.Identity.from_bytes(private)

    # An outbound destination holds only the public key, as a sender does.
    public_only = RNS.Identity(create_keys=False)
    public_only.load_public_key(recipient.get_public_key())

    ratchet_private = None
    with pinned(RNS, tag):
        destination = RNS.Destination(public_only, RNS.Destination.OUT,
                                      RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        RNS.Identity.known_ratchets.pop(destination.hash, None)
        if use_ratchet:
            ratchet_private = RNS.Identity._generate_ratchet()
            RNS.Identity.known_ratchets[destination.hash] = \
                RNS.Identity._ratchet_public_bytes(ratchet_private)

        packet = RNS.Packet(destination, plaintext)
        packet.pack()

    # The reference implementation must recover what it encrypted.
    ratchets = [ratchet_private] if ratchet_private else None
    assert recipient.decrypt(packet.ciphertext, ratchets=ratchets) == plaintext

    return private, ratchet_private, packet.raw


def gen_encrypted(RNS, w):
    made = {}
    for name, key_index, aspects, plaintext, use_ratchet, purpose in ENCRYPTED:
        private, ratchet, raw = encrypted_raw(RNS, key_index, aspects, plaintext,
                                              use_ratchet, "encrypted-" + name)
        made[name] = (private, ratchet, raw)
        w.vector("encrypted", name, purpose,
            [private.hex(), ratchet.hex() if ratchet else "-", raw.hex()],
            describe_encrypted(raw, private, ratchet))

    private, ratchet, raw = made["minimal"]
    built = derived_from(w, "encrypted", "minimal",
                    lambda r: [private.hex(), "-", r.hex()],
                    lambda r: describe_encrypted(r, private, None))

    built("altered-hmac", raw[:-1] + bytes([raw[-1] ^ 0x01]),
        "last byte of the token hmac altered; nothing is decrypted")

    # The ephemeral key replaced with the all-zero point, which has
    # order 1. The header is 19 bytes and the key is the first 32 of the
    # payload. The pinned backend will not produce a secret from it at
    # all; the internal fallback produces the one every reader of the
    # announce can compute for themselves.
    low_order = raw[:19] + bytes(KEYHALF) + raw[19+KEYHALF:]
    assert len(low_order) == len(raw)

    from RNS.Cryptography.X25519 import X25519PrivateKey as InternalX25519
    assert InternalX25519.from_private_bytes(private[:KEYHALF]) \
        .exchange(bytes(KEYHALF)) == bytes(KEYHALF)

    built("low-order-ephemeral", low_order,
        "ephemeral key replaced with a point of small order; no shared secret exists")

    # One byte short of an ephemeral key and an empty token. This is the
    # first rule the kind applies to its own payload, and the threshold
    # is its own: an encrypted packet carries a key the other two token
    # kinds do not.
    built("short-payload", raw[:HEADER1LEN + KEYHALF + TOKEN_OVERHEAD - 1],
        "79-byte payload, one short of an ephemeral key and an empty token")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--checkout", default=CHECKOUT)
    ap.add_argument("--force", action="store_true")
    args = ap.parse_args()

    RNS    = load_rns(args.checkout)
    check_hkdf(RNS)
    w      = Writer(ROOT, args.force)
    verify = make_verifier(RNS)

    tmpdir = tempfile.mkdtemp(prefix="reticulum-vectors-")
    stub_transport(RNS, tmpdir)
    try:
        gen_identity(RNS, w)
        gen_keyset(RNS, w)
        gen_destination(RNS, w)
        gen_signature(RNS, w, verify)
        gen_sign(RNS, w)
        announce_minimal = gen_announce(RNS, w, tmpdir, verify)
        gen_plain(RNS, w)
        gen_pathrequest(RNS, w)
        gen_proof(RNS, w, verify)
        gen_ifac(RNS, w, announce_minimal)
        gen_encrypted(RNS, w)
        gen_group(RNS, w)

        session = link_session(RNS, "link")
        gen_linkrequest(RNS, w, session)
        gen_linkproof(RNS, w, verify, session)
        link, proved = gen_linkdata(RNS, w, verify, session)
        gen_linkpacketproof(RNS, w, verify, session, link, proved)
        gen_resource(RNS, w, verify)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

    w.index()

    counted = [("%d identical" % w.identical)]
    if w.changed: counted.append("%d changed" % w.changed)
    if w.created: counted.append("%d new" % w.created)
    print(", ".join(counted))

    if w.differs:
        print("%d files differ and were left alone:" % len(w.differs))
        for path in w.differs:
            print("    %s" % os.path.relpath(path, ROOT))
        print("run with --force to replace them, after examining why they changed")
        sys.exit(1)

    uncrossed = w.uncrossed()
    if uncrossed:
        print("optional fields with only one case on file:")
        for name in uncrossed:
            print("    %s is absent in every vector that carries it" % name)
        sys.exit(1)


if __name__ == "__main__":
    main()

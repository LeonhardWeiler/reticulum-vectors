# The timestamp pinned into random_hash while generating. Any fixed
# value inside the five-byte field will do; this one is a round number
# well clear of both ends.
PINNED_TIME = 1750000000


class DetRandom:
    """A deterministic byte stream, so that regenerating a vector
    produces the same bytes. Consumers never see this: an announce
    carries a timestamp and cannot be re-encoded from raw alone, so
    announce vectors are decode class regardless."""

    def __init__(self, tag):
        self.seed    = tag.encode("utf-8")
        self.counter = 0
        self.buf     = b""

    def bytes(self, n):
        while len(self.buf) < n:
            self.buf += hashlib.sha256(self.seed + self.counter.to_bytes(4, "big")).digest()
            self.counter += 1
        out, self.buf = self.buf[:n], self.buf[n:]
        return out


@contextlib.contextmanager
def pinned(RNS, tag):
    """Replace every source of randomness and the clock, so that the
    generated announce is reproducible."""
    rng = DetRandom(tag)

    real_time    = time.time
    real_urandom = os.urandom
    real_rand    = RNS.Identity.get_random_hash

    time.time = lambda: float(PINNED_TIME)
    os.urandom = rng.bytes
    RNS.Identity.get_random_hash = staticmethod(lambda: rng.bytes(16))
    try:
        yield
    finally:
        time.time = real_time
        os.urandom = real_urandom
        RNS.Identity.get_random_hash = real_rand


class TransportStub:
    """Destination registration and ratchet persistence reach into a
    running Reticulum instance. Neither affects the bytes on the wire,
    so both are stubbed rather than starting an instance."""
    is_connected_to_shared_instance = False


def stub_transport(RNS):
    RNS.Transport.owner = TransportStub()
    RNS.Transport.register_destination = staticmethod(lambda d: None)
    RNS.Identity._remember_ratchet = staticmethod(lambda h, r: None)


def load_rns(checkout):
    if not os.path.isdir(os.path.join(checkout, "RNS")):
        sys.exit("no RNS package under %s" % checkout)

    sys.path.insert(0, checkout)
    import RNS

    if not os.path.abspath(RNS.__file__).startswith(os.path.abspath(checkout)):
        sys.exit("imported RNS from %s, not from the checkout" % RNS.__file__)

    if RNS.__version__ != PIN_VERSION:
        sys.exit("checkout is version %s, pin is %s" % (RNS.__version__, PIN_VERSION))

    commit = subprocess.run(["git", "-C", checkout, "rev-parse", "HEAD"],
                            capture_output=True, text=True).stdout.strip()
    if commit != PIN_COMMIT:
        sys.exit("checkout is at %s, pin is %s" % (commit, PIN_COMMIT))

    return RNS


def field(name, value):
    return "%-*s %s" % (FIELD_WIDTH, name, value)


def meta_block(kind, determinism, purpose, source=GENERATED_SOURCE):
    return [
        field("source", source),
        field("generated", datetime.date.today().isoformat()),
        field("kind", kind),
        field("determinism", determinism),
        field("purpose", purpose),
    ]


class Writer:
    def __init__(self, root, force):
        self.root    = root
        self.force   = force
        self.written = 0
        self.differs = []

    def vector(self, kind, index, meta, raw, expect):
        path = os.path.join(self.root, "test", kind, "%03d" % index)
        os.makedirs(path, exist_ok=True)
        self.file(os.path.join(path, "meta"), meta)
        self.file(os.path.join(path, "raw"), raw)
        self.file(os.path.join(path, "expect"), expect)

    def file(self, path, lines):
        body = "\n".join(lines) + "\n"
        if os.path.exists(path) and not self.force:
            with open(path) as f:
                if f.read() != body:
                    self.differs.append(path)
                    return
        with open(path, "w") as f:
            f.write(body)
        self.written += 1


def identity_vector(RNS, w, index, private_hex, purpose, source):
    """One identity vector.

    raw is the public key, not the private key. Deriving a public key
    from a private one is X25519 and Ed25519, standard primitives with
    their own published vectors; this corpus does not restate them.
    What is specific to Reticulum is the concatenation order and the
    hash, and those are what the vector pins.

    The private-to-public derivation is covered separately by the
    keyset vectors, which are generated once dump can verify them.
    """
    identity = RNS.Identity.from_bytes(bytes.fromhex(private_hex))

    public = identity.get_public_key()
    half   = RNS.Identity.KEYSIZE // 8 // 2

    w.vector("identity", index,
        meta_block("identity", "encode", purpose, source=source),
        [public.hex()],
        [
            field("public_key",     public.hex()),
            field("x25519_public",  public[:half].hex()),
            field("ed25519_public", public[half:].hex()),
            field("identity_hash",  identity.hash.hex()),
        ])

    return identity


def gen_identity(RNS, w):
    for n, (private_hex, hash_hex) in enumerate(UPSTREAM_KEYS):
        identity = identity_vector(RNS, w, n, private_hex,
            "public key of upstream key %d" % n,
            UPSTREAM_KEY_SOURCE)

        # The upstream table is the source of truth for these two values.
        # Everything else is derived here and must agree with it.
        assert identity.get_private_key() == bytes.fromhex(private_hex)
        assert identity.hash == bytes.fromhex(hash_hex)

    # The clamping pair belongs to the keyset vectors, which record the
    # private-to-public derivation. As identity vectors the two would be
    # byte-identical, since that is exactly the property they record.
    # The assertion is kept here so the property is checked on every
    # run, and the vectors follow when dump can verify them.
    a = RNS.Identity.from_bytes(bytes.fromhex(EXTRA_KEYS[0][0]))
    b = RNS.Identity.from_bytes(bytes.fromhex(EXTRA_KEYS[1][0]))
    assert a.get_private_key() != b.get_private_key()
    assert a.get_public_key()  == b.get_public_key()
    assert a.hash              == b.hash


def gen_destination(RNS, w):
    for n, (aspects, key_index, purpose) in enumerate(DESTINATIONS):
        app_name = aspects[0]
        rest     = aspects[1:]

        name       = RNS.Destination.expand_name(None, app_name, *rest)
        name_bytes = name.encode("utf-8")
        name_hash  = RNS.Identity.full_hash(name_bytes)[:RNS.Identity.NAME_HASH_LENGTH // 8]

        if key_index is None:
            identity      = None
            identity_hash = None
        else:
            identity      = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))
            identity_hash = identity.hash

        destination_hash = RNS.Destination.hash(identity, app_name, *rest)

        expect = [field("name", name), field("app_name", app_name)]
        for aspect in rest:
            expect.append(field("aspect", aspect))
        expect.append(field("name_hash", name_hash.hex()))
        expect.append(field("identity_hash", identity_hash.hex() if identity_hash else "-"))
        expect.append(field("destination_hash", destination_hash.hex()))

        w.vector("destination", n,
            meta_block("destination", "encode", purpose),
            [name_bytes.hex(), identity_hash.hex() if identity_hash else "-"],
            expect)


DEST_TYPES   = ["single", "group", "plain", "link"]
PACKET_TYPES = ["data", "announce", "linkrequest", "proof"]
XPORT_TYPES  = ["broadcast", "transport", "relay", "tunnel"]
CONTEXTS     = {0x00: "none", 0x0b: "path_response"}

KEYSIZE     = 64
NAMEHASHLEN = 10
RANDHASHLEN = 10
SIGLEN      = 64
RATCHETLEN  = 32
ADDRLEN     = 16
MAX_HOPS    = 128       # RNS.Transport.PATHFINDER_M


def describe_announce(raw):
    """Decode an announce packet from its bytes alone.

    This deliberately does not consult any RNS object. gen and dump are
    then two independent decoders of the same bytes, and check compares
    them. A misreading of the layout on one side shows up as a diff.
    """
    if len(raw) < 2:
        return [field("invalid", "length")]

    flags, hops = raw[0], raw[1]

    header_type      = (flags & 0b01000000) >> 6
    context_flag     = (flags & 0b00100000) >> 5
    transport_type   = (flags & 0b00010000) >> 4
    destination_type = (flags & 0b00001100) >> 2
    packet_type      = (flags & 0b00000011)

    if hops >= MAX_HOPS:
        return [field("invalid", "hops")]

    if header_type == 1:
        need = 2 + 2*ADDRLEN + 1
        if len(raw) < need:
            return [field("invalid", "length")]
        transport_id = raw[2:2+ADDRLEN]
        dest_hash    = raw[2+ADDRLEN:2+2*ADDRLEN]
        context      = raw[2+2*ADDRLEN]
        payload      = raw[3+2*ADDRLEN:]
    else:
        need = 2 + ADDRLEN + 1
        if len(raw) < need:
            return [field("invalid", "length")]
        transport_id = None
        dest_hash    = raw[2:2+ADDRLEN]
        context      = raw[2+ADDRLEN]
        payload      = raw[3+ADDRLEN:]

    minimum = KEYSIZE + NAMEHASHLEN + RANDHASHLEN + SIGLEN
    if context_flag == 1:
        minimum += RATCHETLEN
    if len(payload) < minimum:
        return [field("invalid", "length")]

    at          = 0
    public_key  = payload[at:at+KEYSIZE];      at += KEYSIZE
    name_hash   = payload[at:at+NAMEHASHLEN];  at += NAMEHASHLEN
    random_hash = payload[at:at+RANDHASHLEN];  at += RANDHASHLEN
    if context_flag == 1:
        ratchet = payload[at:at+RATCHETLEN];   at += RATCHETLEN
    else:
        ratchet = b""
    signature   = payload[at:at+SIGLEN];       at += SIGLEN
    app_data    = payload[at:]

    identity_hash = hashlib.sha256(public_key).digest()[:ADDRLEN]
    expected_hash = hashlib.sha256(name_hash + identity_hash).digest()[:ADDRLEN]

    # app_data is transmitted after the signature but signed before it.
    signed_data = dest_hash + public_key + name_hash + random_hash + ratchet + app_data

    return [
        field("flags",            "%02x" % flags),
        field("header_type",      "%d" % (header_type + 1)),
        field("context_flag",     "set" if context_flag else "unset"),
        field("transport_type",   XPORT_TYPES[transport_type]),
        field("destination_type", DEST_TYPES[destination_type]),
        field("packet_type",      PACKET_TYPES[packet_type]),
        field("hops",             "%d" % hops),
        field("transport_id",     transport_id.hex() if transport_id else "-"),
        field("destination_hash", dest_hash.hex()),
        field("context",          CONTEXTS.get(context, "%02x" % context)),
        field("payload_length",   "%d" % len(payload)),
        field("public_key",       public_key.hex()),
        field("name_hash",        name_hash.hex()),
        field("random_hash",      random_hash.hex()),
        field("ratchet",          ratchet.hex() if ratchet else "-"),
        field("signature",        signature.hex()),
        field("app_data",         app_data.hex() if app_data else "-"),
        field("identity_hash",    identity_hash.hex()),
        field("expected_hash",    expected_hash.hex()),
        field("destination_match", "yes" if dest_hash == expected_hash else "no"),
        field("signed_data",      signed_data.hex()),
    ]


def announce_raw(RNS, key_index, aspects, app_data, ratchet, path_response, tag, tmpdir):
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))

    with pinned(RNS, tag):
        destination = RNS.Destination(identity, RNS.Destination.IN,
                                      RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        if ratchet:
            destination.enable_ratchets(os.path.join(tmpdir, tag))

        packet = destination.announce(app_data=app_data, path_response=path_response, send=False)
        packet.pack()

    # The reference implementation must accept what it produced.
    assert RNS.Identity.validate_announce(packet)
    return packet.raw


def transport_insert(raw, hops, transport_id):
    """Rewrite a header 1 packet as a header 2 packet in transport,
    exactly as Transport.mangle_hops does at RNS/Transport.py:1369."""
    flags = raw[0] | (0x01 << 6) | (0x01 << 4)
    return bytes([flags, hops]) + transport_id + raw[2:]


def gen_announce(RNS, w, tmpdir):
    stub_transport(RNS)
    raws = []

    for n, (key_index, aspects, app_data, ratchet, path_response, purpose) in enumerate(ANNOUNCES):
        raw = announce_raw(RNS, key_index, aspects, app_data, ratchet,
                           path_response, "announce-%03d" % n, tmpdir)
        raws.append(raw)
        w.vector("announce", n,
            meta_block("announce", "decode", purpose),
            [raw.hex()],
            describe_announce(raw))

    base = len(ANNOUNCES)
    transport_id = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0])).hash

    # Derived cases. Each states in its source how it was built, since
    # none of them is something the reference implementation emitted.
    derived = [
        (transport_insert(raws[0], 1, transport_id),
         "header 2, one hop, transport id inserted",
         "constructed by tools/gen from announce/000, per RNS/Transport.py:1369"),

        (raws[0][:2] + bytes(ADDRLEN) + raws[0][2+ADDRLEN:],
         "destination hash replaced with zeroes; the announce decodes but does not match",
         "constructed by tools/gen from announce/000"),

        (raws[0][:-1],
         "one byte short of the minimum payload",
         "constructed by tools/gen from announce/000"),

        (raws[0][:1] + bytes([MAX_HOPS]) + raws[0][2:],
         "hop count at the limit, which the reference implementation rejects",
         "constructed by tools/gen from announce/000"),
    ]

    for n, (raw, purpose, source) in enumerate(derived):
        w.vector("announce", base + n,
            meta_block("announce", "decode", purpose, source=source),
            [raw.hex()],
            describe_announce(raw))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--checkout", default=CHECKOUT)
    ap.add_argument("--force", action="store_true")
    args = ap.parse_args()

    RNS = load_rns(args.checkout)
    w   = Writer(ROOT, args.force)

    tmpdir = tempfile.mkdtemp(prefix="reticulum-vectors-")
    try:
        gen_identity(RNS, w)
        gen_destination(RNS, w)
        gen_announce(RNS, w, tmpdir)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

    print("%d files written" % w.written)
    if w.differs:
        print("%d files differ and were left alone:" % len(w.differs))
        for path in w.differs:
            print("    %s" % os.path.relpath(path, ROOT))
        print("run with --force to replace them, after examining why they changed")
        sys.exit(1)


if __name__ == "__main__":
    main()

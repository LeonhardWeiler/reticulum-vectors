def invalid(reason, *evidence):
    """A packet that cannot be decoded yields the reason and the numbers
    behind it, so a disagreement names the rule rather than the stage."""
    return [field("invalid", reason)] + [field(k, "%d" % v) for k, v in evidence]


def describe_header(raw):
    """Every packet kind starts here.

    The layout is read without consulting any RNS object, so gen and
    dump are two independent decoders of the same bytes and check
    compares them. A misreading on one side shows up as a diff.
    """
    if len(raw) < 2:
        return invalid("short-header", ("length", len(raw)), ("minimum_length", 2)), None

    flags, hops = raw[0], raw[1]

    header_type      = (flags & 0b01000000) >> 6
    context_flag     = (flags & 0b00100000) >> 5
    transport_type   = (flags & 0b00010000) >> 4
    destination_type = (flags & 0b00001100) >> 2
    packet_type      = (flags & 0b00000011)

    if hops >= MAX_HOPS:
        return invalid("hop-limit", ("hops", hops), ("hop_limit", MAX_HOPS)), None

    header_len = 3 + ADDRLEN * (header_type + 1)
    if len(raw) < header_len:
        return invalid("short-header", ("length", len(raw)), ("minimum_length", header_len)), None

    if header_type == 1:
        transport_id = raw[2:2+ADDRLEN]
        dest_hash    = raw[2+ADDRLEN:2+2*ADDRLEN]
        context      = raw[2+2*ADDRLEN]
    else:
        transport_id = None
        dest_hash    = raw[2:2+ADDRLEN]
        context      = raw[2+ADDRLEN]
    payload = raw[header_len:]

    lines = [
        field("flags",            "%02x" % flags),
        field("header_type",      "%d" % (header_type + 1)),
        field("context_flag",     "set" if context_flag else "unset"),
        field("transport_type",   XPORT_TYPES[transport_type]),
        field("destination_type", DEST_TYPES[destination_type]),
        field("packet_type",      PACKET_TYPES[packet_type]),
        field("hops",             "%d" % hops),
        field("transport_id",     transport_id.hex() if transport_id else "-"),
        field("destination_hash", dest_hash.hex()),
        field("context",          CONTEXTS.get(context, "%02x" % context)),
        field("payload_length",   "%d" % len(payload)),
    ]
    return lines, {"payload": payload, "context_flag": context_flag,
                   "dest_hash": dest_hash, "context": context}


def describe_announce(raw, verify):
    lines, h = describe_header(raw)
    if h is None:
        return lines

    payload      = h["payload"]
    context_flag = h["context_flag"]
    dest_hash    = h["dest_hash"]

    minimum = KEYSIZE + NAMEHASHLEN + RANDHASHLEN + SIGLEN
    if context_flag == 1:
        minimum += RATCHETLEN
    if len(payload) < minimum:
        return invalid("short-payload",
                       ("payload_length", len(payload)), ("minimum_length", minimum))

    at          = 0
    public_key  = payload[at:at+KEYSIZE];      at += KEYSIZE
    name_hash   = payload[at:at+NAMEHASHLEN];  at += NAMEHASHLEN
    random_hash = payload[at:at+RANDHASHLEN];  at += RANDHASHLEN
    if context_flag == 1:
        ratchet = payload[at:at+RATCHETLEN];   at += RATCHETLEN
    else:
        ratchet = b""
    signature   = payload[at:at+SIGLEN];       at += SIGLEN
    app_data    = payload[at:]

    identity_hash = hashlib.sha256(public_key).digest()[:ADDRLEN]
    expected_hash = hashlib.sha256(name_hash + identity_hash).digest()[:ADDRLEN]

    # app_data is transmitted after the signature but signed before it.
    signed_data = dest_hash + public_key + name_hash + random_hash + ratchet + app_data

    return lines + [
        field("public_key",       public_key.hex()),
        field("name_hash",        name_hash.hex()),
        field("random_hash",      random_hash.hex()),
        field("ratchet",          ratchet.hex() if ratchet else "-"),
        field("signature",        signature.hex()),
        field("app_data",         app_data.hex() if app_data else "-"),
        field("identity_hash",    identity_hash.hex()),
        field("expected_hash",    expected_hash.hex()),
        field("destination_match", "yes" if dest_hash == expected_hash else "no"),
        field("signed_data",      signed_data.hex()),
        field("signature_valid",  "yes" if verify(public_key[32:], signature, signed_data) else "no"),
    ]


def announce_raw(RNS, key_index, aspects, app_data, ratchet, path_response, tag, tmpdir):
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))

    with pinned(RNS, tag):
        destination = RNS.Destination(identity, RNS.Destination.IN,
                                      RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        if ratchet:
            destination.enable_ratchets(os.path.join(tmpdir, tag))

        packet = destination.announce(app_data=app_data, path_response=path_response, send=False)
        packet.pack()

    # The reference implementation must accept what it produced.
    assert RNS.Identity.validate_announce(packet)
    return packet.raw


def transport_insert(raw, hops, transport_id):
    """Rewrite a header 1 packet as a header 2 packet in transport,
    exactly as Transport.mangle_hops does at RNS/Transport.py:1369."""
    flags = raw[0] | (0x01 << 6) | (0x01 << 4)
    return bytes([flags, hops]) + transport_id + raw[2:]


def gen_announce(RNS, w, tmpdir, verify):
    raws = {}

    for name, key_index, aspects, app_data, ratchet, path_response, purpose in ANNOUNCES:
        raw = announce_raw(RNS, key_index, aspects, app_data, ratchet,
                           path_response, "announce-" + name, tmpdir)
        raws[name] = raw
        w.vector("announce", name, purpose,
            [raw.hex()],
            describe_announce(raw, verify))

    base         = raws["minimal"]
    transport_id = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[2][0])).hash

    # Derived cases. Each states in its source how it was built, since
    # none of them is something the reference implementation emitted.
    derived = [
        ("in-transport", transport_insert(base, 1, transport_id),
         "header 2, one hop, transport id inserted",
         "constructed by tools/gen from announce/minimal, per RNS/Transport.py:1369"),

        ("destination-mismatch", base[:2] + bytes(ADDRLEN) + base[2+ADDRLEN:],
         "destination hash replaced with zeroes; the announce decodes but does not match",
         "constructed by tools/gen from announce/minimal"),

        ("short-payload", base[:-1],
         "one byte short of the minimum payload",
         "constructed by tools/gen from announce/minimal"),

        ("hop-limit", base[:1] + bytes([MAX_HOPS]) + base[2:],
         "hop count at the limit, which the reference implementation rejects",
         "constructed by tools/gen from announce/minimal"),

        ("altered-signature",
         base[:-SIGLEN] + bytes([base[-SIGLEN] ^ 0x01]) + base[-SIGLEN+1:],
         "first signature byte altered; the announce decodes and matches, but the signature does not verify",
         "constructed by tools/gen from announce/minimal"),
    ]

    for name, raw, purpose, source in derived:
        w.vector("announce", name, purpose,
            [raw.hex()],
            describe_announce(raw, verify),
            source=source)


def hashable_part(raw, payload_len):
    """The bytes a link id is taken over, RNS/Packet.py:348 as
    RNS/Link.py:336 trims it.

    The low four flag bits and the hop count are excluded so that a
    packet keeps its link id while it travels, and any signalling bytes
    are chopped off the end so that signalling the MTU does not change
    the identity of the link.
    """
    header_type = (raw[0] & 0b01000000) >> 6
    part = bytes([raw[0] & 0x0f]) + (raw[2+ADDRLEN:] if header_type else raw[2:])
    excess = payload_len - ECPUBSIZE
    return part[:len(part)-excess] if excess > 0 else part


def describe_linkrequest(raw):
    lines, h = describe_header(raw)
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) not in (ECPUBSIZE, ECPUBSIZE + SIGNALLEN):
        return invalid("invalid-length",
                       ("payload_length", len(payload)),
                       ("accepted_length", ECPUBSIZE),
                       ("signalled_length", ECPUBSIZE + SIGNALLEN))

    signalled = len(payload) == ECPUBSIZE + SIGNALLEN
    if signalled:
        value = int.from_bytes(payload[ECPUBSIZE:], "big")
        mode  = (value >> 21) & 0x07
        mtu   = value & MTU_BYTEMASK
    else:
        mode, mtu = MODE_DEFAULT, None

    link_id = hashlib.sha256(hashable_part(raw, len(payload))).digest()[:ADDRLEN]

    return lines + [
        field("x25519_public",  payload[:KEYHALF].hex()),
        field("ed25519_public", payload[KEYHALF:ECPUBSIZE].hex()),
        field("signalling",     payload[ECPUBSIZE:].hex() if signalled else "-"),
        field("mode",           LINK_MODES.get(mode, "%02x" % mode)),
        field("mtu",            "%d" % mtu if signalled else "-"),
        field("link_id",        link_id.hex()),
    ]


@contextlib.contextmanager
def captured(RNS):
    """Packet.send hands the packet to Transport, which is not running.
    The corpus wants the bytes, so send packs and records instead."""
    real_send = RNS.Packet.send
    sent = []

    def send(self):
        self.pack()
        sent.append(self)
        return True

    RNS.Packet.send = send
    try:
        yield sent
    finally:
        RNS.Packet.send = real_send


def link_session(RNS, tag):
    """Establish one link, far enough to produce packets from both ends.

    The request is assembled as Link.__init__ does at RNS/Link.py:304.
    The initiator half of that constructor reaches for a running
    instance three lines earlier, so the four lines that produce bytes
    are run here instead. The responder is then built as
    validate_request builds it at RNS/Link.py:189, up to and including
    prove; what follows there registers the link and starts a watchdog,
    and produces no bytes.

    Everything that shapes a byte is the reference's own: the key
    classes Link resolves, its signalling encoder, its handshake, its
    prove, and Packet.pack.

    One pinned block covers all of it. The responder draws a key of its
    own, and it has to come from the same stream for the proof to be
    reproducible.
    """
    key_index, aspects = LINK_DESTINATION
    identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[key_index][0]))

    public_only = RNS.Identity(create_keys=False)
    public_only.load_public_key(identity.get_public_key())

    link_mod = sys.modules["RNS.Link"]
    with pinned(RNS, tag):
        out_destination = RNS.Destination(public_only, RNS.Destination.OUT,
                                          RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        prv     = link_mod.X25519PrivateKey.generate()
        sig_prv = link_mod.Ed25519PrivateKey.generate()

        signalling   = RNS.Link.signalling_bytes(RNS.Reticulum.MTU, RNS.Link.MODE_DEFAULT)
        request_data = prv.public_key().public_bytes() + \
                       sig_prv.public_key().public_bytes() + signalling

        request = RNS.Packet(out_destination, request_data,
                             packet_type=RNS.Packet.LINKREQUEST)
        request.pack()

        in_destination = RNS.Destination(identity, RNS.Destination.IN,
                                         RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        link = RNS.Link(owner=in_destination,
                        peer_pub_bytes=request_data[:KEYHALF],
                        peer_sig_pub_bytes=request_data[KEYHALF:ECPUBSIZE])
        link.set_link_id(request)
        link.mtu  = RNS.Link.mtu_from_lr_packet(request)
        link.mode = RNS.Link.mode_from_lr_packet(request)
        link.handshake()

        with captured(RNS) as sent:
            link.prove()

    return {
        "identity":       identity,
        "in_destination": in_destination,
        "prv":            prv,
        "sig_prv":        sig_prv,
        "request":        request,
        "link":           link,
        "proof":          sent[0],
    }


def initiator_link(RNS, session):
    """The initiator half, as validate_proof completes it at
    RNS/Link.py:405.

    Link.__init__ draws keys of its own, and the initiator's are already
    fixed by the request it sent, so the object is built through the
    inert constructor and then given those keys. Status is set to
    ACTIVE, which is what validate_proof does at RNS/Link.py:424 once
    the signature checks out, and what identify requires.
    """
    proof_data = session["proof"].data
    peer_ed25519 = session["identity"].get_public_key()[KEYHALF:]

    link = RNS.Link(owner=session["in_destination"])
    link.initiator     = True
    link.prv           = session["prv"]
    link.sig_prv       = session["sig_prv"]
    link.pub_bytes     = link.prv.public_key().public_bytes()
    link.sig_pub_bytes = link.sig_prv.public_key().public_bytes()
    link.set_link_id(session["request"])
    link.mtu           = session["link"].mtu
    link.mode          = session["link"].mode
    link.load_peer(proof_data[SIGLEN:SIGLEN+KEYHALF], peer_ed25519)
    link.handshake()
    link.status = RNS.Link.ACTIVE

    # The point of the handshake: two ends, no shared secret in any
    # packet, one key.
    assert link.derived_key == session["link"].derived_key
    return link


def gen_linkrequest(RNS, w, session):
    raw = session["request"].raw
    packet = session["request"]

    # The reference must agree with the decoder above about which link
    # this request opens, and about what it signalled.
    link_id = bytes.fromhex(
        lookup_field(describe_linkrequest(raw), "link_id"))
    assert link_id == RNS.Link.link_id_from_lr_packet(packet)
    assert RNS.Link.mtu_from_lr_packet(packet) == RNS.Reticulum.MTU
    assert RNS.Link.mode_from_lr_packet(packet) == RNS.Link.MODE_DEFAULT

    w.vector("linkrequest", "signalling",
        "link request as the reference emits it, mode and mtu signalled",
        [raw.hex()],
        describe_linkrequest(raw))

    # Without signalling is the shorter form validate_request still
    # accepts at RNS/Link.py:187. It opens the same link: the signalling
    # bytes are excluded from the link id.
    unsignalled = raw[:-SIGNALLEN]
    w.vector("linkrequest", "no-signalling",
        "the 64-byte form; same link id, mode falls back to the default",
        [unsignalled.hex()],
        describe_linkrequest(unsignalled),
        source="constructed by tools/gen from linkrequest/signalling")

    short = raw[:-1]
    w.vector("linkrequest", "invalid-length",
        "66-byte payload, neither of the two accepted lengths",
        [short.hex()],
        describe_linkrequest(short),
        source="constructed by tools/gen from linkrequest/signalling")


def describe_linkproof(request_raw, identity_public, raw, verify):
    """Three of the four parts that were signed are not in the packet. The
    link id comes from the request, the peer Ed25519 key from the
    identity of the destination the request was addressed to, and the
    signalling bytes are signed in the position they occupy here.
    """
    # The two input blobs are echoed so that expect holds every byte of
    # raw. Without them the vector could be decoded but not rebuilt.
    echo = [
        field("link_request",  request_raw.hex()),
        field("signer_public", identity_public.hex()),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) not in (SIGLEN + KEYHALF, SIGLEN + KEYHALF + SIGNALLEN):
        return echo + invalid("invalid-length",
                              ("payload_length", len(payload)),
                              ("accepted_length", SIGLEN + KEYHALF),
                              ("signalled_length", SIGLEN + KEYHALF + SIGNALLEN))

    _, rh = describe_header(request_raw)
    link_id = hashlib.sha256(
        hashable_part(request_raw, len(rh["payload"]))).digest()[:ADDRLEN]

    signalled  = len(payload) == SIGLEN + KEYHALF + SIGNALLEN
    signature  = payload[:SIGLEN]
    x25519     = payload[SIGLEN:SIGLEN+KEYHALF]
    signalling = payload[SIGLEN+KEYHALF:]

    if signalled:
        value = int.from_bytes(signalling, "big")
        mode  = (value >> 21) & 0x07
        mtu   = value & MTU_BYTEMASK
    else:
        mode, mtu = MODE_DEFAULT, None

    signer_ed25519 = identity_public[KEYHALF:]
    signed_data    = link_id + x25519 + signer_ed25519 + signalling

    return lines + [
        field("link_id",         link_id.hex()),
        field("link_id_match",   "yes" if h["dest_hash"] == link_id else "no"),
        field("signature",       signature.hex()),
        field("x25519_public",   x25519.hex()),
        field("signalling",      signalling.hex() if signalled else "-"),
        field("mode",            LINK_MODES.get(mode, "%02x" % mode)),
        field("mtu",             "%d" % mtu if signalled else "-"),
        field("signer_ed25519",  signer_ed25519.hex()),
        field("signed_data",     signed_data.hex()),
        field("signature_valid", "yes" if verify(signer_ed25519, signature, signed_data) else "no"),
    ]


def gen_linkproof(RNS, w, verify, session):
    identity, request = session["identity"], session["request"]
    link, proof = session["link"], session["proof"]

    public  = identity.get_public_key()
    request_raw, raw = request.raw, proof.raw
    blobs = [request_raw.hex(), public.hex()]

    # The reference must accept its own proof. validate_proof drives a
    # link state machine, so the two facts it turns on are asserted
    # instead: the address field is the link id, and the signature is
    # over the four parts assembled below.
    assert proof.raw[2:2+ADDRLEN] == link.link_id
    assert lookup_field(describe_linkproof(request_raw, public, raw, verify),
                        "signature_valid") == "yes"

    w.vector("linkproof", "signalling",
        "link request proof as the reference emits it, mtu confirmed",
        blobs + [raw.hex()],
        describe_linkproof(request_raw, public, raw, verify))

    # The 96-byte form validate_proof also accepts, at RNS/Link.py:405.
    # The reference never emits it: prove always signals. Removing the
    # bytes removes them from the signed material too, so the signature
    # no longer verifies, which is the point of the vector.
    removed = raw[:-SIGNALLEN]
    w.vector("linkproof", "signalling-removed",
        "signalling bytes removed; the proof still decodes and the signature does not verify",
        blobs + [removed.hex()],
        describe_linkproof(request_raw, public, removed, verify),
        source="constructed by tools/gen from linkproof/signalling")

    altered = raw[:19] + bytes([raw[19] ^ 0x01]) + raw[20:]
    w.vector("linkproof", "altered-signature",
        "first signature byte altered",
        blobs + [altered.hex()],
        describe_linkproof(request_raw, public, altered, verify),
        source="constructed by tools/gen from linkproof/signalling")


def describe_linkdata(request_raw, responder_private, raw, verify):
    """Unlike a packet to a destination, this one carries no ephemeral
    key: both ends already hold the shared secret. The salt of the
    derivation is the link id, which is in no packet either.
    """
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey, X25519PublicKey
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    import hmac as _hmac

    # The two input blobs are echoed so that expect holds every byte of
    # raw. Without them the vector could be decoded but not rebuilt.
    echo = [
        field("link_request",      request_raw.hex()),
        field("responder_private", responder_private.hex()),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    _, rh = describe_header(request_raw)
    link_id = hashlib.sha256(
        hashable_part(request_raw, len(rh["payload"]))).digest()[:ADDRLEN]

    lines += [
        field("link_id",       link_id.hex()),
        field("link_id_match", "yes" if h["dest_hash"] == link_id else "no"),
    ]

    # Keepalives carry no data and are the one link packet the
    # reference does not encrypt. RNS/Packet.py:206.
    if h["context"] == 0xfa:
        return lines + [
            field("encrypted",        "no"),
            field("plaintext_length", "%d" % len(payload)),
            field("plaintext",        payload.hex() if payload else "-"),
        ]

    lines.append(field("encrypted", "yes"))

    if len(payload) < TOKEN_OVERHEAD:
        return lines + invalid("short-payload",
                               ("payload_length", len(payload)),
                               ("minimum_length", TOKEN_OVERHEAD))

    iv         = payload[:16]
    ciphertext = payload[16:-32]
    mac        = payload[-32:]

    initiator_public = rh["payload"][:KEYHALF]
    shared = X25519PrivateKey.from_private_bytes(responder_private).exchange(
        X25519PublicKey.from_public_bytes(initiator_public))
    derived = hkdf_sha256(64, shared, link_id)
    signing_key, encryption_key = derived[:32], derived[32:]

    mac_ok = _hmac.compare_digest(
        mac, _hmac.new(signing_key, iv + ciphertext, hashlib.sha256).digest())

    plaintext = None
    if mac_ok and len(ciphertext) > 0 and len(ciphertext) % 16 == 0:
        dec = Cipher(algorithms.AES(encryption_key), modes.CBC(iv)).decryptor()
        padded = dec.update(ciphertext) + dec.finalize()
        n = padded[-1]
        if 0 < n <= 16 and n <= len(padded):
            plaintext = padded[:len(padded) - n]

    lines += [
        field("iv",               iv.hex()),
        field("ciphertext",       ciphertext.hex()),
        field("hmac",             mac.hex()),
        field("shared_key",       shared.hex()),
        field("signing_key",      signing_key.hex()),
        field("encryption_key",   encryption_key.hex()),
        field("hmac_valid",       "yes" if mac_ok else "no"),
        field("plaintext_length", "-" if plaintext is None else "%d" % len(plaintext)),
        field("plaintext",        plaintext.hex() if plaintext else "-"),
    ]

    # An identify proof names the initiator, which nothing else on a
    # link does. Its signature covers the link id, so it cannot be
    # replayed onto another link. RNS/Link.py:464.
    if h["context"] == 0xfb and plaintext is not None and len(plaintext) == KEYSIZE + SIGLEN:
        identity_public = plaintext[:KEYSIZE]
        signature       = plaintext[KEYSIZE:]
        signed_data     = link_id + identity_public
        lines += [
            field("identity_public",    identity_public.hex()),
            field("identity_hash",      hashlib.sha256(identity_public).digest()[:ADDRLEN].hex()),
            field("identity_signed",    signed_data.hex()),
            field("identity_valid",     "yes" if verify(identity_public[KEYHALF:], signature, signed_data) else "no"),
        ]

    return lines


def gen_linkdata(RNS, w, verify, session):
    from RNS.vendor import umsgpack

    request_raw = session["request"].raw
    responder_private = session["link"].prv.private_bytes()

    # A second identity, so that the one identifying over the link is
    # plainly not the one the link was established to.
    initiator_identity = RNS.Identity.from_bytes(bytes.fromhex(UPSTREAM_KEYS[1][0]))

    # The measured round trip time is zero under a pinned clock, which
    # would record the msgpack layout of a value no link ever reports.
    rtt = 0.0625

    with pinned(RNS, "linkdata"):
        link = initiator_link(RNS, session)
        with captured(RNS) as sent:
            RNS.Packet(link, b"reticulum").send()
            link.identify(initiator_identity)
            RNS.Packet(link, umsgpack.packb(rtt), context=RNS.Packet.LRRTT).send()
            RNS.Packet(link, link.link_id, context=RNS.Packet.LINKCLOSE).send()
            link.send_keepalive()

    cases = [
        ("minimal",   sent[0], "nine bytes of plaintext over the link"),
        ("identify",  sent[1], "the initiator names itself, signing over the link id"),
        ("rtt",       sent[2], "round trip time, msgpack encoded, sent by the initiator"),
        ("close",     sent[3], "teardown; the plaintext is the link id"),
        ("keepalive", sent[4], "one byte, and the one link packet that is not encrypted"),
    ]

    for name, packet, purpose in cases:
        blobs = [request_raw.hex(), responder_private.hex(), packet.raw.hex()]
        described = describe_linkdata(request_raw, responder_private, packet.raw, verify)
        w.vector("linkdata", name, purpose, blobs, described)

    base = sent[0].raw
    altered = base[:-1] + bytes([base[-1] ^ 0x01])
    w.vector("linkdata", "altered-hmac",
        "last byte of the token hmac altered; nothing is decrypted",
        [request_raw.hex(), responder_private.hex(), altered.hex()],
        describe_linkdata(request_raw, responder_private, altered, verify),
        source="constructed by tools/gen from linkdata/minimal")


def lookup_field(lines, name):
    for line in lines:
        if line.startswith(name + " "):
            return line.split(None, 1)[1]
    raise KeyError(name)


def hkdf_sha256(length, ikm, salt, context=b""):
    """RFC 5869, which is what RNS/Cryptography/HKDF.py:35 implements."""
    import hmac as _hmac

    def mac(key, data):
        return _hmac.new(key, data, hashlib.sha256).digest()

    prk = mac(salt if salt else bytes(32), ikm)
    block, derived = b"", b""
    for i in range((length + 31) // 32):
        block = mac(prk, block + context + bytes([(i + 1) % 256]))
        derived += block
    return derived[:length]


def describe_encrypted(raw, private, ratchet_private):
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey, X25519PublicKey
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    import hmac as _hmac

    # The two input blobs are echoed so that expect holds every byte of
    # raw. Without them the vector could be decoded but not rebuilt.
    echo = [
        field("recipient_private", private.hex()),
        field("ratchet_private",
              ratchet_private.hex() if ratchet_private is not None else "-"),
    ]

    lines, h = describe_header(raw)
    lines = echo + lines
    if h is None:
        return lines
    payload = h["payload"]

    if len(payload) < KEYHALF + TOKEN_OVERHEAD:
        return echo + invalid("short-payload",
                              ("payload_length", len(payload)),
                              ("minimum_length", KEYHALF + TOKEN_OVERHEAD))

    ephemeral  = payload[:KEYHALF]
    token      = payload[KEYHALF:]
    iv         = token[:16]
    ciphertext = token[16:-32]
    mac        = token[-32:]

    public_key    = private_to_public(private)
    identity_hash = hashlib.sha256(public_key).digest()[:ADDRLEN]

    # The salt is always the recipient's identity hash, including when
    # the shared secret came from a ratchet. RNS/Identity.py:841.
    if ratchet_private is not None:
        agree_with = ratchet_private
        ratchet_public = X25519PrivateKey.from_private_bytes(ratchet_private) \
            .public_key().public_bytes_raw()
    else:
        agree_with = private[:KEYHALF]
        ratchet_public = None

    shared = X25519PrivateKey.from_private_bytes(agree_with).exchange(
        X25519PublicKey.from_public_bytes(ephemeral))
    derived = hkdf_sha256(64, shared, identity_hash)
    signing_key, encryption_key = derived[:32], derived[32:]

    mac_ok = _hmac.compare_digest(
        mac, _hmac.new(signing_key, iv + ciphertext, hashlib.sha256).digest())

    plaintext = None
    if mac_ok and len(ciphertext) > 0 and len(ciphertext) % 16 == 0:
        dec = Cipher(algorithms.AES(encryption_key), modes.CBC(iv)).decryptor()
        padded = dec.update(ciphertext) + dec.finalize()
        n = padded[-1]
        if 0 < n <= 16 and n <= len(padded):
            plaintext = padded[:len(padded) - n]

    lines += [
        field("ephemeral_public", ephemeral.hex()),
        field("iv",              iv.hex()),
        field("ciphertext",      ciphertext.hex()),
        field("hmac",            mac.hex()),
        field("identity_hash",   identity_hash.hex()),
        field("ratchet_public",  ratchet_public.hex() if ratchet_public else "-"),
        field("shared_key",      shared.hex()),
        field("signing_key",     signing_key.hex()),
        field("encryption_key",  encryption_key.hex()),
        field("hmac_valid",      "yes" if mac_ok else "no"),
        field("plaintext_length", "-" if plaintext is None else "%d" % len(plaintext)),
        field("plaintext",        plaintext.hex() if plaintext else "-"),
    ]
    return lines


def private_to_public(private):
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    x = X25519PrivateKey.from_private_bytes(private[:KEYHALF]).public_key().public_bytes_raw()
    e = Ed25519PrivateKey.from_private_bytes(private[KEYHALF:]).public_key().public_bytes_raw()
    return x + e


def encrypted_raw(RNS, key_index, aspects, plaintext, use_ratchet, tag):
    private   = bytes.fromhex(UPSTREAM_KEYS[key_index][0])
    recipient = RNS.Identity.from_bytes(private)

    # An outbound destination holds only the public key, as a sender does.
    public_only = RNS.Identity(create_keys=False)
    public_only.load_public_key(recipient.get_public_key())

    ratchet_private = None
    with pinned(RNS, tag):
        destination = RNS.Destination(public_only, RNS.Destination.OUT,
                                      RNS.Destination.SINGLE, aspects[0], *aspects[1:])
        RNS.Identity.known_ratchets.pop(destination.hash, None)
        if use_ratchet:
            ratchet_private = RNS.Identity._generate_ratchet()
            RNS.Identity.known_ratchets[destination.hash] = \
                RNS.Identity._ratchet_public_bytes(ratchet_private)

        packet = RNS.Packet(destination, plaintext)
        packet.pack()

    # The reference implementation must recover what it encrypted.
    ratchets = [ratchet_private] if ratchet_private else None
    assert recipient.decrypt(packet.ciphertext, ratchets=ratchets) == plaintext

    return private, ratchet_private, packet.raw


def gen_encrypted(RNS, w):
    made = {}
    for name, key_index, aspects, plaintext, use_ratchet, purpose in ENCRYPTED:
        private, ratchet, raw = encrypted_raw(RNS, key_index, aspects, plaintext,
                                              use_ratchet, "encrypted-" + name)
        made[name] = (private, ratchet, raw)
        w.vector("encrypted", name, purpose,
            [private.hex(), ratchet.hex() if ratchet else "-", raw.hex()],
            describe_encrypted(raw, private, ratchet))

    private, ratchet, raw = made["minimal"]
    altered = raw[:-1] + bytes([raw[-1] ^ 0x01])
    w.vector("encrypted", "altered-hmac",
        "last byte of the token hmac altered; nothing is decrypted",
        [private.hex(), "-", altered.hex()],
        describe_encrypted(altered, private, None),
        source="constructed by tools/gen from encrypted/minimal")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--checkout", default=CHECKOUT)
    ap.add_argument("--force", action="store_true")
    args = ap.parse_args()

    RNS    = load_rns(args.checkout)
    w      = Writer(ROOT, args.force)
    verify = make_verifier(RNS)

    tmpdir = tempfile.mkdtemp(prefix="reticulum-vectors-")
    stub_transport(RNS, tmpdir)
    try:
        gen_identity(RNS, w)
        gen_keyset(RNS, w)
        gen_destination(RNS, w)
        gen_signature(RNS, w, verify)
        gen_sign(RNS, w)
        gen_announce(RNS, w, tmpdir, verify)
        gen_encrypted(RNS, w)

        session = link_session(RNS, "link")
        gen_linkrequest(RNS, w, session)
        gen_linkproof(RNS, w, verify, session)
        gen_linkdata(RNS, w, verify, session)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

    w.index()

    print("%d files written" % w.written)
    if w.differs:
        print("%d files differ and were left alone:" % len(w.differs))
        for path in w.differs:
            print("    %s" % os.path.relpath(path, ROOT))
        print("run with --force to replace them, after examining why they changed")
        sys.exit(1)


if __name__ == "__main__":
    main()

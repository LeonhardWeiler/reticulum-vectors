# Constructed here, not upstream. The pair pins the clamping rule: the
# X25519 scalar is stored as given and clamped only when used, so the
# two keys differ while their public keys and identity hashes agree.
CLAMP_UNCLAMPED = "ff" * 32 + "01" * 32
CLAMP_CLAMPED   = "f8" + "ff" * 30 + "7f" + "01" * 32

EXTRA_KEYS = [
    (CLAMP_UNCLAMPED, "unclamped x25519 scalar, stored and returned verbatim"),
    (CLAMP_CLAMPED,   "the same scalar clamped; same public key and identity hash, different private key"),
]


#!/usr/bin/env python3
#
# Check every RNS/...py:N#anchor citation in the corpus against the
# pinned checkout.
#
#     tools/cite [--checkout PATH]
#
# doc/ and the programs cite the reference by line, and nothing else
# reads those numbers. Twelve of them had already slid by one or two
# lines before this existed, and five more named a line that was code
# and not the rule they were cited for, which is the shape a citation
# takes when it was wrong from the start rather than when it drifted.
# Landing on a blank line or a comment caught neither kind.
#
# So a citation carries the line and a piece of what is on it. The
# anchor is checked for identity rather than for plausibility: it must
# appear on the line named. When it does not, this program finds the
# lines it does appear on and prints them, so that repairing a citation
# is reading a number rather than searching a file.

import argparse
import os
import re
import subprocess
import sys

ROOT     = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CHECKOUT = os.path.join(os.path.dirname(ROOT), "upstream")

GIT = ["git", "-C", ROOT, "ls-files", "-z"]

# The anchor is a chain of identifiers, so a sentence's full stop is not
# part of it and Reticulum.MTU is. One without an anchor still matches,
# and is an error: a check that can be left off is a check that will be.
CITE   = re.compile(r"RNS/[A-Za-z0-9_/]+\.py:\d+"
                    r"(?:#[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*)?")
PARTS  = re.compile(r"^(RNS/[A-Za-z0-9_/]+\.py):(\d+)#(.+)$")


def sources():
    """Every file this repository tracks, which is the point.

    A hand-kept list of where citations may appear is a list that goes
    stale silently: a new file with a wrong citation is not reported,
    it is not looked at. git already knows what belongs here, and
    .gitignore already excludes the cloned implementations under
    conformance/src, which are not ours to check.

    One consequence, which has already bitten: a file that has not been
    added is not tracked and is not read, so make verify passes on a
    new document with wrong citations and fails on the next run after
    it is committed. That is the right way round, and it means a clean
    verify before a first commit says less than one after it.
    """
    r = subprocess.run(GIT, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit("git ls-files in %s: %s" % (ROOT, r.stderr.strip()))
    for name in sorted(r.stdout.split("\0")):
        if name:
            yield os.path.join(ROOT, name)


def elsewhere(lines, anchor):
    """Where the anchor is, so that a slid citation names its own fix."""
    found = [str(n) for n, text in enumerate(lines, 1) if anchor in text]
    if not found:
        return "anchor is nowhere in the file"
    if len(found) > 8:
        return "anchor is on %d other lines" % len(found)
    return "anchor is on line " + ", ".join(found)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--checkout", default=CHECKOUT)
    args = ap.parse_args()

    cache = {}
    checked, bad = 0, []

    for path in sources():
        try:
            body = open(path, encoding="utf-8").read()
        except UnicodeDecodeError:
            continue

        for m in CITE.finditer(body):
            checked += 1
            cited = m.group(0)
            where = os.path.relpath(path, ROOT)

            parts = PARTS.match(cited)
            if parts is None:
                bad.append((where, cited, "no anchor"))
                continue
            target, line, anchor = parts.group(1), int(parts.group(2)), parts.group(3)

            if target not in cache:
                full = os.path.join(args.checkout, target)
                cache[target] = open(full).read().split("\n") \
                    if os.path.isfile(full) else None

            lines = cache[target]
            if lines is None:
                bad.append((where, cited, "no such file in the checkout"))
            elif line > len(lines):
                bad.append((where, cited, "past the end of a %d-line file" % len(lines)))
            elif anchor not in lines[line-1]:
                bad.append((where, cited, elsewhere(lines, anchor)))

    print("%d citations checked" % checked)
    if bad:
        for where, cited, why in bad:
            print("    %-20s %-46s %s" % (where, cited, why))
        sys.exit(1)


if __name__ == "__main__":
    main()

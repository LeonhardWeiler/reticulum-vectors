#!/usr/bin/env python3
#
# Resolve the counts in the prose against the corpus.
#
#     tools/counts
#
# README, CLAUDE.md and doc/ state how many of a thing the corpus
# holds, and nothing read those numbers. They are right today, which is
# the cheap moment to put a check under them.
#
# It resolves rather than forbids. A parser cannot tell a total from a
# local count: "Two vectors carry the boundary" names its two in the
# same sentence and cannot drift, and a rule against counting would
# rewrite every such line to reach the few that can. So this carries a
# table of phrasings instead, each one taken from a line on file, each
# one naming the quantity the number in it must equal. The phrasing is
# matched everywhere, not at the line it was taken from.
#
# Two of the three quantities are ones a count of is always a count of
# all of them: there is one set of harnesses and one set of documents.
# Vectors are counted in the small on nearly every page, so only a
# phrasing that says all of them is resolved.
#
# The limit is the phrasing. Reword a sentence and its check goes with
# it, so the tally is printed on success and a claim that stops
# matching shows up as a smaller number. CLAUDE.md carries the sentence
# for what no phrasing reaches.
#
# CONFORMANCE is exempt. Its counts are measurements against the corpus
# of a named date and have to be allowed to go stale; that is what
# makes a row reproducible at its commit.

import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

GIT = ["git", "-C", ROOT, "ls-files", "-z"]

EXEMPT = {"CONFORMANCE"}

# The prose writes small numbers out, so the check has to read them.
WORDS = ("zero one two three four five six seven eight nine ten eleven "
         "twelve thirteen fourteen fifteen sixteen seventeen eighteen "
         "nineteen twenty").split()

CLAIMS = [
    ("harnesses", r"(\w+)\s+harnesses\b"),
    ("documents", r"(\w+)\s+documents\b"),
    ("decode",    r"(\w+)\s+decode-class vectors\b"),
    ("decode",    r"all but\s+(\w+)\s+vectors are of that class\b"),
]


def number(token):
    """The number a word is, or None when the word is not one.

    A phrasing matches more than it counts: "the other documents" and
    "the harnesses those results were produced with" both fit, and
    neither states a number. Nothing that is not a number is a claim.
    """
    if token.isdigit():
        return int(token)
    token = token.lower()
    return WORDS.index(token) if token in WORDS else None


def tracked():
    """Every file this repository tracks, as cite reads it.

    A hand-kept list of where to look fails in the direction that says
    nothing: the file nobody added to it is not reported, it is never
    read.
    """
    r = subprocess.run(GIT, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit("git ls-files in %s: %s" % (ROOT, r.stderr.strip()))
    return sorted(name for name in r.stdout.split("\0") if name)


def totals(names):
    """What the corpus counts, from the corpus and not from a constant."""
    index = [line for line in
             open(os.path.join(ROOT, "test", "INDEX")).read().split("\n")
             if line]

    decode = 0
    for vector in index:
        meta = open(os.path.join(ROOT, "test", vector, "meta")).read()
        if re.search(r"^determinism\s+decode$", meta, re.M):
            decode += 1

    documents = [name for name in names
                 if name.startswith("doc/") and name.count("/") == 1]

    # A harness is a directory under conformance/, and conformance/src
    # is not tracked. example/ is left out because it measures nothing,
    # which is the distinction the prose draws when it counts.
    harnesses = {name.split("/")[1] for name in names
                 if name.startswith("conformance/") and name.count("/") > 1}
    harnesses.discard("example")

    return {"decode": decode,
            "documents": len(documents),
            "harnesses": len(harnesses)}


def main():
    names = tracked()
    corpus = totals(names)
    resolved = {quantity: 0 for quantity, _ in CLAIMS}
    wrong = []

    for name in names:
        if name in EXEMPT:
            continue
        try:
            body = open(os.path.join(ROOT, name), encoding="utf-8").read()
        except (UnicodeDecodeError, IsADirectoryError):
            continue

        for quantity, phrasing in CLAIMS:
            # Case-insensitive: a phrasing lands mid-sentence in one
            # place and opens a sentence in another, and the count is
            # the same count either way.
            for m in re.finditer(phrasing, body, re.IGNORECASE):
                claimed = number(m.group(1))
                if claimed is None:
                    continue
                resolved[quantity] += 1
                if claimed != corpus[quantity]:
                    line = body.count("\n", 0, m.start()) + 1
                    # A phrasing can wrap, and a report that wraps with
                    # it is a report with a broken column.
                    wrong.append(("%s:%d" % (name, line),
                                  " ".join(m.group(0).split()),
                                  claimed, corpus[quantity]))

    print("%d counts resolved: %s"
          % (sum(resolved.values()),
             ", ".join("%s %d" % (q, n) for q, n in sorted(resolved.items()))))
    if wrong:
        for where, said, claimed, held in wrong:
            print("    %-24s %-46s says %d, the corpus holds %d"
                  % (where, said, claimed, held))
        sys.exit(1)


if __name__ == "__main__":
    main()

#!/bin/sh
#
# check - run every vector against a decoder and report disagreements.
#
# For each vector:
#
#	meta is complete and its fields hold known values
#	dump kind raw            matches expect
#	dump -e kind expect      matches raw, for the encode class
#
# The second is the corpus proper. The third turns "determinism: encode"
# from a claim in a text file into a test.
#
#	DUMP=./my-decoder cmd/check	check another implementation
#	ENCODE=no cmd/check		skip the round trip
#
# A decoder that implements some kinds and not others exits 77 for the
# rest; those vectors are reported as skipped and not counted against
# it. Nothing else may use that status.
#
# The kinds are the directories under test/. There is no list of them
# here; dump -l prints the ones dump knows.
#
# Exits non-zero if any vector fails.

root=$(dirname "$0")/..
DUMP=${DUMP:-$root/cmd/dump}
ENCODE=${ENCODE:-yes}

# A foreign harness that hangs would hang this script. timeout is not
# POSIX; where it is missing the calls are made directly.
if command -v timeout >/dev/null 2>&1; then
	run() { timeout 30 "$@"; }
else
	run() { "$@"; }
fi

if [ ! -x "$DUMP" ]; then
	echo "no dump program at $DUMP; run make" >&2
	exit 2
fi

pass=0
fail=0
seen=0
skip=0
noise=0
skipped_kinds=

err=$(mktemp) || exit 2
trap 'rm -f "$err"' EXIT INT TERM

# The corpus is what test/INDEX says it is. Counting what is present is
# not a check: a copy of test/ with forty vectors removed passes every
# one of the eight it kept.
index="$root/test/INDEX"
if [ ! -f "$index" ]; then
	echo "no test/INDEX; the corpus cannot say what it is missing" >&2
	exit 2
fi

present=$(cd "$root/test" && find . -mindepth 2 -maxdepth 2 -type d |
          sed 's,^\./,,' | LC_ALL=C sort)
differs=$(printf '%s\n' "$present" | diff "$index" - | sed -n 's/^[<>]/&/p')
if [ -n "$differs" ]; then
	echo "test/ and test/INDEX disagree:"
	printf '%s\n' "$differs" | sed 's/^</    missing:/; s/^>/    unlisted:/'
	exit 2
fi

# The encoders in cmd/dump decide a field is present by looking for "-"
# and the decoders decide it by reading the packet. The round trip only
# holds those two rules together where both cases are on file.
#
# Per field, not per kind: transport_id is written by one line of
# put_header that nine encoders share.
uncrossed=$(awk '
	NF == 2 { seen[$1 SUBSEP (($2 == "-") ? "absent" : "present")] = 1 }
	END {
		for (k in seen) {
			split(k, f, SUBSEP)
			if (f[2] == "absent" && !((f[1] SUBSEP "present") in seen))
				printf "    %s is absent in every vector that carries it\n", f[1]
		}
	}
' "$root"/test/*/*/expect | LC_ALL=C sort)

if [ -n "$uncrossed" ]; then
	echo "optional fields with only one case on file:"
	printf '%s\n' "$uncrossed"
	exit 2
fi

fail_with() {
	# Named from the repository root; the path built here runs through cmd/..
	echo "FAIL ${1#"$root"/}"
	shift
	printf '%s\n' "$@" | sed 's/^/    /'
	fail=$((fail + 1))
}

meta_field() {
	sed -n "s/^$2  *//p" "$1/meta"
}

# A name wider than the column silently shifts the value, and two
# vectors that disagree only in alignment compare equal to a decoder
# that pads the same way. Nothing else reads the width.
check_format() {
	awk -v w=18 '
		NF == 0 { next }
		NF != 2 { printf "%s:%d: expected a name and one value\n", FILENAME, FNR; bad = 1; next }
		length($1) > w { printf "%s:%d: field name %s is wider than the %d-column format\n", FILENAME, FNR, $1, w; bad = 1 }
		END { if (bad) exit 1 }
	' "$1"
}

for dir in "$root"/test/*/*/; do
	dir=${dir%/}
	[ -d "$dir" ] || continue
	seen=$((seen + 1))

	if [ ! -f "$dir/meta" ]; then
		fail_with "$dir" "no meta"
		continue
	fi

	# meta must be complete before anything is read from it.
	missing=
	for f in source determinism purpose; do
		[ -n "$(meta_field "$dir" "$f")" ] || missing="$missing $f"
	done
	if [ -n "$missing" ]; then
		fail_with "$dir" "meta has no$missing"
		continue
	fi

	# The kind is the directory the vector is filed under, and only that.
	kind=$(basename "$(dirname "$dir")")
	determinism=$(meta_field "$dir" determinism)

	case "$determinism" in
		decode|encode) ;;
		*) fail_with "$dir" "meta names an unknown determinism class: $determinism"; continue ;;
	esac

	# stderr is kept out of the comparison: a warning is not a field.
	out=$(run "$DUMP" "$kind" "$dir/raw" 2>"$err")
	status=$?

	if [ "$status" -eq 124 ]; then
		fail_with "$dir" "no answer after 30 seconds"
		continue
	fi

	if [ "$status" -eq 77 ]; then
		skip=$((skip + 1))
		skipped_kinds=$(printf '%s\n%s' "$skipped_kinds" "$kind")
		continue
	fi

	# The status is named: a decoder that dies on a signal writes nothing
	# to stderr, and 134 or 139 is a different thing to look at than a
	# decoder that printed a reason and exited 1.
	if [ "$status" -ne 0 ]; then
		fail_with "$dir" "exit status $status" "$(cat "$err")"
		continue
	fi

	# Not compared, but not discarded either: a sanitizer build otherwise
	# reports every vector passing and prints its findings to a stream
	# nothing mentions.
	if [ -s "$err" ]; then
		noise=$((noise + 1))
	fi

	if ! bad=$(check_format "$dir/expect"); then
		fail_with "$dir" "$bad"
		continue
	fi

	# The exit status of a pipeline is the status of its last command, so
	# diff's verdict is read from its output.
	changed=$(printf '%s\n' "$out" | diff -u "$dir/expect" - | tail -n +3)
	if [ -n "$changed" ]; then
		fail_with "$dir" "$changed"
		continue
	fi

	if [ "$determinism" = encode ] && [ "$ENCODE" = yes ]; then
		if ! back=$(run "$DUMP" -e "$kind" "$dir/expect" 2>"$err"); then
			fail_with "$dir" "round trip: $(cat "$err")"
			continue
		fi
		changed=$(printf '%s\n' "$back" | diff -u "$dir/raw" - | tail -n +3)
		if [ -n "$changed" ]; then
			fail_with "$dir" "round trip does not reproduce raw" "$changed"
			continue
		fi

	# The class is derived by tools/gen, which a consumer does not run.
	# Without this, decode is the one field in meta whose error skips a
	# check rather than causing one.
	elif [ "$ENCODE" = yes ] &&
	     back=$(run "$DUMP" -e "$kind" "$dir/expect" 2>/dev/null) &&
	     [ -z "$(printf '%s\n' "$back" | diff "$dir/raw" -)" ]; then
		fail_with "$dir" "meta says decode, and expect rebuilds raw"
		continue
	fi

	pass=$((pass + 1))
done

# What the result was measured against, so a count recorded elsewhere can
# be told from the same count against a different corpus. cksum because
# it is POSIX and this is a fingerprint, not a signature.
#
# The order comes from INDEX, not from a glob: a glob is expanded in the
# caller's collating order, and the same corpus fingerprints differently
# under a UTF-8 locale and under C.
corpus=$( { cat "$index"
            while read -r v; do
                    # Quiet: a vector missing a file is already reported
                    # by name above.
                    cat "$root/test/$v/raw" "$root/test/$v/expect" 2>/dev/null
            done < "$index"
          } | cksum | cut -d' ' -f1)

if [ "$skip" -eq 0 ]; then
	echo "$pass passed, $fail failed, corpus $corpus"
else
	# Naming the kinds keeps a partial result from reading as a whole one.
	# Unquoted, so the shell splits the list and drops the empty first line.
	echo "$pass passed, $fail failed, corpus $corpus, $skip skipped:" \
	     $(printf '%s\n' "$skipped_kinds" | sort -u)
fi

if [ "$noise" -gt 0 ]; then
	echo "$noise decoder runs wrote to standard error" >&2
fi

if [ "$seen" -eq 0 ]; then
	echo "no vectors under $root/test" >&2
	exit 2
fi

# Nothing ran, which is not a result. A decoder that exits 77 for every
# kind has measured itself against no vector at all.
if [ "$pass" -eq 0 ] && [ "$fail" -eq 0 ]; then
	echo "nothing was checked" >&2
	exit 2
fi

[ "$fail" -eq 0 ]

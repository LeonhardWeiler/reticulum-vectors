#!/bin/sh
#
# check - run every vector against a decoder and report disagreements.
#
# For each vector:
#
#	meta is complete and its fields hold known values
#	dump kind raw            matches expect
#	dump -e kind expect      matches raw, for the encode class
#
# The second check is the corpus proper. The first stops a vector from
# describing itself with a field nothing reads. The third turns
# "determinism: encode" from a claim in a text file into a test.
#
#	DUMP=./my-decoder cmd/check	check another implementation
#	ENCODE=no cmd/check		skip the round trip
#
# Exits non-zero if any vector fails.

root=$(dirname "$0")/..
DUMP=${DUMP:-$root/cmd/dump}
ENCODE=${ENCODE:-yes}

KINDS="identity keyset destination signature sign announce encrypted linkrequest linkproof linkdata"

if [ ! -x "$DUMP" ]; then
	echo "no dump program at $DUMP; run make" >&2
	exit 2
fi

pass=0
fail=0
seen=0

err=$(mktemp) || exit 2
trap 'rm -f "$err"' EXIT INT TERM

# The corpus is what test/INDEX says it is. Counting what is present
# and reporting it as a total is not a check: a copy of test/ with
# forty vectors removed passes every one of the eight it kept.
index="$root/test/INDEX"
if [ ! -f "$index" ]; then
	echo "no test/INDEX; the corpus cannot say what it is missing" >&2
	exit 2
fi

present=$(cd "$root/test" && find . -mindepth 2 -maxdepth 2 -type d |
          sed 's,^\./,,' | LC_ALL=C sort)
differs=$(printf '%s\n' "$present" | diff "$index" - | sed -n 's/^[<>]/&/p')
if [ -n "$differs" ]; then
	echo "test/ and test/INDEX disagree:"
	printf '%s\n' "$differs" | sed 's/^</    missing:/; s/^>/    unlisted:/'
	exit 2
fi

fail_with() {
	echo "FAIL $1"
	shift
	printf '%s\n' "$@" | sed 's/^/    /'
	fail=$((fail + 1))
}

meta_field() {
	sed -n "s/^$2  *//p" "$1/meta"
}

# The format has one rule a diff cannot enforce: a name wider than the
# column silently shifts the value, and two vectors that disagree only
# in alignment would still compare equal to a decoder that pads the
# same way. Nothing else reads it, so it is read here.
check_format() {
	awk -v w=18 '
		NF == 0 { next }
		NF != 2 { printf "%s:%d: expected a name and one value\n", FILENAME, FNR; bad = 1; next }
		length($1) > w { printf "%s:%d: field name %s is wider than the %d-column format\n", FILENAME, FNR, $1, w; bad = 1 }
		END { if (bad) exit 1 }
	' "$1"
}

for dir in "$root"/test/*/*/; do
	dir=${dir%/}
	[ -d "$dir" ] || continue
	seen=$((seen + 1))

	if [ ! -f "$dir/meta" ]; then
		fail_with "$dir" "no meta"
		continue
	fi

	# meta must be complete before anything is read from it.
	missing=
	for f in source determinism purpose; do
		[ -n "$(meta_field "$dir" "$f")" ] || missing="$missing $f"
	done
	if [ -n "$missing" ]; then
		fail_with "$dir" "meta has no$missing"
		continue
	fi

	# The kind is the directory the vector is filed under. Recording it
	# in meta as well meant a rule to keep the two agreeing, and a way
	# for them to disagree.
	kind=$(basename "$(dirname "$dir")")
	determinism=$(meta_field "$dir" determinism)

	case " $KINDS " in
		*" $kind "*) ;;
		*) fail_with "$dir" "no decoder for kind $kind"; continue ;;
	esac

	case "$determinism" in
		decode|encode) ;;
		*) fail_with "$dir" "meta names an unknown determinism class: $determinism"; continue ;;
	esac

	# stderr is kept out of the comparison. A decoder that writes a
	# warning there would otherwise have it diffed against expect, and
	# the vector would fail for something that is not a field.
	if ! out=$("$DUMP" "$kind" "$dir/raw" 2>"$err"); then
		fail_with "$dir" "$(cat "$err")"
		continue
	fi

	if ! bad=$(check_format "$dir/expect"); then
		fail_with "$dir" "$bad"
		continue
	fi

	# The exit status of a pipeline is the status of its last command,
	# so diff's verdict must be read from its output, not from the
	# status of anything downstream of it.
	changed=$(printf '%s\n' "$out" | diff -u "$dir/expect" - | tail -n +3)
	if [ -n "$changed" ]; then
		fail_with "$dir" "$changed"
		continue
	fi

	if [ "$determinism" = encode ] && [ "$ENCODE" = yes ]; then
		if ! back=$("$DUMP" -e "$kind" "$dir/expect" 2>"$err"); then
			fail_with "$dir" "round trip: $(cat "$err")"
			continue
		fi
		changed=$(printf '%s\n' "$back" | diff -u "$dir/raw" - | tail -n +3)
		if [ -n "$changed" ]; then
			fail_with "$dir" "round trip does not reproduce raw" "$changed"
			continue
		fi
	fi

	pass=$((pass + 1))
done

echo "$pass passed, $fail failed"

# A corpus with nothing in it must not report success.
if [ "$seen" -eq 0 ]; then
	echo "no vectors under $root/test" >&2
	exit 2
fi

[ "$fail" -eq 0 ]

#!/bin/sh
#
# check - run every vector against a decoder and report disagreements.
#
# For each vector:
#
#	meta is complete and its fields hold known values
#	dump kind raw            matches expect
#	dump -e kind expect      matches raw, for the encode class
#
#	DUMP=./my-decoder cmd/check	check another implementation
#	ENCODE=no cmd/check		skip the round trip
#
# A decoder that implements some kinds and not others exits 77 for the
# rest; those vectors are reported as skipped and not counted against
# it.
#
# The kinds are the directories under test/.
# dump -l prints the ones dump knows.
#
# Exits non-zero if any vector fails.

root=$(dirname "$0")/..
DUMP=${DUMP:-$root/cmd/dump}
ENCODE=${ENCODE:-yes}

if command -v timeout >/dev/null 2>&1; then
	run() { timeout 30 "$@"; }
else
	run() { "$@"; }
fi

if [ ! -x "$DUMP" ]; then
	echo "no dump program at $DUMP; run make" >&2
	exit 2
fi

pass=0
fail=0
seen=0
skip=0
noise=0
skipped_kinds=

err=$(mktemp) || exit 2
trap 'rm -f "$err"' EXIT INT TERM

index="$root/test/INDEX"
if [ ! -f "$index" ]; then
	echo "no test/INDEX; the corpus cannot say what it is missing" >&2
	exit 2
fi

present=$(cd "$root/test" && find . -mindepth 2 -maxdepth 2 -type d |
          sed 's,^\./,,' | LC_ALL=C sort)
differs=$(printf '%s\n' "$present" | diff "$index" - | sed -n 's/^[<>]/&/p')
if [ -n "$differs" ]; then
	echo "test/ and test/INDEX disagree:"
	printf '%s\n' "$differs" | sed 's/^</    missing:/; s/^>/    unlisted:/'
	exit 2
fi

fail_with() {
	echo "FAIL ${1#"$root"/}"
	shift
	printf '%s\n' "$@" | sed 's/^/    /'
	fail=$((fail + 1))
}

meta_field() {
	sed -n "s/^$2  *//p" "$1/meta"
}

# A name wider than the column silently shifts the value
check_format() {
	awk -v w=18 '
		NF == 0 { next }
		NF != 2 { printf "%s:%d: expected a name and one value\n", FILENAME, FNR; bad = 1; next }
		length($1) > w { printf "%s:%d: field name %s is wider than the %d-column format\n", FILENAME, FNR, $1, w; bad = 1 }
		END { if (bad) exit 1 }
	' "$1"
}

for dir in "$root"/test/*/*/; do
	dir=${dir%/}
	[ -d "$dir" ] || continue
	seen=$((seen + 1))

	if [ ! -f "$dir/meta" ]; then
		fail_with "$dir" "no meta"
		continue
	fi

	# meta must be complete before anything is read from it.
	missing=
	for f in source determinism purpose; do
		[ -n "$(meta_field "$dir" "$f")" ] || missing="$missing $f"
	done
	if [ -n "$missing" ]; then
		fail_with "$dir" "meta has no$missing"
		continue
	fi

	# The kind is the directory the vector is filed under, and only that.
	kind=$(basename "$(dirname "$dir")")
	determinism=$(meta_field "$dir" determinism)

	case "$determinism" in
		decode|encode) ;;
		*) fail_with "$dir" "meta names an unknown determinism class: $determinism"; continue ;;
	esac

	# stderr is kept out of the comparison
	out=$(run "$DUMP" "$kind" "$dir/raw" 2>"$err")
	status=$?

	if [ "$status" -eq 124 ]; then
		fail_with "$dir" "no answer after 30 seconds"
		continue
	fi

	if [ "$status" -eq 77 ]; then
		skip=$((skip + 1))
		skipped_kinds=$(printf '%s\n%s' "$skipped_kinds" "$kind")
		continue
	fi

	# The status is named: a decoder that dies on a signal writes nothing to stderr
  if [ "$status" -ne 0 ]; then
		fail_with "$dir" "exit status $status" "$(cat "$err")"
		continue
	fi

	if [ -s "$err" ]; then
		noise=$((noise + 1))
	fi

	if ! bad=$(check_format "$dir/expect"); then
		fail_with "$dir" "$bad"
		continue
	fi

	changed=$(printf '%s\n' "$out" | diff -u "$dir/expect" - | tail -n +3)
	if [ -n "$changed" ]; then
		fail_with "$dir" "$changed"
		continue
	fi

	if [ "$determinism" = encode ] && [ "$ENCODE" = yes ]; then
		if ! back=$(run "$DUMP" -e "$kind" "$dir/expect" 2>"$err"); then
			fail_with "$dir" "round trip: $(cat "$err")"
			continue
		fi
		changed=$(printf '%s\n' "$back" | diff -u "$dir/raw" - | tail -n +3)
		if [ -n "$changed" ]; then
			fail_with "$dir" "round trip does not reproduce raw" "$changed"
			continue
		fi

	elif [ "$ENCODE" = yes ] &&
	     back=$(run "$DUMP" -e "$kind" "$dir/expect" 2>/dev/null) &&
	     [ -z "$(printf '%s\n' "$back" | diff "$dir/raw" -)" ]; then
		fail_with "$dir" "meta says decode, and expect rebuilds raw"
		continue
	fi

	pass=$((pass + 1))
done

corpus=$( { cat "$index"
            while read -r v; do
                    cat "$root/test/$v/raw" "$root/test/$v/expect" 2>/dev/null
            done < "$index"
          } | cksum | cut -d' ' -f1)

if [ "$skip" -eq 0 ]; then
	echo "$pass passed, $fail failed, corpus $corpus"
else
	echo "$pass passed, $fail failed, corpus $corpus, $skip skipped:" \
	     $(printf '%s\n' "$skipped_kinds" | sort -u)
fi

if [ "$noise" -gt 0 ]; then
	echo "$noise decoder runs wrote to standard error" >&2
fi

if [ "$seen" -eq 0 ]; then
	echo "no vectors under $root/test" >&2
	exit 2
fi

if [ "$pass" -eq 0 ] && [ "$fail" -eq 0 ]; then
	echo "nothing was checked" >&2
	exit 2
fi

[ "$fail" -eq 0 ]

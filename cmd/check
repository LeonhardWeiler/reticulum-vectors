#!/bin/sh
#
# check - run every vector against a decoder and report disagreements.
#
# For each vector:
#
#	meta is complete and its fields hold known values
#	dump kind raw            matches expect
#	dump -e kind expect      matches raw, for the encode class
#
# The second check is the corpus proper. The first stops a vector from
# describing itself with a field nothing reads. The third turns
# "determinism: encode" from a claim in a text file into a test.
#
#	DUMP=./my-decoder cmd/check	check another implementation
#	ENCODE=no cmd/check		skip the round trip
#
# The result line carries a checksum over test/INDEX and every raw and
# expect, so that a count recorded elsewhere names the corpus it was
# measured against.
#
# A decoder that implements some of the kinds and not others exits 77
# for the ones it does not, and those vectors are reported as skipped
# rather than failed. Requiring all of them before a decoder can get a
# result is the reason a new one starts with nothing to show.
#
# There is no list of kinds here. The kinds are the directories under
# test/, a decoder that does not know one says so by its exit status,
# and dump -l prints the ones dump knows. A fourth copy of the list
# would be a fourth thing to keep in step.
#
# Exits non-zero if any vector fails.

root=$(dirname "$0")/..
DUMP=${DUMP:-$root/cmd/dump}
ENCODE=${ENCODE:-yes}

# A foreign harness that hangs would hang this script for as long as
# anyone is willing to wait. timeout is not POSIX but is on every system
# these are built on; where it is missing the calls are made directly
# and the old behaviour is what happens.
if command -v timeout >/dev/null 2>&1; then
	run() { timeout 30 "$@"; }
else
	run() { "$@"; }
fi

if [ ! -x "$DUMP" ]; then
	echo "no dump program at $DUMP; run make" >&2
	exit 2
fi

pass=0
fail=0
seen=0
skip=0
skipped_kinds=

err=$(mktemp) || exit 2
documented=$(mktemp) || exit 2
trap 'rm -f "$err" "$documented"' EXIT INT TERM

# The corpus is what test/INDEX says it is. Counting what is present
# and reporting it as a total is not a check: a copy of test/ with
# forty vectors removed passes every one of the eight it kept.
index="$root/test/INDEX"
if [ ! -f "$index" ]; then
	echo "no test/INDEX; the corpus cannot say what it is missing" >&2
	exit 2
fi

present=$(cd "$root/test" && find . -mindepth 2 -maxdepth 2 -type d |
          sed 's,^\./,,' | LC_ALL=C sort)
differs=$(printf '%s\n' "$present" | diff "$index" - | sed -n 's/^[<>]/&/p')
if [ -n "$differs" ]; then
	echo "test/ and test/INDEX disagree:"
	printf '%s\n' "$differs" | sed 's/^</    missing:/; s/^>/    unlisted:/'
	exit 2
fi

# doc/fields is the index of every name expect can carry, and it is
# checked in both directions: a name in a vector and not in the document
# is undocumented, and a name in the document and in no vector is a
# field that was removed and left behind. A document nothing reads
# drifts exactly as a meta field nothing reads does.
#
# A documented name sits at a four-space indent followed by its form.
# Continuation lines are indented further and do not match.
fields="$root/doc/fields"
if [ ! -f "$fields" ]; then
	echo "no doc/fields; the format has no index" >&2
	exit 2
fi

sed -n 's/^    \([a-z_][a-z0-9_]*\)   *[a-z-].*/\1/p' "$fields" |
	LC_ALL=C sort -u > "$documented"
used=$(cat "$root"/test/*/*/expect | awk 'NF > 0 { print $1 }' |
       LC_ALL=C sort -u)

differs=$(printf '%s\n' "$used" | diff "$documented" - | sed -n 's/^[<>]/&/p')
if [ -n "$differs" ]; then
	echo "test/ and doc/fields disagree:"
	printf '%s\n' "$differs" |
		sed 's/^</    documented, in no vector:/; s/^>/    undocumented:/'
	exit 2
fi

fail_with() {
	echo "FAIL $1"
	shift
	printf '%s\n' "$@" | sed 's/^/    /'
	fail=$((fail + 1))
}

meta_field() {
	sed -n "s/^$2  *//p" "$1/meta"
}

# The format has one rule a diff cannot enforce: a name wider than the
# column silently shifts the value, and two vectors that disagree only
# in alignment would still compare equal to a decoder that pads the
# same way. Nothing else reads it, so it is read here.
check_format() {
	awk -v w=18 '
		NF == 0 { next }
		NF != 2 { printf "%s:%d: expected a name and one value\n", FILENAME, FNR; bad = 1; next }
		length($1) > w { printf "%s:%d: field name %s is wider than the %d-column format\n", FILENAME, FNR, $1, w; bad = 1 }
		END { if (bad) exit 1 }
	' "$1"
}

for dir in "$root"/test/*/*/; do
	dir=${dir%/}
	[ -d "$dir" ] || continue
	seen=$((seen + 1))

	if [ ! -f "$dir/meta" ]; then
		fail_with "$dir" "no meta"
		continue
	fi

	# meta must be complete before anything is read from it.
	missing=
	for f in source determinism purpose; do
		[ -n "$(meta_field "$dir" "$f")" ] || missing="$missing $f"
	done
	if [ -n "$missing" ]; then
		fail_with "$dir" "meta has no$missing"
		continue
	fi

	# The kind is the directory the vector is filed under. Recording it
	# in meta as well meant a rule to keep the two agreeing, and a way
	# for them to disagree.
	kind=$(basename "$(dirname "$dir")")
	determinism=$(meta_field "$dir" determinism)

	case "$determinism" in
		decode|encode) ;;
		*) fail_with "$dir" "meta names an unknown determinism class: $determinism"; continue ;;
	esac

	# stderr is kept out of the comparison. A decoder that writes a
	# warning there would otherwise have it diffed against expect, and
	# the vector would fail for something that is not a field.
	out=$(run "$DUMP" "$kind" "$dir/raw" 2>"$err")
	status=$?

	# timeout reports 124, and a decoder that takes half a minute on one
	# vector has said something worth reading.
	if [ "$status" -eq 124 ]; then
		fail_with "$dir" "no answer after 30 seconds"
		continue
	fi

	# A decoder that does not implement a kind says so with status 77
	# and is not counted against. Nothing else may use that status: a
	# decoder that implements a kind and rejects a vector has found a
	# disagreement, which is the result.
	if [ "$status" -eq 77 ]; then
		skip=$((skip + 1))
		skipped_kinds=$(printf '%s\n%s' "$skipped_kinds" "$kind")
		continue
	fi

	if [ "$status" -ne 0 ]; then
		fail_with "$dir" "$(cat "$err")"
		continue
	fi

	if ! bad=$(check_format "$dir/expect"); then
		fail_with "$dir" "$bad"
		continue
	fi

	# The exit status of a pipeline is the status of its last command,
	# so diff's verdict must be read from its output, not from the
	# status of anything downstream of it.
	changed=$(printf '%s\n' "$out" | diff -u "$dir/expect" - | tail -n +3)
	if [ -n "$changed" ]; then
		fail_with "$dir" "$changed"
		continue
	fi

	if [ "$determinism" = encode ] && [ "$ENCODE" = yes ]; then
		if ! back=$(run "$DUMP" -e "$kind" "$dir/expect" 2>"$err"); then
			fail_with "$dir" "round trip: $(cat "$err")"
			continue
		fi
		changed=$(printf '%s\n' "$back" | diff -u "$dir/raw" - | tail -n +3)
		if [ -n "$changed" ]; then
			fail_with "$dir" "round trip does not reproduce raw" "$changed"
			continue
		fi
	fi

	pass=$((pass + 1))
done

# What the result was measured against, so that a number recorded
# elsewhere can be told apart from the same number measured against a
# different corpus. Two vectors have changed shape without changing the
# count, and nothing said so. cksum because it is POSIX and this is a
# fingerprint rather than a signature: anyone who can edit test/ can
# edit the number too.
corpus=$(LC_ALL=C; cat "$root"/test/INDEX "$root"/test/*/*/raw \
                       "$root"/test/*/*/expect | cksum | cut -d' ' -f1)

if [ "$skip" -eq 0 ]; then
	echo "$pass passed, $fail failed, corpus $corpus"
else
	# Naming the kinds keeps a partial result from reading as a whole
	# one. A decoder is free to implement four kinds and say so.
	# Unquoted, so the shell splits the list and joins it with single
	# spaces. The empty first line of the accumulator drops out.
	echo "$pass passed, $fail failed, corpus $corpus, $skip skipped:" \
	     $(printf '%s\n' "$skipped_kinds" | sort -u)
fi

# A corpus with nothing in it must not report success, and neither must
# a decoder that skipped everything.
if [ "$seen" -eq 0 ]; then
	echo "no vectors under $root/test" >&2
	exit 2
fi
if [ "$pass" -eq 0 ]; then
	echo "nothing was checked" >&2
	exit 2
fi

[ "$fail" -eq 0 ]
